{
  // ScreenReplay official website (site/) + R2 downloads (/dl/), deployed on Cloudflare Pages (`https://screenreplay.pages.dev`):
  // `npx wrangler pages deploy --project-name screenreplay --branch main`
  "name": "screenreplay",
  "compatibility_date": "2026-11-01",
  "pages_build_output_dir": "./site",
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "screenreplay"
    }
  ]
}
