import "mbt_compat"
import "motion"
import "signals"
import "ui"
import "view"

// The settings, a sheet over the window (760 by 560, radius 12, s1): its pages in a 176 wide column of the window's
// ground at its left, one page at a time at its right, in groups; About at the column's foot (letter 30). Each choice
// written to settings.json at once (the recorder reads it every few seconds), the window's own to viewer.json.

/// Told every time the folder is read (3 s): what shows the recorder's word (state.json) reads it again.


/// The recorder's word as last read (bound).
fn info() -> RecordingInfo {
  status_rev.get() |> ignore
  recording_info()}

/// What the recordings kept take at these settings: the time kept at the planned bitrate and the sound's (bound).
/// Kept by time alone (the user, 2026-11-14): there is no limit of the space they take, only the disk's own.
fn kept_bytes() -> Double {
  sets() |> ignore
  hour_bytes() * sets().window_minutes.to_double() / 60.0}

/// What an hour of recording takes (bound): as the latest recordings did (the last two hours recorded, once ten
/// minutes of them), else at the planned bitrate, which is only a ceiling (the user, 2026-11-16: four hours recorded
/// took 3 GB where it said 42).
fn hour_bytes() -> Double {
  data()
  let mut size = 0.0
  let mut dur = 0.0
  for i = segs.length() - 1; i >= 0 && dur < 7200000.0; i = i - 1 {
    size += segs[i].size
    dur += segs[i].dur
  }
  if dur >= 600000.0 {
    size / dur * 3600000.0
  } else {
    let inf = info()
    (planned_bitrate(inf.screen_w, inf.screen_h) + 192000.0) * 3600.0 / 8.0
  }}


/// A group: its name (12, 500, subtle) over a card of s2 (in the light a near-white with a hairline), radius 10,
/// holding its rows.
fn setting_group(parent : view::View, title : () -> String, body : (view::View) -> Unit) -> Unit {
  parent.box(fn(g) {
    let has_title = signals::untracked(title) != ""
    g.gap(view::Live::Is(if has_title { 8.0 } else { 0.0 })).padding(view::Live::Is((0.0, if has_title { 6.0 } else { 0.0 }, 0.0, 0.0))) |> ignore
    if has_title {
      words(g, title, 12.0, ui_subtle, weight=500) |> ignore
    }
    g.box(fn(card) {
      card
      .radius(view::Live::Is(10.0))
      .ground(view::Live::By(fn() { tone(c_s2(), 0xF4F5F7FFL) }))
      .edge(view::Live::By(fn() { if is_dark() { (0.0, 0L) } else { (1.0, 0x00000014L) } }))
      .clips(view::Live::Is(true))
      |> ignore
      body(card)
    })
    |> ignore
  })
  |> ignore}

/// A switch's row, written back at once.
fn toggle_row(parent : view::View, first : Bool, title : () -> String, note : () -> String, on : () -> Bool, set : (Bool) -> Unit) -> Unit {
  setting_row(parent, first, title, note, fn(c) {
    switch(c, title, on, fn(v) {
      set(v)
      save_settings()
    })
  })}

/// A choice's row of a few, written back at once.
fn choice_row(parent : view::View, first : Bool, title : () -> String, note : () -> String, labels : () -> Array[String], chosen : () -> Int, choose : (Int) -> Unit) -> Unit {
  setting_row(parent, first, title, note, fn(c) {
    segmented(c, labels, chosen, fn(i) {
      choose(i)
      save_settings()
    })
  })}

/// The scrub index's folder's size as last walked, and when (rp_now's ms; 0 never).


/// 删除全部录像: 0 its key, 1 asked again, 2 asked of the recorder.


/// The space the recordings take (the Storage page's alone: the user, 2026-11-15, 「quality和storage都有这块感觉很怪」),
/// one card: what is used, large, and under it in one line the recordings, the scrub index and what it writes an hour
/// and a day (no meter: the user, 2026-11-16, 「没必要画chart」); last 删除全部录像 as a row with its key at its right.
fn storage_card(parent : view::View) -> Unit {
  let used = fn() {
    data()
    arr_fold(segs, 0.0, fn(a, s) { a + s.size })
  }
  let thumbs = fn() {
    status_rev.get() |> ignore
    // (the folder walked at most once in 30 s: status_rev moves every 3 s while the window shows, and each walk
    // read every thumbnail file's entry)
    let (at, bytes) = thumbs_size.v
    if at > 0.0 && rp_now() - at < 30000.0 {
      return bytes
    }
    let b = dmax(0.0, rp_dir_size(cstr(pjoin(root_dir(), "Thumbs"))))
    thumbs_size.v = (rp_now(), b)
    b
  }
  let hourly = fn() {
    sets() |> ignore
    hour_bytes()
  }
  let heavy = fn() { hourly() * 24.0 > 300.0 * 1.0e9 }
  setting_group(parent, fn() { t("占用") }, fn(card) {
    card.box(fn(top) {
      top.padding(view::Live::Is((14.0, 12.0, 14.0, 12.0))).gap(view::Live::Is(6.0)) |> ignore
      top.box(fn(head) {
        head.row(view::Live::Is(true)).gap(view::Live::Is(8.0)).lines_up(view::Live::Is(Some(view::Along::End))) |> ignore
        words(head, fn() { bytes_text(used() + thumbs()) }, 20.0, ui_text, weight=600) |> ignore
        // (bottoms lined up put the small words' baseline 3 under the large one's: lifted as much, so the two share it)
        words(head, fn() { t("已用") }, 12.0, ui_subtle).padding(view::Live::Is((0.0, 0.0, 0.0, 3.0))) |> ignore
      })
      |> ignore
      // (the rest in one line under it (the user's pick, 2026-11-16: 「B 一行总览」, no meter): the recordings, the
      // scrub index, and what it writes an hour and a day (the user, 2026-11-13: whether recording all day wears the
      // disk); over 300 GB a day in amber, with what to do about it)
      top.box(fn(x) {
        x
        .words(
          view::Live::By(fn() {
            tf("录像 {0} · 缩略图 {1} · 每小时约写入 {2}，全天约 {3}", [
              bytes_text(used()),
              bytes_text(thumbs()),
              bytes_text(hourly()),
              bytes_text(hourly() * 24.0),
            ]) +
            (if heavy() { t("。长期这样录会明显消耗固态硬盘的写入寿命，可以降低帧率或画质") } else { "" })
          }),
          look={ ..view::words_plain, size: 12.0, line: 17.0, wrap: true },
        )
        .ink(view::Live::By(fn() { if heavy() { warn() } else { ui_subtle() } }))
        |> ignore
      })
      |> ignore
      // (the recorder deleting before their time for want of room: said with what to do)
      top.show(fn() { info().disk_tight }, fn(n) {
        n
        .words(
          view::Live::By(fn() { t("磁盘剩余不到 10 GB，正在提前删除最早的录像。可以降低画质或帧率、缩短保留时长，或把录像缓冲换到另一块盘") }),
          look={ ..view::words_plain, size: 12.0, line: 17.0, wrap: true },
        )
        .ink(view::Live::By(warn))
        |> ignore
      })
      |> ignore
    })
    |> ignore
    // every recording deleted (the reviewer's 85th: the privacy policy names it as the person's to do): asked again
    // in the row, then the recorder told (purge.request), which closes the segment it writes, deletes what the
    // buffer's folders hold and records on; the clips saved, the settings and the logs kept
    setting_row(card, false, fn() { t("删除全部录像") }, fn() {
      match purge_state.get() {
        1 => t("会删除缓冲里的全部录像，已保存的片段不受影响，无法恢复。")
        2 => if has_segs() { t("正在删除…") } else { t("已删除全部录像") }
        _ => t("已保存的片段不受影响")
      }
    }, fn(c) {
      c.pick(fn() { purge_state.get() }, fn(b, st) {
        b.row(view::Live::Is(true)).gap(view::Live::Is(6.0)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
        match st {
          1 => {
            text_button(b, fn() { t("取消") }, fn() { purge_state.set(0) }, ghost=true) |> ignore
            text_button(b, fn() { t("删除") }, fn() {
              rp_write(cstr(pjoin(root_dir(), "purge.request")), "1".to_bytes()) |> ignore
              purge_state.set(2)
              purge_now()
              match the_root.v {
                Some(r) =>
                  again(r, 3000.0, fn() {
                    if purge_state.untracked() == 2 {
                      purge_state.set(0)
                    }
                  })
                None => ()
              }
            }, danger=true)
            |> ignore
          }
          2 => ()
          _ => {
            let k = text_button(b, fn() { t("删除…") }, fn() {
              if has_segs() {
                purge_state.set(1)
              }
            }, danger=true)
            k.alpha(view::Live::By(fn() { if has_segs() { 1.0 } else { 0.35 } })).presses(view::Live::By(has_segs)) |> ignore
          }
        }
      })
      |> ignore
    })
  })}

/// One of the pages in the column: its icon and name; s2 under the one shown, s1 under the pointer.
fn nav_item(parent : view::View, i : Int, icon : () -> String, label : () -> String) -> Unit {
  pressable(parent, label, fn() {
    purge_state.set(0)
    settings_page.set(i)
  }, fn(b) {
    let on = fn() { settings_page.get() == i }
    // (under the pointer a faint tint over the sidebar's ground, coming in and going over 100 ms; the page shown s2)
    let (hand, _) = answer(b)
    let picked = motion::NodeWay::new(if signals::untracked(on) { 1.0 } else { 0.0 })
    b.reacts(on, fn(v) { picked.go_ms(b, if v { 1.0 } else { 0.0 }, if motion_off() { 1.0 } else { 140.0 }) })
    b
    .row(view::Live::Is(true))
    .height(view::Live::Is(Some(32.0)))
    .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
    .gap(view::Live::Is(9.0))
    .radius(view::Live::Is(6.0))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .cursor(view::Live::Is(Some(view::Cursor::Arrow)))
    .edge(view::Live::By(fn() { if b.focus_shown() { (1.5, focus_ring()) } else { (0.0, 0L) } }))
    .ground(view::Live::By(fn() { mix(mix(clear(press_ground()), press_ground(), hand.shown(b)), c_s2(), picked.shown(b)) }))
    |> ignore
    sf_icon_node(b, "", 16.0, view::Live::By(fn() { if on() { ui_text() } else { ui_muted() } }), name_now=icon) |> ignore
    b.box(fn(w) {
      w
      .words(view::Live::By(label), look={ ..view::words_plain, size: 13.0, line: 18.0, wrap: false })
      .words_look(view::Live::By(fn() { { ..view::words_plain, size: 13.0, line: 18.0, wrap: false, weight: if on() { 500 } else { 400 } } }))
      .ink(view::Live::By(fn() { if on() { ui_text() } else { ui_muted() } }))
      |> ignore
    })
    |> ignore
  })
  |> ignore}

fn settings_page_title(i : Int) -> String {
  match i {
    0 => t("录制")
    1 => t("画质")
    2 => t("存储")
    3 => t("外观")
    4 => t("快捷键")
    _ => t("关于")
  }}

fn settings_dialog(root : view::View) -> Unit {
  let close = fn() {
    purge_state.set(0)
    settings_open.set(false)
  }
  sheet(root, fn() { settings_open.get() }, close, 760.0, h=560.0, bare=true, keys=["escape", "settings"], fn(card) {
    card.row(view::Live::Is(true)) |> ignore
    card.box(fn(nav) {
      nav.width(view::Live::Is(Some(176.0))).ground(view::Live::By(c_bg)).padding(view::Live::Is((10.0, 0.0, 10.0, 16.0))).gap(view::Live::Is(2.0)) |> ignore
      nav.box(fn(h) {
        h.row(view::Live::Is(true)).height(view::Live::Is(Some(48.0))).padding(view::Live::Is((10.0, 0.0, 0.0, 0.0))).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
        words(h, fn() { t("设置") }, 15.0, ui_text, weight=600) |> ignore
      })
      |> ignore
      nav.box(fn(sp) { sp.height(view::Live::Is(Some(6.0))) |> ignore }) |> ignore
      nav_item(nav, 0, fn() { "monitor" }, fn() { t("录制") })
      nav_item(nav, 1, fn() { "image-upload" }, fn() { t("画质") })
      nav_item(nav, 2, fn() { "disk" }, fn() { t("存储") })
      nav_item(nav, 3, fn() { if is_dark() { "moon" } else { "sun" } }, fn() { t("外观") })
      nav_item(nav, 4, fn() { "keyboard" }, fn() { t("快捷键") })
      spring(nav)
      nav_item(nav, 5, fn() { "info" }, fn() { t("关于") })
    })
    |> ignore
    card.box(fn(right) {
      right.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))) |> ignore
      // (sticky top bar: page title + close button, so scrolled content never slides under ×)
      right.box(fn(head) {
        head.row(view::Live::Is(true)).height(view::Live::Is(Some(48.0))).padding(view::Live::Is((24.0, 0.0, 14.0, 0.0))).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
        words(head, fn() { settings_page_title(settings_page.get()) }, 15.0, ui_text, weight=600) |> ignore
        spring(head)
        icon_button(head, fn() { "close" }, fn() { t("关闭") }, close, size=12.0) |> ignore
      })
      |> ignore
      rule(right, hair)
      // (each page scrolls where it is taller than the card, from its top as it is picked: the user, 2026-11-15
      // 「about 内容过长不能滚动了」)
      right.box(fn(page) {
        page.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_height(view::Live::Is(Some(0.0))) |> ignore
        page.pick(fn() { settings_page.get() }, fn(sp, i) {
          sp.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_height(view::Live::Is(Some(0.0))) |> ignore
          sp.scrolls(view::Scroll::new(), slop=ui::touch_slop(), bar=ui::tree_scroll_bar(), fn(p) {
            p.padding(view::Live::Is((24.0, 14.0, 24.0, 20.0))).gap(view::Live::Is(10.0)) |> ignore
            settings_page_body(p, i)
          })
          |> ignore
        }, at_once=true)
      })
      |> ignore
    })
    |> ignore
  })}

/// NVIDIA's Fast Sync on (the recorder reads it, state.json's fastSync): with it some games' recordings flicker
/// between the new picture and an old one (the user's Psycho Sleuth, 2026-11-15; Discord's share and OBS's display
/// capture alike), so it is said above the recording's settings with how to turn it off. Nothing is changed for it.
fn fast_sync_note(p : view::View) -> Unit {
  p.show(fn() { !is_mac() && info().fast_sync != "" }, fn(n) {
    setting_group(n, fn() { t("NVIDIA 显卡开着「快速同步」") }, fn(card) {
      card.box(fn(w) {
        w.padding(view::Live::Is((14.0, 10.0, 14.0, 10.0))) |> ignore
        w.box(fn(x) {
          x
          .words(
            view::Live::By(fn() {
              // (no program named: the user, 2026-11-15, 「不要提游戏名字」)
              t("部分游戏的录像可能会一帧新、一帧旧地闪烁。打开 NVIDIA 控制面板 → 管理 3D 设置 → 垂直同步，改成「使用 3D 应用程序设置」或「关」")
            }),
            look={ ..view::words_plain, size: 12.0, line: 17.0, wrap: true },
          )
          .ink(view::Live::By(warn))
          |> ignore
        })
        |> ignore
      })
      |> ignore
    })
  })
  |> ignore}

fn settings_page_body(p : view::View, i : Int) -> Unit {
  match i {
    0 => {
      fast_sync_note(p)
      behind_note(p)
      setting_group(p, fn() { "" }, fn(g) {
        toggle_row(g, true, fn() { t("后台录制") }, fn() { t("关掉后不再录制，已录的保留到过期") }, fn() { sets().enabled }, fn(v) {
          settings.enabled = v
        })
        toggle_row(g, false, fn() { t("录制系统声音") }, fn() {
            if info().audio_trouble != "" {
              t("声音没能写进最近的录像，详情在 recorder.log")
            } else {
              t(if is_mac() { "Mac 播放的声音一起录下" } else { "电脑播放的声音一起录下" })
            }
          }, fn() { sets().system_audio }, fn(v) { settings.system_audio = v })
        toggle_row(g, false, fn() { t("录制麦克风") }, fn() { t("和系统声音同开时，片段里只带系统声音") }, fn() { sets().microphone }, fn(v) {
          settings.microphone = v
        })
        toggle_row(g, false, fn() { t("全屏时暂停") }, fn() { t("游戏、全屏视频在前台时不录") }, fn() { sets().pause_in_fullscreen }, fn(v) {
          settings.pause_in_fullscreen = v
        })
        // (the window's own, viewer.json's: applied to its windows at once and each second, replay_win.c)
        setting_row(g, false, fn() { t("不录 ScreenReplay 自己") }, fn() {
          t("回放窗口不进录像，录到的是它后面的内容；开着时其他截图、录屏工具也截不到它")
        }, fn(c) {
          switch(c, fn() { t("不录 ScreenReplay 自己") }, fn() { hidden_from_capture.get() }, fn(v) {
            hidden_from_capture.set(v)
            save_prefs()
            rp_hide_from_capture(if v { 1 } else { 0 })
          })
        })
        toggle_row(g, false, fn() { t(if is_mac() { "登录时自动启动" } else { "开机时启动" }) }, fn() { t(if is_mac() { "登录 macOS 后自动开始后台录制" } else { "登录 Windows 后自动开始后台录制" }) }, fn() { sets().autostart }, fn(v) { settings.autostart = v })
      })
      setting_group(p, fn() { t("保存最近一段") }, fn(g) {
        choice_row(g, true, fn() { t("长度") }, fn() {
          t(if is_mac() { "按 ⌃⌥S，不开窗口直接存成片段" } else { "按 Ctrl+Alt+S，不开窗口直接存成片段" })
        }, fn() {
          [t("15 秒"), t("30 秒"), t("1 分钟"), t("2 分钟")]
        }, fn() { index_of(last_choices, sets().last_seconds, 1) }, fn(i) { settings.last_seconds = last_choices[i] })
      })
    }
    1 => {
      setting_group(p, fn() { "" }, fn(g) {
        choice_row(g, true, fn() { t("编码") }, fn() {
          if info().codec == "H264" && sets().codec == "hevc" {
            t(if is_mac() { "这台 Mac 现在用 H.264 录" } else { "这台电脑现在用 H.264 录" })
          } else {
            t("H.265 同样画质约省 40% 空间")
          }
        }, fn() { ["H.265", "H.264"] }, fn() { if sets().codec == "h264" { 1 } else { 0 } }, fn(i) {
          settings.codec = if i == 1 { "h264" } else { "hevc" }
        })
        choice_row(g, false, fn() { t("分辨率") }, fn() { height_note() }, fn() { [t("原始"), "1440p", "1080p", "720p"] }, fn() {
          index_of(height_choices, sets().max_height, 0)
        }, fn(i) { settings.max_height = height_choices[i] })
        // (90 and 120 for a game's motion, said what they cost: the user, 2026-11-17 「可以做一下90/120hz录制和输出的
        // 选项，但需要警告用户」)
        choice_row(g, false, fn() { t("帧率") }, fn() { fps_note() }, fn() { ["30", "60", "90", "120"] }, fn() {
          index_of(fps_choices, fps_of(sets().fps.to_double()), 1)
        }, fn(i) { settings.fps = fps_choices[i] })
        choice_row(g, false, fn() { t("画质") }, fn() { t("录下来有多清楚，也决定录像占多少空间；导出时还能另选") }, fn() {
            [t("低"), t("中"), t("高"), t("极高")]
          }, fn() {
          index_of_text(quality_choices, sets().quality, 2)
        }, fn(i) { settings.quality = quality_choices[i] })
        rule(g, hair)
        g.box(fn(est) {
          est.row(view::Live::Is(true)).padding(view::Live::Is((14.0, 10.0, 14.0, 10.0))).gap(view::Live::Is(4.0)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
          words(est, fn() {
            let s = sets()
            let inf = info()
            let rate = planned_bitrate(inf.screen_w, inf.screen_h)
            let mut ew = if inf.screen_w > 0.0 { inf.screen_w } else { 1920.0 }
            let mut eh = if inf.screen_h > 0.0 { inf.screen_h } else { 1080.0 }
            if s.max_height > 0 && eh > s.max_height.to_double() {
              ew = ew * s.max_height.to_double() / eh
              eh = s.max_height.to_double()
            }
            tf("{0}×{1} · 约 {2} Mbps · 每小时最多 {3}", [
              even(ew).to_string(),
              even(eh).to_string(),
              ((rate / 100000.0).round() / 10.0).to_string(),
              bytes_text(rate * 3600.0 / 8.0),
            ]) +
            t("，画面不动时少得多")
          }, 12.0, ui_muted)
          |> ignore
        })
        |> ignore
      })
    }
    2 => {
      setting_group(p, fn() { "" }, fn(g) {
        choice_row(g, true, fn() { t("保留多久") }, fn() {
          tf("更早的录像自动删除；约需 {0}", [bytes_text(kept_bytes())])
        }, fn() {
          [t("30 分钟"), t("1 小时"), t("2 小时"), t("4 小时")]
        }, fn() { index_of(window_choices, sets().window_minutes, 2) }, fn(i) { settings.window_minutes = window_choices[i] })
      })
      buffer_place(p)
      storage_card(p)
    }
    3 => {
      setting_group(p, fn() { "" }, fn(g) {
        let looks = ["system", "dark", "light"]
        setting_row(g, true, fn() { t("主题") }, fn() { "" }, fn(c) {
          segmented(c, fn() { [t("跟随系统"), t("深色"), t("浅色")] }, fn() { arr_search_str(looks, appearance.get()).unwrap_or(0) }, fn(i) {
            appearance.set(looks[i])
            save_prefs()
          })
        })
        let langs = ["system", "zh", "en"]
        setting_row(g, false, fn() { t("语言") }, fn() { "" }, fn(c) {
          segmented(c, fn() { [t("跟随系统"), "简体中文", "English"] }, fn() { arr_search_str(langs, language.get()).unwrap_or(0) }, fn(i) {
            language.set(langs[i])
            save_prefs()
          })
        })
      })
      setting_group(p, fn() { t("时间线") }, fn(g) {
        setting_row(g, true, fn() { t("跳过没录制的时段") }, fn() {
          t("没开 ScreenReplay、关掉或暂停录制的时间，不计入保留时长，在时间线上也折成一条细缝")
        }, fn(c) {
          switch(c, fn() { t("跳过没录制的时段") }, fn() { fold_gaps.get() }, fn(v) { set_fold_gaps(v) })
        })
      })
    }
    5 => about_page(p)
    _ =>
      setting_group(p, fn() { "" }, fn(g) {
        g.each(fn() { shortcut_rows() }, fn(r : (String, Array[String])) -> String { r.0 }, fn(row, r) {
          let (label, keys) = r.untracked()
          if label != shortcut_rows()[0].0 {
            rule(row, hair)
          }
          row.box(fn(b) {
            b.row(view::Live::Is(true)).height(view::Live::Is(Some(36.0))).padding(view::Live::Is((14.0, 0.0, 14.0, 0.0))).gap(view::Live::Is(4.0)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
            words(b, fn() { label }, 13.0, ui_text) |> ignore
            spring(b)
            for k in keys {
              kbd(b, k)
            }
          })
          |> ignore
        }, at_once=true)
      })
  }}


/// A folder chosen or the default taken back since the settings opened (its switching, then switched, said).


/// Why the folder last chosen was not taken ("" none).


/// Where the recorder keeps its segments (the user, 2026-11-13: 「两处都做」): the folder now and its drive's free room,
/// another chosen by the system's folder dialog (taken where it can be written and holds 1.2 times the limit), back to
/// the default. Taken, the recorder writes there from its next segment; what is where it wrote before stays there and
/// expires there, the window reading both. Where the folder chosen cannot be written (a drive taken out) the recorder
/// writes to the default and says so here.
fn buffer_place(p : view::View) -> Unit {
  setting_group(p, fn() { t("录像缓冲位置") }, fn(g) {
    let shown_dir = fn() {
      let inf = info()
      if inf.buffer_dir != "" {
        inf.buffer_dir
      } else if sets().buffer_dir != "" {
        sets().buffer_dir
      } else {
        pjoin(root_dir(), "Buffer")
      }
    }
    setting_row(g, true, fn() { shown_dir() }, fn() {
      let free = rp_disk_free(cstr(shown_dir()))
      (if free >= 0.0 { tf("所在磁盘剩余 {0}", [bytes_text(free)]) + " · " } else { "" }) + t("切换时会有几秒不录")
    }, fn(c) {
      c.row(view::Live::Is(true)).gap(view::Live::Is(8.0)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
      c.show(fn() { sets().buffer_dir != "" }, fn(x) {
        text_button(x, fn() { t("恢复默认") }, fn() {
          settings.buffer_dir = ""
          buffer_note.set("")
          buffer_moved.set(true)
          save_settings()
        }, ghost=true)
        |> ignore
      }, at_once=true)
      text_button(c, fn() { t("更改…") }, fn() {
        let dir = text_of(rp_pick_folder())
        if dir == "" {
          return
        }
        let need = kept_bytes() * 1.2
        let free = rp_disk_free(cstr(dir))
        if rp_can_write(cstr(dir)) != 1 {
          buffer_note.set(t("这个文件夹写不进去，没有更改"))
        } else if need > 0.0 && free >= 0.0 && free < need {
          buffer_note.set(tf("这块磁盘只剩 {0}，不够放下保留时长所需的 1.2 倍（{1}），没有更改", [bytes_text(free), bytes_text(need)]))
        } else {
          buffer_note.set("")
          settings.buffer_dir = dir
          buffer_moved.set(true)
          save_settings()
        }
      })
      |> ignore
    })
    // (after a change: switching, then switched; what is left where it wrote before and when it is cleared)
    let lowered = fn(s : String) { str_trim_end_chars(str_to_ascii_lower(s), "/\\") }
    let switching = fn() {
      let want = sets().buffer_dir
      let now_dir = info().buffer_dir
      info().buffer_trouble == "" && now_dir != "" &&
      lowered(now_dir) != lowered(if want == "" { pjoin(root_dir(), "Buffer") } else { want })
    }
    let old_left = fn() -> (Double, Double, Double) {
      data()
      let here = lowered(shown_dir())
      let mut size = 0.0
      let mut last = -1.0
      let mut new_dur = 0.0
      for s in segs {
        if !lowered(s.path).starts_with(here) {
          size += s.size
          last = dmax(last, s.start + s.dur)
        } else {
          new_dur += s.dur
        }
      }
      (size, last, new_dur)
    }
    g.show(fn() { switching() || buffer_moved.get() || old_left().0 > 0.0 }, fn(n) {
      n.padding(view::Live::Is((14.0, 0.0, 14.0, 12.0))) |> ignore
      words(n, fn() {
        let (size, last, new_dur) = old_left()
        let head = if switching() {
          t("正在切换…")
        } else if buffer_moved.get() {
          t("已切换，新的录像存到这里")
        } else {
          ""
        }
        let left = if size > 0.0 {
          let window_ms = sets().window_minutes.to_double() * 60000.0
          let ms = if fold_gaps.get() {
            dmax(0.0, window_ms - new_dur)
          } else {
            dmax(0.0, last + window_ms - rp_now())
          }
          if ms < 60000.0 {
            tf("旧位置还有 {0}，即将自动清空", [bytes_text(size)])
          } else {
            tf("旧位置还有 {0}，约 {1} 后自动清空", [bytes_text(size), view_len_words(ms)])
          }
        } else {
          ""
        }
        if head != "" && left != "" { head + "；" + left } else { head + left }
      }, 12.0, ui_subtle)
      |> ignore
    }, at_once=true)
    g.show(fn() { buffer_note.get() != "" || info().buffer_trouble != "" }, fn(n) {
      n.padding(view::Live::Is((14.0, 0.0, 14.0, 12.0))) |> ignore
      n.box(fn(w) {
        w
        .words(
          view::Live::By(fn() {
            if buffer_note.get() != "" {
              buffer_note.get()
            } else {
              t("选的文件夹现在写不进去（磁盘被拔出或没有权限），录像暂时存到默认位置")
            }
          }),
          look={ ..view::words_plain, size: 12.0, line: 17.0, wrap: true },
        )
        .ink(view::Live::By(warn))
        |> ignore
      })
      |> ignore
    }, at_once=true)
  })}

/// Integrated graphics recording a screen over 1440p at its own size: said under the choice that its video engine
/// both records and plays video, so a smaller picture leaves video playing smooth.
fn height_note() -> String {
  let info = info()
  if info.shared_gpu && sets().max_height == 0 && (info.screen_h == 0.0 || info.screen_h > 1440.0) {
    t("集成显卡录制和播放视频共用同一个视频单元，屏幕大于 1440p 时建议调低，看高清视频更流畅")
  } else {
    ""
  }}

/// The encoder fell behind in the last 10 s (recorder/Program.cs's framesSkipped: frames left out rather than waited
/// for, a GPU too slow for this size and rate or its video engine busy playing a video): said above the recording's
/// settings while it lasts, with what to do.
fn behind_note(p : view::View) -> Unit {
  p.show(fn() {
    let i = info()
    i.frames_skipped * 20 > i.frames_encoded + i.frames_skipped && i.frames_skipped >= 10
  }, fn(n) {
    setting_group(n, fn() { t("显卡编码跟不上") }, fn(card) {
      card.box(fn(w) {
        w.padding(view::Live::Is((14.0, 10.0, 14.0, 10.0))) |> ignore
        w.box(fn(x) {
          x
          .words(
            view::Live::By(fn() {
              let i = info()
              let all = i.frames_encoded + i.frames_skipped
              tf("最近 10 秒有 {0}% 的画面没来得及录，实际约 {1} 帧/秒。可以在「画质」里调低分辨率或帧率", [
                (i.frames_skipped * 100 / all).to_string(),
                ((i.frames_encoded + 5) / 10).to_string(),
              ])
            }),
            look={ ..view::words_plain, size: 12.0, line: 17.0, wrap: true },
          )
          .ink(view::Live::By(warn))
          |> ignore
        })
        |> ignore
      })
      |> ignore
    })
  })
  |> ignore}


/// What a frame rate over 60 costs, said under the choice: the space, the GPU's encoder, the display it is over.
fn fps_note() -> String {
  let fps = fps_of(sets().fps.to_double())
  if fps <= 60 {
    return ""
  }
  // (bound to the recorder's word as it is read again: info(), not recording_info(), which it read once and kept)
  let info = info()
  if info.fps_fell_back {
    return t("显卡编码器不支持这个帧率，正在按 60 帧录制")
  }
  let more = if fps >= 120 { "50%" } else { "30%" }
  let base = tf("比 60 帧多占约 {0} 空间，显卡编码更忙，玩游戏时可能略降帧率", [more])
  if info.display_hz > 0 && info.display_hz < fps {
    base + tf("；显示器只有 {0} Hz，多出来的帧都是重复画面，白占空间", [info.display_hz.to_string()])
  } else {
    base
  }}
