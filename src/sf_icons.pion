fn sf_parse_icon_shapes(raw : String, size : Double, ink : Int64) -> Array[paint::Shape] {
  let parts = raw.split(" ")
  let nums : Array[Double] = []
  for p in parts {
    if p != "" {
      nums.push(parse_double_or(p, 0.0))
    }
  }
  let scale = size / 24.0
  let out : Array[paint::Shape] = []
  let mut i = 0
  while i + 2 < nums.length() {
    let kind = nums[i].to_int()
    let param = nums[i + 1]
    let count = nums[i + 2].to_int()
    i += 3
    if kind == 2 {
      let sub_count = param.to_int()
      let contours : Array[(Array[Double], Bool)] = []
      let pts0 : Array[Double] = []
      let mut k = 0
      while k < count && i + 1 < nums.length() {
        pts0.push(nums[i] * scale)
        pts0.push(nums[i + 1] * scale)
        i += 2
        k += 1
      }
      contours.push((pts0, true))
      let mut s = 1
      while s < sub_count && i + 2 < nums.length() {
        let _sk = nums[i].to_int()
        let _sp = nums[i + 1]
        let sc = nums[i + 2].to_int()
        i += 3
        let pts : Array[Double] = []
        let mut j = 0
        while j < sc && i + 1 < nums.length() {
          pts.push(nums[i] * scale)
          pts.push(nums[i + 1] * scale)
          i += 2
          j += 1
        }
        contours.push((pts, true))
        s += 1
      }
      out.push(paint::shape_of(contours, fill=ink))
    } else {
      let closed = kind == 1
      let pts : Array[Double] = []
      let mut k = 0
      while k < count && i + 1 < nums.length() {
        pts.push(nums[i] * scale)
        pts.push(nums[i + 1] * scale)
        i += 2
        k += 1
      }
      let sw = if param * scale > 1.0 { param * scale } else { 1.0 }
      out.push(paint::shape_of([(pts, closed)], stroke=ink, width=sw))
    }
  }
  out
}

fn sf_icon_shapes(name : String, size : Double, ink : Int64) -> Array[paint::Shape] {
  match sf_extra_icon_raw(name) {
    Some(raw) => sf_parse_icon_shapes(raw, size, ink)
    None => icons::icon_shapes(name, size, ink)
  }
}

fn sf_icon_node(
  parent : view::View,
  name : String,
  size : Double,
  tint : view::Live[Int64],
  name_now? : () -> String,
) -> view::View {
  let get_name = match name_now {
    Some(f) => f
    None => fn() -> String { name }
  }
  parent.box(fn(v : view::View) -> Unit {
    let _ = v
      .width(view::Live::Is(Some(size)))
      .height(view::Live::Is(Some(size)))
      .shrink(view::Live::Is(0.0))
      .points(view::Live::Is(false))
      .shapes(view::Live::By(fn() -> Array[paint::Shape] { sf_icon_shapes(get_name(), size, 0x01010100L) }))
      .tint(tint)
  })
}
