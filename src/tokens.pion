fn ui_accent() -> Int64 {
  tone(0xEDEEF0FFL, 0x17181BFFL)}

fn ui_accent_hover() -> Int64 {
  tone(0xFFFFFFFFL, 0x000000FFL)}

fn ui_on_accent() -> Int64 {
  tone(0x111214FFL, 0xFFFFFFFFL)}

fn ui_accent_faint() -> Int64 {
