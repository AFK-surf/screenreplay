fn rec_red() -> Int64 {
  tone(0xFF4D4DFFL, 0xE5383BFFL)}

fn danger_ink() -> Int64 {
  tone(0xFF7D7DFFL, 0xB91C1CFFL)}

fn danger_ground(hover : Double) -> Int64 {
  mix(tone(0xFF4D4D24L, 0xE5383B1AL), tone(0xFF4D4D38L, 0xE5383B2BL), hover)}

fn warn() -> Int64 {
