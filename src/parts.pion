import "motion"
import "pixels"
import "signals"
import "view"

fn words(parent : view::View, text : () -> String, size : Double, ink : () -> Int64, weight? : Int) -> view::View {
  let weight = match weight { Some(__mbt_v) => __mbt_v, None => 400 }

  parent.box(fn(w) {
    w
    .words(view::Live::By(text), look={ ..view::words_plain, size: size, weight: weight, line: (size * 1.4).round(), wrap: false })
    .ink(view::Live::By(ink))
    |> ignore
  })}

fn vector(d : String, vw : Double, vh : Double, stroke? : Double) -> pixels::Vector {
  let stroke = match stroke { Some(__mbt_v) => __mbt_v, None => 0.0 }

  {
    w: vw,
    h: vh,
    layers: [
      {
        d: d,
        fill: if stroke > 0.0 { 0L } else { 0x000000FFL },
        stroke: if stroke > 0.0 { 0x000000FFL } else { 0L },
        width: stroke,
        even_odd: false,
        sx: 1.0,
        sy: 1.0,
        tx: 0.0,
        ty: 0.0,
      },
    ],
  }}

fn vectors(vw : Double, vh : Double, paths : Array[(String, Double)]) -> pixels::Vector {
  {
    w: vw,
    h: vh,
    layers: arr_map(paths, fn(p) {
      let (d, stroke) = p
      pixels::VectorPath::{
        d: d,
        fill: if stroke > 0.0 { 0L } else { 0x000000FFL },
        stroke: if stroke > 0.0 { 0x000000FFL } else { 0L },
        width: stroke,
        even_odd: false,
        sx: 1.0,
        sy: 1.0,
        tx: 0.0,
        ty: 0.0,
      }
    }),
  }}

fn glyph_vector(name : String) -> Option[pixels::Vector] {
  match name {
    "play" =>
      Option::Some(vector("M3 1.8v10.4a.6 .6 0 0 0 .9 .5l8.4-5.2a.6 .6 0 0 0 0-1L3.9 1.3a.6 .6 0 0 0-.9 .5z", 14.0, 14.0))
    "pause" => Option::Some(vector("M3.5 2h2.5v10h-2.5zM8 2h2.5v10h-2.5z", 14.0, 14.0))
    "undo" => Option::Some(vectors(16.0, 16.0, [("M5.5 3.5 2.5 6.5l3 3M3 6.5h6.5a3.5 3.5 0 0 1 0 7H7", 1.5)]))
    "redo" => Option::Some(vectors(16.0, 16.0, [("M10.5 3.5l3 3-3 3M13 6.5H6.5a3.5 3.5 0 0 0 0 7H9", 1.5)]))
    "bookmark" =>
      Option::Some(
        vectors(16.0, 16.0, [
          ("M8 14.5C8 14.5 3 9.6 3 6.5a5 5 0 0 1 10 0c0 3.1-5 8-5 8z", 1.5),
          ("M6.4 6.5a1.6 1.6 0 1 0 3.2 0a1.6 1.6 0 1 0-3.2 0z", 1.5),
        ]),
      )
    "bookmark-on" =>
      Option::Some({
        w: 16.0,
        h: 16.0,
        layers: [
          {
            d: "M8 14.5C8 14.5 3 9.6 3 6.5a5 5 0 0 1 10 0c0 3.1-5 8-5 8zM6.1 6.5a1.9 1.9 0 1 0 3.8 0a1.9 1.9 0 1 0-3.8 0z",
            fill: 0x000000FFL,
            stroke: 0L,
            width: 0.0,
            even_odd: true,
            sx: 1.0,
            sy: 1.0,
            tx: 0.0,
            ty: 0.0,
          },
        ],
      })
    "full" => Option::Some(vector("M2.5 6V2.5H6M10 2.5h3.5V6M13.5 10v3.5H10M6 13.5H2.5V10", 16.0, 16.0, stroke=1.5))
    "unfull" => Option::Some(vector("M6 2.5V6H2.5M13.5 6H10V2.5M10 13.5V10h3.5M2.5 10H6v3.5", 16.0, 16.0, stroke=1.5))
    "scissors" =>
      Option::Some(
        vectors(24.0, 24.0, [
          ("M3 6a3 3 0 1 0 6 0a3 3 0 1 0 -6 0Z", 2.25),
          ("M3 18a3 3 0 1 0 6 0a3 3 0 1 0 -6 0Z", 2.25),
          ("M20 4L8.12 15.88", 2.25),
          ("M14.47 14.48L20 20", 2.25),
          ("M8.12 8.12L12 12", 2.25),
        ]),
      )
    "warn-tri" =>
      Option::Some(
        vectors(16.0, 16.0, [
          ("M7.13 2.5a1 1 0 0 1 1.74 0l5.6 9.8A1 1 0 0 1 13.6 13.8H2.4a1 1 0 0 1-.87-1.5Z", 1.4),
          ("M8 6.0v3.3", 1.5),
          ("M8 11.4v0.1", 1.8),
        ]),
      )
    _ => Option::None
  }}

fn glyph(parent : view::View, name : () -> String, size : Double, ink : () -> Int64) -> Unit {
  parent.box(fn(g) {
    g.width(view::Live::Is(Some(size))).height(view::Live::Is(Some(size))).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle)) |> ignore
    g.pick(fn() { glyph_vector(name()) is Some(_) }, fn(b, own) {
      if own {
        b
        .width(view::Live::Is(Some(size)))
        .height(view::Live::Is(Some(size)))
        .picture(view::Live::By(fn() { glyph_vector(name()) }))
        .tint(view::Live::By(ink))
        |> ignore
      } else {
        sf_icon_node(b, "", size, view::Live::By(ink), name_now=name) |> ignore
      }
    }, at_once=true)
  })
  |> ignore}

fn answer(v : view::View) -> (motion::NodeWay, motion::NodeWay) {
  let hand = motion::NodeWay::new(0.0)
  let held = motion::NodeWay::new(1.0)
  v.reacts(fn() { v.pointed() || v.pressed() || v.focus_shown() }, fn(on) {
    hand.go_ms(v, if on { 1.0 } else { 0.0 }, if motion_off() { 1.0 } else { 100.0 })
  })
  v.reacts(fn() { v.pressed() }, fn(on) {
    if motion_off() {
      held.put(1.0)
    } else {
      held.go_ms(v, if on { 0.97 } else { 1.0 }, 100.0)
    }
  })
  v.scale(view::Live::By(fn() { held.shown(v) })) |> ignore
  (hand, held)}

fn pressable(parent : view::View, label : () -> String, press : () -> Unit, make : (view::View) -> Unit, keeps_region? : Bool) -> view::View {
  let keeps_region = match keeps_region { Some(__mbt_v) => __mbt_v, None => false }

  parent.box(fn(b) {
    b
    .presses(view::Live::Is(true))
    .focusable(view::Live::Is(true))
    .says(view::Live::By(fn() { Some(view::said(view::Role::Button, label=label())) }))
    .on_press(fn() {
      if !keeps_region {
        region_let_go()
      }
      press()
    })
    .cursor(view::Live::Is(Some(view::Cursor::Arrow)))
    |> ignore
    make(b)
  })}

fn icon_button(parent : view::View, name : () -> String, label : () -> String, press : () -> Unit, w? : Double, h? : Double, size? : Double, stage? : Bool, shortcut? : String, side? : view::Side, tip_words? : () -> String) -> view::View {
  let w = match w { Some(__mbt_v) => __mbt_v, None => 32.0 }
  let h = match h { Some(__mbt_v) => __mbt_v, None => 28.0 }
  let size = match size { Some(__mbt_v) => __mbt_v, None => 16.0 }
  let stage = match stage { Some(__mbt_v) => __mbt_v, None => false }
  let shortcut = match shortcut { Some(__mbt_v) => __mbt_v, None => "" }
  let side = match side { Some(__mbt_v) => __mbt_v, None => view::Side::Top }

  let k = icon_button_bare(parent, name, label, press, w, h, size, stage)
  tip(k, match tip_words { Option::Some(f) => f; Option::None => label }, shortcut=shortcut, side=side)
  k}

fn icon_button_bare(parent : view::View, name : () -> String, label : () -> String, press : () -> Unit, w : Double, h : Double, size : Double, stage : Bool) -> view::View {
  pressable(parent, label, press, fn(b) {
    let (hand, _) = answer(b)
    b
    .width(view::Live::Is(Some(w)))
    .height(view::Live::Is(Some(h)))
    .radius(view::Live::Is(6.0))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .lies_along(view::Live::Is(view::Lies::Middle))
    .edge(view::Live::By(fn() { if b.focus_shown() { (1.5, if stage { 0xFFFFFFB3L } else { focus_ring() }) } else { (0.0, 0L) } }))
    .ground(view::Live::By(fn() {
      let on = if stage { stage_hover } else { c_s3() }
      mix(clear(on), on, hand.shown(b))
    }))
    |> ignore
    glyph(b, name, size, fn() {
      if stage {
        mix(stage_muted, stage_text, hand.shown(b))
      } else {
        mix(ui_muted(), ui_text(), hand.shown(b))
      }
    })
  })}

fn text_button(parent : view::View, label : () -> String, press : () -> Unit, icon? : String, ghost? : Bool, small? : Bool, danger? : Bool) -> view::View {
  let icon = match icon { Some(__mbt_v) => __mbt_v, None => "" }
  let ghost = match ghost { Some(__mbt_v) => __mbt_v, None => false }
  let small = match small { Some(__mbt_v) => __mbt_v, None => false }
  let danger = match danger { Some(__mbt_v) => __mbt_v, None => false }

  pressable(parent, label, press, fn(b) {
    let (hand, _) = answer(b)
    b
    .row(view::Live::Is(true))
    .height(view::Live::Is(Some(if small { 28.0 } else { 32.0 })))
    .padding(view::Live::Is(if small { (9.0, 0.0, 10.0, 0.0) } else { (12.0, 0.0, 12.0, 0.0) }))
    .gap(view::Live::Is(if small { 6.0 } else { 7.0 }))
    .radius(view::Live::Is(if small { 6.0 } else { 8.0 }))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .edge(view::Live::By(fn() { if b.focus_shown() { (1.5, focus_ring()) } else { (0.0, 0L) } }))
    .ground(view::Live::By(fn() {
      let h = hand.shown(b)
      if danger {
        danger_ground(h)
      } else if ghost {
        mix(clear(c_s3()), c_s3(), h)
      } else {
        mix(c_s3(), c_s4(), h)
      }
    }))
    |> ignore
    let ink = fn() {
      if danger {
        danger_ink()
      } else if ghost {
        mix(ui_muted(), ui_text(), hand.shown(b))
      } else {
        ui_text()
      }
    }
    if icon != "" {
      glyph(b, fn() { icon }, if small { 14.0 } else { 16.0 }, ink)
    }
    words(b, label, if small { 12.0 } else { 13.0 }, ink, weight=500) |> ignore
  })}

fn solid_button(parent : view::View, label : () -> String, press : () -> Unit, icon? : String, small? : () -> String) -> view::View {
  let icon = match icon { Some(__mbt_v) => __mbt_v, None => "" }

  pressable(parent, label, press, fn(b) {
    let (hand, _) = answer(b)
    b
    .row(view::Live::Is(true))
    .height(view::Live::Is(Some(32.0)))
    .padding(view::Live::Is((12.0, 0.0, 12.0, 0.0)))
    .gap(view::Live::Is(7.0))
    .radius(view::Live::Is(8.0))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .edge(view::Live::By(fn() { if b.focus_shown() { (1.5, ui_subtle()) } else { (0.0, 0L) } }))
    .ground(view::Live::By(fn() { mix(ui_accent(), ui_accent_hover(), hand.shown(b)) }))
    |> ignore
    if icon != "" {
      glyph(b, fn() { icon }, 16.0, ui_on_accent)
    }
    words(b, label, 13.0, ui_on_accent, weight=600) |> ignore
    match small {
      Option::Some(s) => words(b, s, 12.0, fn() { tone(0x1112149EL, 0xFFFFFF9EL) }) |> ignore
      Option::None => ()
    }
  })}

fn rule(parent : view::View, ink : () -> Int64) -> Unit {
  parent.box(fn(r) { r.height(view::Live::Is(Some(1.0))).fills_across(view::Live::Is(true)).ground(view::Live::By(ink)) |> ignore }) |> ignore}

fn spring(parent : view::View) -> Unit {
  parent.box(fn(s) { s.grow(view::Live::Is(1.0)) |> ignore }) |> ignore}

fn play_pause_picture(k : Double) -> pixels::Vector {
  // Draw single triangle at rest; two abutting polygons leave an AA seam at x=7.65 under 150% DPI.
  if k <= 0.001 {
    return vectors(14.0, 14.0, [("M3.0 1.8L12.3 7.0L3.0 12.2Z", 0.0)])
  }
  let lerp = fn(a : (Double, Double), b : (Double, Double)) { (a.0 + (b.0 - a.0) * k, a.1 + (b.1 - a.1) * k) }
  let quad = fn(play : Array[(Double, Double)], pause : Array[(Double, Double)]) {
    let p = arr_mapi(play, fn(i, a) { lerp(a, pause[i]) })
    "M\{p[0].0} \{p[0].1}L\{p[1].0} \{p[1].1}L\{p[2].0} \{p[2].1}L\{p[3].0} \{p[3].1}Z"
  }
  // Split triangle into two quads (degenerate tip on right) to morph smoothly into pause bars.
  let left = quad([(3.0, 1.8), (7.65, 4.4), (7.65, 9.6), (3.0, 12.2)], [(3.5, 2.0), (6.0, 2.0), (6.0, 12.0), (3.5, 12.0)])
  let right = quad([(7.65, 4.4), (12.3, 7.0), (12.3, 7.0), (7.65, 9.6)], [(8.0, 2.0), (10.5, 2.0), (10.5, 12.0), (8.0, 12.0)])
  vectors(14.0, 14.0, [(left, 0.0), (right, 0.0)])}

fn play_button(parent : view::View, press : () -> Unit, playing? : () -> Bool, stage? : Bool) -> Unit {
  let playing = match playing { Some(__mbt_v) => __mbt_v, None => fn() { want_play.get() } }
  let stage = match stage { Some(__mbt_v) => __mbt_v, None => false }

  let label = fn() { if playing() { t("暂停") } else { t("播放") } }
  let k = pressable(parent, label, press, fn(b) {
    let (hand, _) = answer(b)
    let morph = motion::NodeWay::new(if signals::untracked(playing) { 1.0 } else { 0.0 })
    b.reacts(playing, fn(on) { morph.go_ms(b, if on { 1.0 } else { 0.0 }, if motion_off() { 1.0 } else { 180.0 }) })
    b
    .width(view::Live::Is(Some(36.0)))
    .height(view::Live::Is(Some(32.0)))
    .radius(view::Live::Is(6.0))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .lies_along(view::Live::Is(view::Lies::Middle))
    .edge(view::Live::By(fn() { if b.focus_shown() { (1.5, if stage { 0xFFFFFFB3L } else { focus_ring() }) } else { (0.0, 0L) } }))
    .ground(view::Live::By(fn() {
      let on = if stage { stage_hover } else { c_s3() }
      mix(clear(on), on, hand.shown(b))
    }))
    |> ignore
    b.box(fn(g) {
      g
      .width(view::Live::Is(Some(20.0)))
      .height(view::Live::Is(Some(20.0)))
      .picture(view::Live::By(fn() { Some(play_pause_picture(morph.shown(g))) }))
      .tint(view::Live::By(fn() { if stage { stage_text } else { ui_text() } }))
      |> ignore
    })
    |> ignore
  })
  tip(k, label, shortcut="play")}

