import "mbt_compat"

pub struct Settings {
  mut enabled : Bool
  mut window_minutes : Int
  mut max_gb : Int
  mut autostart : Bool
  mut system_audio : Bool
  mut microphone : Bool
  mut pause_in_fullscreen : Bool
  mut codec : String
  mut max_height : Int
  mut fps : Int
  mut quality : String
  mut last_seconds : Int
  mut buffer_dir : String
  mut consent_version : Int
  mut consent_at : Double
  mut auto_update : Bool
}

fn sets() -> Settings {
  settings_rev.get() |> ignore
  settings}

fn settings_path() -> String {
  pjoin(root_dir(), "settings.json")}

fn load_settings() -> Unit {
  match parse(read_text(settings_path())) {
    Option::Some(Object(o)) => {
      match o.get("enabled") {
        Option::Some(True) => settings.enabled = true
        Option::Some(False) => settings.enabled = false
        _ => ()
      }
      match o.get("windowMinutes") {
        Option::Some(Number(v, _)) => settings.window_minutes = v.to_int()
        _ => ()
      }
      match o.get("maxGB") {
        Option::Some(Number(v, _)) => settings.max_gb = v.to_int()
        _ => ()
      }
      match o.get("autostart") {
        Option::Some(True) => settings.autostart = true
        Option::Some(False) => settings.autostart = false
        _ => ()
      }
      match o.get("systemAudio") {
        Option::Some(True) => settings.system_audio = true
        Option::Some(False) => settings.system_audio = false
        _ => ()
      }
      match o.get("microphone") {
        Option::Some(True) => settings.microphone = true
        Option::Some(False) => settings.microphone = false
        _ => ()
      }
      match o.get("codec") {
        Option::Some(String(v)) => settings.codec = if v == "h264" { "h264" } else { "hevc" }
        _ => ()
      }
      match o.get("maxHeight") {
        Option::Some(Number(v, _)) => settings.max_height = v.to_int()
        _ => ()
      }
      match o.get("fps") {
        Option::Some(Number(v, _)) => settings.fps = fps_of(v)
        _ => ()
      }
      match o.get("quality") {
        Option::Some(String(v)) => settings.quality = v
        _ => ()
      }
      match o.get("lastSeconds") {
        Option::Some(Number(v, _)) => settings.last_seconds = v.to_int()
        _ => ()
      }
      match o.get("bufferDir") {
        Option::Some(String(v)) => settings.buffer_dir = v
        _ => settings.buffer_dir = ""
      }
      match o.get("pauseInFullscreen") {
        Option::Some(True) => settings.pause_in_fullscreen = true
        Option::Some(False) => settings.pause_in_fullscreen = false
        _ => ()
      }
      match o.get("autoUpdate") {
        Option::Some(True) => settings.auto_update = true
        Option::Some(False) => settings.auto_update = false
        _ => settings.auto_update = true
      }
      match o.get("consent") {
        Option::Some(mbt_compat::MbtJson::Object(c)) => {
          settings.consent_version = match c.get("version") {
            Some(mbt_compat::MbtJson::Number(v, _)) => v.to_int()
            _ => 0
          }
          settings.consent_at = match c.get("at") {
            Some(mbt_compat::MbtJson::Number(at, _)) => at
            _ => 0.0
          }
        }
        _ => {
          settings.consent_version = 0
          settings.consent_at = 0.0
        }
      }
    }
    _ => ()
  }
  settings_rev.set(settings_rev.untracked() + 1)}

fn json_escaped(text : String) -> String {
  let b = StringBuilder()
  let mut i = 0
  while i < text.length() {
    let cu = text.code_unit_at(i)
    if cu == 92 || cu == 34 {
      b.write_byte(92 as Byte)
    }
    b.write_byte(cu as Byte)
    i += 1
  }
  b.to_string()}

fn save_settings() -> Unit {
  settings_rev.set(settings_rev.untracked() + 1)
  let text = "{\"enabled\":\{settings.enabled},\"windowMinutes\":\{settings.window_minutes},\"maxGB\":\{settings.max_gb},\"autostart\":\{settings.autostart},\"systemAudio\":\{settings.system_audio},\"microphone\":\{settings.microphone},\"pauseInFullscreen\":\{settings.pause_in_fullscreen},\"autoUpdate\":\{settings.auto_update},\"codec\":\"\{settings.codec}\",\"maxHeight\":\{settings.max_height},\"fps\":\{settings.fps},\"quality\":\"\{settings.quality}\",\"lastSeconds\":\{settings.last_seconds},\"bufferDir\":\"\{json_escaped(settings.buffer_dir)}\"" +
    (if settings.consent_version > 0 {
      ",\"consent\":{\"version\":\{settings.consent_version},\"at\":\{settings.consent_at.to_int64()}}"
    } else {
      ""
    }) +
    "}"
  rp_write(cstr(settings_path()), mbt_compat::utf8_encode(text)) |> ignore}

fn index_of(xs : Array[Int], v : Int, fallback : Int) -> Int {
  for i, x in xs {
    if x == v {
      return i
    }
  }
  fallback}

fn index_of_text(xs : Array[String], v : String, fallback : Int) -> Int {
  for i, x in xs {
    if x == v {
      return i
    }
  }
  fallback}

pub struct RecordingInfo {
  codec : String
  width : Int
  height : Int
  screen_w : Double
  screen_h : Double
  audio_trouble : String
  buffer_dir : String
  buffer_trouble : String
  disk_tight : Bool
  fast_sync : String
  display_hz : Int
  fps_fell_back : Bool
  shared_gpu : Bool
  frames_encoded : Int
  frames_skipped : Int
}

fn fps_of(v : Double) -> Int {
  if v >= 120.0 {
    120
  } else if v >= 90.0 {
    90
  } else if v >= 60.0 {
    60
  } else {
    30
  }}

fn state_json() -> Option[mbt_compat::MbtJson] {
  let rev = status_rev.untracked()
  let (at, j) = state_read.v
  if at == rev {
    return j
  }
  let j = parse(read_text(pjoin(root_dir(), "state.json")))
  state_read.v = (rev, j)
  j}

fn recording_info() -> RecordingInfo {
  let mut info = RecordingInfo::{
    codec: "",
    width: 0,
    height: 0,
    screen_w: 0.0,
    screen_h: 0.0,
    audio_trouble: "",
    buffer_dir: "",
    buffer_trouble: "",
    disk_tight: false,
    fast_sync: "",
    display_hz: 0,
    fps_fell_back: false,
    shared_gpu: false,
    frames_encoded: 0,
    frames_skipped: 0,
  }
  match state_json() {
    Option::Some(Object(o)) => {
      let num = fn(k : String) {
        match o.get(k) {
          Option::Some(Number(v, _)) => v
          _ => 0.0
        }
      }
      let codec = match o.get("codec") {
        Option::Some(String(v)) => v
        _ => ""
      }
      info = RecordingInfo::{
        codec: codec,
        width: num("width").to_int(),
        height: num("height").to_int(),
        screen_w: num("screenWidth"),
        screen_h: num("screenHeight"),
        audio_trouble: match o.get("audioTrouble") {
          Option::Some(String(v)) => v
          _ => ""
        },
        buffer_dir: match o.get("bufferDir") {
          Option::Some(String(v)) => v
          _ => ""
        },
        buffer_trouble: match o.get("bufferTrouble") {
          Option::Some(String(v)) => v
          _ => ""
        },
        disk_tight: o.get("diskTight") is Some(True),
        fast_sync: match o.get("fastSync") {
          Option::Some(String(v)) => v
          _ => ""
        },
        display_hz: num("displayHz").to_int(),
        fps_fell_back: o.get("fpsWhy") is Some(String("fallback")),
        shared_gpu: o.get("sharedGpu") is Some(True),
        frames_encoded: num("framesEncoded").to_int(),
        frames_skipped: num("framesSkipped").to_int(),
      }
    }
    _ => ()
  }
  info}

// Must match recorder's recording/Bitrate.cs bitrate formula.
fn planned_bitrate(screen_w : Double, screen_h : Double) -> Double {
  let mut w = if screen_w > 0.0 { screen_w } else { 1920.0 }
  let mut h = if screen_h > 0.0 { screen_h } else { 1080.0 }
  if settings.max_height > 0 && h > settings.max_height.to_double() {
    w = w * settings.max_height.to_double() / h
    h = settings.max_height.to_double()
  }
  let megapixels = dmax(2.0, (w / 2.0).floor() * 2.0) *
    dmax(2.0, (h / 2.0).floor() * 2.0) /
    1000000.0
  let q = match settings.quality {
    "low" => 0.5
    "medium" => 0.75
    "ultra" => 1.6
    _ => 1.0
  }
  let c = if settings.codec == "h264" { 1.5 } else { 1.0 }
  let fps = fps_of(settings.fps.to_double()).to_double()
  let rate = 3000000.0 *
    mbt_compat::math_pow(megapixels, 0.8) *
    mbt_compat::math_pow(fps / 30.0, 0.6) *
    q *
    c
  dmin(150000000.0, dmax(1000000.0, rate))}

fn bytes_text(bytes : Double) -> String {
  let mb = bytes / 1048576.0
  if mb >= 1024.0 {
    let tenths = (mb / 102.4).round().to_int()
    "\{tenths / 10}.\{tenths % 10} GB"
  } else if mb < 0.995 {
    "\{imax(1, (bytes / 1024.0).round().to_int())} KB"
  } else {
    "\{mb.round().to_int()} MB"
  }}

fn shortcut_rows() -> Array[(String, Array[String])] {
  let mac = is_mac()
  [
    (t("打开回放"), [if mac { "⌃⌥R" } else { "Ctrl+Alt+R" }]),
    (t("标记此刻"), [if mac { "⌃⌥M" } else { "Ctrl+Alt+M" }]),
    (t("保存最近一段"), [if mac { "⌃⌥S" } else { "Ctrl+Alt+S" }]),
    (t("播放 / 暂停"), ["Space", "K"]),
    (t("逐帧"), ["←", "→"]),
    (t("前后 5 秒"), [if mac { "⇧←" } else { "Shift+←" }, if mac { "⇧→" } else { "Shift+→" }]),
    (t("前后 15 秒"), ["J", "L"]),
    (t("在当前位置加标记"), ["M"]),
    (t("上一个 / 下一个标记"), ["[", "]"]),
    (t("复制当前帧"), [if mac { "⌘C" } else { "Ctrl+C" }]),
    (t("剪辑"), ["C"]),
    (t("设起点 / 终点"), ["I", "O"]),
    (t("撤销 / 重做"), if mac { ["⌘Z", "⇧⌘Z"] } else { ["Ctrl+Z", "Ctrl+Y"] }),
    (t("保存片段"), if mac { ["Enter", "⌘S"] } else { ["Enter", "Ctrl+S"] }),
    (t("保存并复制"), if mac { ["⇧Enter", "⇧⌘S"] } else { ["Shift+Enter", "Ctrl+Shift+S"] }),
    (t("回到最新"), if mac { ["⌘→", "End"] } else { ["End"] }),
    (t("时间线缩放"), ["+", "-"]),
    (t("适应窗口"), ["0"]),
    (t("全屏"), ["F"]),
    (t("设置"), [if mac { "⌘," } else { "Ctrl+," }]),
  ]}

