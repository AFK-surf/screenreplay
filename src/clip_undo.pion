import "signals"

struct ClipSnap {
  a : Double
  b : Double
  kind : Int
  region : Option[(Double, Double, Double, Double)]
  ratio : Int
  hwnd : Int64
  name : String
  process : String
}
pub fn __mbt_eq_clipsnap(a : ClipSnap, b : ClipSnap) -> Bool {
  (a.a == b.a) && (a.b == b.b) && (a.kind == b.kind) && (match (a.region, b.region) { (Some(__oa_3), Some(__ob_3)) => ((__oa_3).0 == (__ob_3).0) && ((__oa_3).1 == (__ob_3).1) && ((__oa_3).2 == (__ob_3).2) && ((__oa_3).3 == (__ob_3).3), (None, None) => true, _ => false }) && (a.ratio == b.ratio) && (a.hwnd == b.hwnd) && (a.name == b.name) && (a.process == b.process)
}

fn clip_steps_told() -> Unit {
  clip_steps.set(clip_steps.untracked() + 1)}

fn clip_now() -> ClipSnap {
  ClipSnap::{
    a: clip_a.get(),
    b: clip_b.get(),
    kind: clip_kind.get(),
    region: region.get(),
    ratio: region_ratio.get(),
    hwnd: picked_hwnd.get(),
    name: picked_name.get(),
    process: picked_process.get(),
  }}

fn clip_can_undo() -> Bool {
  clip_steps.get() |> ignore
  !clip_undos.is_empty() ||
  (match clip_marked.v {
    Some(was) => !__mbt_eq_clipsnap(was, clip_now())
    None => false
  })}

fn clip_can_redo() -> Bool {
  clip_steps.get() |> ignore
  !clip_redos.is_empty() &&
  (match clip_marked.v {
    Some(was) => __mbt_eq_clipsnap(was, clip_now())
    None => true
  })}

fn clip_snap() -> ClipSnap {
  signals::untracked(fn() {
    ClipSnap::{
      a: clip_a.get(),
      b: clip_b.get(),
      kind: clip_kind.get(),
      region: region.get(),
      ratio: region_ratio.get(),
      hwnd: picked_hwnd.get(),
      name: picked_name.get(),
      process: picked_process.get(),
    }
  })}

fn clip_mark() -> Unit {
  guard clipping.untracked() else { return }
  let now = clip_snap()
  match clip_marked.v {
    Some(was) if !__mbt_eq_clipsnap(was, now) => {
      clip_undos.push(was)
      if clip_undos.length() > clip_steps_kept {
        arr_remove(clip_undos, 0) |> ignore
      }
      clip_redos.clear()
    }
    _ => ()
  }
  clip_marked.v = Some(now)
  clip_steps_told()}

fn clip_history_free() -> Unit {
  clip_undos.clear()

  clip_redos.clear()

  clip_marked.v = None}

fn clip_history_start() -> Unit {
  clip_undos.clear()
  clip_redos.clear()
  clip_marked.v = Some(clip_snap())
  clip_steps_told()}

fn clip_put(s : ClipSnap) -> Unit {
  clip_a.set(s.a)
  clip_b.set(s.b)
  clip_kind.set(s.kind)
  region.set(s.region)
  region_ratio.set(s.ratio)
  region_selected.set(false)
  region_grab.set(0)
  picked_hwnd.set(s.hwnd)
  picked_name.set(s.name)
  picked_process.set(s.process)
  clip_marked.v = Some(s)
  clip_steps_told()}

fn clip_undo() -> Bool {
  guard clipping.untracked() else { return false }
  clip_mark()
  guard clip_undos.pop() is Some(s) else { return true }
  clip_redos.push(clip_snap())
  clip_put(s)
  true}

fn clip_redo() -> Bool {
  guard clipping.untracked() else { return false }
  clip_mark()
  guard clip_redos.pop() is Some(s) else { return true }
  clip_undos.push(clip_snap())
  clip_put(s)
  true}
