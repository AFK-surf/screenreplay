import "pixels"
import "signals"
import "view"

fn finder(w : Double) -> (Double, Double) {
  let total = ax_span(view_len())
  let k = if total > 0.0 { w / total } else { 0.0 }
  let tx = view_from.get() * k
  let tw = view_len() * k
  let fw = dmax(24.0, tw)
  (clamp(tx + tw / 2.0 - fw / 2.0, 0.0, dmax(0.0, w - fw)), fw)}

fn overview_drag(d : view::Drag, w : Double) -> Unit {
  let total = ax_span(signals::untracked(view_len))
  if w <= 0.0 || total <= 0.0 {
    return
  }
  let k = w / total
  match d.kind {
    Down => {
      region_let_go()
      let (fx, fw) = signals::untracked(fn() { finder(w) })
      let px = d.x
      let part = if (px - fx).abs() <= 6.0 {
        1
      } else if (px - (fx + fw)).abs() <= 6.0 {
        2
      } else if px > fx && px < fx + fw {
        3
      } else {
        0
      }
      let len = signals::untracked(view_len)
      if part == 0 {
        set_view(px / k - len / 2.0, len)
      }
      over_grab.v = (if part == 0 { 3 } else { part }, view_from.untracked(), signals::untracked(view_len))
      view_dragging.set(true)
      view_resizing.set(part == 1 || part == 2)
      // Save press-down x because raw drag events report current x rather than origin.
      over_down_x.v = d.x
    }
    Moved => {
      let (part, from0, len0) = over_grab.v
      let moved = (d.x - over_down_x.v) / k
      match part {
        1 => {
          let end = from0 + len0
          let from = clamp(from0 + moved, 0.0, end - min_view)
          set_view(from, end - from)
        }
        2 => set_view(from0, clamp(len0 + moved, min_view, total - from0))
        3 => {
          view_from.set(from0 + moved)
          follow_latest.set(from0 + moved + len0 >= total - 1.0)
          keep_view()
        }
        _ => ()
      }
    }
    Up | Off => {
      over_grab.v = (0, 0.0, 0.0)
      view_resizing.set(false)
      view_dragging.set(false)
    }
  }}

// slim: the floating deck's scroll track, the viewport a solid thumb on a thin rail.
fn overview(parent : view::View, slim? : Bool) -> Unit {
  let slim = match slim { Some(__mbt_v) => __mbt_v, None => false }
  parent.box(fn(row) {
    row.row(view::Live::Is(true)).margin(view::Live::Is(if slim { (16.0, 5.0, 16.0, 6.0) } else { (0.0, 4.0, 0.0, 0.0) })).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
    row.box(fn(cell) {
      cell.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))) |> ignore
      cell.by_room(fn(track, room) {
        let w = fn() { room.width() }
        let k = fn() {
          data()
          let total = ax_span(view_len())
          if total > 0.0 { w() / total } else { 0.0 }
        }
        let at = fn() {
          if !track.pointer_within() {
            return -1.0
          }
          track.pointer_piece(fn(x, _) { (dmax(0.0, x) * 4.0).round().to_int() }).to_double() / 4.0
        }
        track
        .height(view::Live::Is(Some(overview_h)))
        .presses(view::Live::Is(true))
        .cursor(view::Live::By(fn() {
          let x = at()
          let (a, fw) = finder(w())
          Some(
            if x >= 0.0 && ((x - a).abs() <= 6.0 || (x - a - fw).abs() <= 6.0) {
              view::Cursor::ResizeX
            } else if x > a && x < a + fw {
              view::Cursor::Arrow
            } else {
              view::Cursor::Arrow
            },
          )
        }))
        .on_drag(fn(d) { overview_drag(d, room.width()) }, captures=true)
        |> ignore
        track.box(fn(o) {
          o.over(view::Live::Is(true)).presses(view::Live::Is(false)).lines_up(view::Live::Is(Some(view::Along::Start))) |> ignore
          o.box(fn(tag) {
            tag
            .padding(view::Live::Is((6.0, 2.0, 6.0, 2.0)))
            .radius(view::Live::Is(4.0))
            .ground(view::Live::By(c_s2))
            .edge(view::Live::By(fn() { (1.0, hair2()) }))
            .laid_nowhere(view::Live::By(fn() { at() < 0.0 || grabbed.get() != 0 }))
            .offset(view::Live::By(fn() { (clamp(at() - 30.0, 0.0, dmax(0.0, w() - 60.0)), -22.0) }))
            |> ignore
            words(tag, fn() {
              let x = at()
              if x < 0.0 || k() <= 0.0 {
                ""
              } else {
                wall(t0() + ax_b(x / k(), view_len()), short=true)
              }
            }, 11.0, ui_muted)
            |> ignore
          })
          |> ignore
        })
        |> ignore
        track.box(fn(b) {
          b
          .over(view::Live::Is(true))
          .presses(view::Live::Is(false))
          .picture(view::Live::By(fn() {
            let width = w()
            if width <= 0.0 {
              return None
            }
            if slim {
              let track = layer(rrect_d(0.0, (overview_h - 5.0) / 2.0, width, 5.0, 2.5), tone(0x1E1E218CL, 0xFFFFFF57L), stroke=tone(0xFFFFFF1AL, 0x00000024L), width=0.5)
              return Some(pixels::Vector::{ w: width, h: overview_h, layers: [track] })
            }
            let layers : Array[pixels::VectorPath] = [
              layer(hatch_d(0.0, width, 4.0), 0L, stroke=tone(0xFFFFFF17L, 0x00000017L), width=1.0),
            ]
            let vl = view_len()
            let spans = match axis_now.get() {
              Option::Some(a) => a.ks
              Option::None => runs_now.get()
            }
            for r in spans {
              let a = clamp(ax_d(r.0, vl) * k(), 0.0, width)
              let z = clamp(ax_d(r.1, vl) * k(), 0.0, width)
              if z - a >= 1.0 {
                layers.push(layer(rect_d(a, 0.0, z - a, 4.0), c_s4()))
              }
            }
            layers.push(layer(rect_d(0.5, 0.5, width - 1.0, 3.0), 0L, stroke=hair(), width=1.0))
            Some(pixels::Vector::{ w: width, h: overview_h, layers: arr_map(layers, fn(l) { pixels::VectorPath::{ d: l.d, fill: l.fill, stroke: l.stroke, width: l.width, even_odd: l.even_odd, sx: l.sx, sy: l.sy, tx: l.tx, ty: (overview_h - 4.0) / 2.0 } }) })
          }))
          |> ignore
        })
        |> ignore
        track.box(fn(o) {
          o.over(view::Live::Is(true)).presses(view::Live::Is(false)).lines_up(view::Live::Is(Some(view::Along::Start))) |> ignore
          o.box(fn(f) {
            f
            .height(view::Live::Is(Some(if slim { 5.0 } else { overview_h })))
            .radius(view::Live::Is(2.5))
            .ground(view::Live::By(fn() { if slim { tone(0xFFFFFFE6L, 0xFFFFFFFFL) } else { tone(0xEDEEF02EL, 0x17181B2EL) } }))
            .edge(view::Live::By(fn() { if slim { (0.5, 0x00000033L) } else { (1.0, tone(0xEDEEF066L, 0x17181B52L)) } }))
            .shadow(view::Live::Is(if slim { (4.0, 1.0, 0x00000059L) } else { (0.0, 0.0, 0L) }))
            .shadow_outside(view::Live::Is(true))
            .width(view::Live::By(fn() { Some(finder(w()).1) }))
            .offset(view::Live::By(fn() { (finder(w()).0, if slim { (overview_h - 5.0) / 2.0 } else { 0.0 }) }))
            |> ignore
          })
          |> ignore
        })
        |> ignore
        for end in (if slim { [] } else { [0, 1] }) {
          track.box(fn(o) {
            o.over(view::Live::Is(true)).presses(view::Live::Is(false)).lines_up(view::Live::Is(Some(view::Along::Start))) |> ignore
            o.box(fn(h) {
              h
              .width(view::Live::Is(Some(2.0)))
              .height(view::Live::Is(Some(4.0)))
              .radius(view::Live::Is(1.0))
              .ground(view::Live::By(ui_muted))
              .offset(view::Live::By(fn() {
                let (fx, fw) = finder(w())
                (if end == 0 { fx + 4.0 } else { fx + fw - 6.0 }, (overview_h - 4.0) / 2.0)
              }))
              |> ignore
            })
            |> ignore
          })
          |> ignore
        }
        track.box(fn(o) {
          o.over(view::Live::Is(true)).presses(view::Live::Is(false)).lines_up(view::Live::Is(Some(view::Along::Start))) |> ignore
          o.box(fn(p) {
            p
            .width(view::Live::Is(Some(2.0)))
            .height(view::Live::Is(Some(overview_h)))
            .radius(view::Live::Is(1.0))
            .ground(view::Live::By(ui_text))
            .laid_nowhere(view::Live::Is(slim))
            .drawn_off(
              view::Live::By(fn() { (clamp(ax_d(pos_drawn(p), view_len()) * k(), 1.0, dmax(1.0, w() - 1.0)) - 1.0, 0.0) }),
              exact=true,
            )
            |> ignore
          })
          |> ignore
        })
        |> ignore
        track.box(fn(o) {
          o.over(view::Live::Is(true)) |> ignore
          o.each(fn() {
            data()
            marks.copy()
          }, fn(m : Double) -> Int64 { m.to_int64() }, fn(row, m) {
            let abs = m.untracked()
            row.over(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))) |> ignore
            pressable(row, fn() { wall(abs) }, fn() { jump_to(abs - t0()) }, fn(b) {
              b
              .width(view::Live::Is(Some(12.0)))
              .height(view::Live::Is(Some(12.0)))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .lies_along(view::Live::Is(view::Lies::Middle))
              .offset(view::Live::By(fn() { (ax_d(abs - t0(), view_len()) * k() - 6.0, 0.0) }))
              |> ignore
              b.box(fn(dot) {
                let r = fn() { if b.pointed() { 6.0 } else { 4.0 } }
                dot.width(view::Live::By(fn() { Some(r()) })).height(view::Live::By(fn() { Some(r()) })).radius(view::Live::Is(3.0)).ground(view::Live::By(if slim { fn() { tone(0xFFFFFFB3L, 0x1D1D1FBFL) } } else { ui_text })) |> ignore
              })
              |> ignore
              tip(b, fn() { wall(abs) })
            })
            |> ignore
          }, at_once=true)
        })
        |> ignore
      })
      |> ignore
    })
    |> ignore
  })
  |> ignore}
