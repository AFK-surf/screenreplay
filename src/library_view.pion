import "mbt_compat"
import "motion"
import "signals"
import "ui"
import "view"

fn clips_read() -> Unit {
  load_clips()
  clips_rev.set(clips_rev.untracked() + 1)}

// Leading pre-roll duration (ms) from MP4 edit list that Media Foundation's reader does not skip.
fn clip_lead(path : String) -> Double {
  if is_gif_path(path) {
    return 0.0
  }
  match clip_leads.get(path) {
    Option::Some(ms) => ms
    Option::None => {
      let ms = match track_of(path, "vide") {
        Option::Some(t) => dmax(0.0, -sample_ms(t, 0))
        Option::None => 0.0
      }
      clip_leads.set(path, ms)
      ms
    }
  }}

fn clip_thumb(path : String) -> String {
  let identity = "\{path}|\{rp_size(cstr(path))}|\{rp_modified(cstr(path))}"
  let key = "mem:saved-clip-" + identity
  if ui::image_bytes_for(key).is_some() {
    return key
  }
  // Bias +39 ms because rp_clip_thumb selects the first frame within 40 ms before target.
  let lead = clip_lead(path)
  let bmp = rp_clip_thumb(cstr(path), cstr(identity), if lead > 0.0 { lead + 39.0 } else { 0.0 })
  if bmp.length() > 1 {
    ui::add_image(key, bmp)
    clip_thumb_kept(path, key)
    key
  } else if bmp.length() == 1 && bmp[0].to_int() == 1 {
    "!"
  } else {
    // Coalesce thumbnail retries into a single 50 ms timer across all cards.
    if !clip_thumb_due.v {
      match the_root.v {
        Some(r) => {
          clip_thumb_due.v = true
          r.at_moment(now() + 50.0, fn() {
            clip_thumb_due.v = false
            clips_rev.set(clips_rev.untracked() + 1)
          })
          |> ignore
        }
        None => ()
      }
    }
    ""
  }}

fn clip_card(parent : view::View, name : String) -> Unit {
  let path = pjoin(clips_dir(), name)
  parent.box(fn(card) {
    card.gap(view::Live::Is(10.0)) |> ignore
    pressable(card, fn() { clip_title(name) }, fn() { open_clip_player(path) }, fn(pic) {
      pic
      .aspect(view::Live::Is(16.0 / 9.0))
      .radius(view::Live::Is(8.0))
      .clips(view::Live::Is(true))
      .ground(view::Live::Is(picture_ground))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .edge(view::Live::By(fn() {
        if pic.focus_shown() {
          (1.5, focus_ring())
        } else if pic.pointed() {
          (1.0, tone(0xFFFFFF33L, 0x00000040L))
        } else {
          (1.0, hair2())
        }
      }))
      .image(view::Live::By(fn() {
        clips_rev.get() |> ignore
        let k = if av1_unplayable(path) { "!" } else { clip_thumb(path) }
        if k == "" || k == "!" {
          None
        } else {
          Some((k, "", 640))
        }
      }))
      .image_contains(view::Live::Is(true))
      |> ignore
      words(pic, fn() {
        clips_rev.get() |> ignore
        if av1_unplayable(path) {
          return t(if is_mac() { "此设备不支持 AV1 硬解" } else { "需要 AV1 视频扩展" })
        }
        match clip_thumb(path) {
          "" => t("加载预览…")
          "!" => t("暂无预览")
          _ => ""
        }
      }, 11.0, ui_muted)
      |> ignore
      pic.box(fn(o) {
        o.over(view::Live::Is(true)).pad(view::Live::Is(8.0)).lines_up(view::Live::Is(Some(view::Along::End))).lies_along(view::Live::Is(view::Lies::End)) |> ignore
        let ms = clip_duration(path)
        if ms > 0.0 {
          o.box(fn(tag) {
            tag.height(view::Live::Is(Some(20.0))).padding(view::Live::Is((6.0, 0.0, 6.0, 0.0))).radius(view::Live::Is(4.0)).ground(view::Live::Is(0x000000B3L)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle)) |> ignore
            words(tag, fn() { clock(ms) }, 11.0, fn() { 0xFFFFFFFFL }, weight=500) |> ignore
          })
          |> ignore
        }
      })
      |> ignore
      pic.box(fn(o) {
        o
        .over(view::Live::Is(true))
        .presses(view::Live::Is(false))
        .ground(view::Live::Is(0x00000040L))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Middle))
        .alpha(view::Live::By(fn() { if pic.pointed() { 1.0 } else { 0.0 } }))
        |> ignore
        o.box(fn(c) {
          c.width(view::Live::Is(Some(40.0))).height(view::Live::Is(Some(40.0))).radius(view::Live::Is(20.0)).ground(view::Live::Is(0xFFFFFFE6L)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle)) |> ignore
          sf_icon_node(c, "play", 18.0, view::Live::Is(0x0F1011FFL)) |> ignore
        })
        |> ignore
      })
      |> ignore
    })
    |> ignore
    card.box(fn(foot) {
      foot.row(view::Live::Is(true)).height(view::Live::Is(Some(34.0))).gap(view::Live::Is(2.0)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
      foot.box(fn(n) {
        n.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(2.0)).clips(view::Live::Is(true)) |> ignore
        words(n, fn() { clip_title(name) }, 13.0, ui_text, weight=500).min_width(view::Live::Is(Some(0.0))).allow_ellipsis(view::Live::Is(true)) |> ignore
        words(n, fn() { bytes_text(rp_size(cstr(path))) }, 12.0, ui_subtle).min_width(view::Live::Is(Some(0.0))).allow_ellipsis(view::Live::Is(true)) |> ignore
      })
      |> ignore
      foot.pick(fn() { delete_pending.get() == name }, fn(b, asking) {
        b.row(view::Live::Is(true)).gap(view::Live::Is(4.0)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
        if asking {
          text_button(b, fn() { t("取消") }, fn() { delete_pending.set("") }, ghost=true, small=true) |> ignore
          let del = text_button(b, fn() { t("删除") }, fn() {
            let result = rp_recycle(cstr(path))
            library_message.set(
              if result == 0 {
                t(if is_mac() { "已移到废纸篓，可在废纸篓恢复" } else { "已移到回收站，可在回收站恢复" })
              } else {
                tf(if is_mac() { "未能移到废纸篓（{0}），文件仍保留" } else { "未能移到回收站（{0}），文件仍保留" }, [result.to_string()])
              },
            )
            delete_pending.set("")
            clips_read()
          }, danger=true, small=true)
          tip(del, fn() { t(if is_mac() { "移到废纸篓" } else { "移到回收站" }) })
        } else {
          icon_button(b, fn() { "copy" }, fn() { t("复制") }, fn() {
            library_message.set(
              if rp_copy_file(cstr(path)) == 1 {
                tf("已复制「{0}」，可直接粘贴到聊天或文件夹", [clip_title(name)])
              } else {
                t("没能复制到剪贴板")
              },
            )
          })
          |> ignore
          icon_button(b, fn() { "folder" }, fn() { t(if is_mac() { "在 Finder 中显示" } else { "打开位置" }) }, fn() { rp_reveal(cstr(path)) }) |> ignore
          icon_button(b, fn() { "trash" }, fn() { t("删除") }, fn() { delete_pending.set(name) }) |> ignore
        }
      }, at_once=true)
    })
    |> ignore
  })
  |> ignore}

fn library_layer(root : view::View) -> Unit {
  root.box(fn(o) {
    o.over(view::Live::Is(true)).over_all(view::Live::By(fn() { library_open.get() })).padding(view::Live::Is((0.0, title_h() + 1.0, 0.0, 0.0))) |> ignore
    o.show(fn() { library_open.get() }, fn(page) {
      page.grow(view::Live::Is(1.0)).ground(view::Live::By(c_bg)).presses(view::Live::Is(true)).padding(view::Live::Is((28.0, 24.0, 28.0, 16.0))).gap(view::Live::Is(16.0)) |> ignore
      __mbt_local_library_layer_again_4(page)
      let pages = fn() {
        clips_rev.get() |> ignore
        imax(1, (clip_files.length() + clips_per_page - 1) / clips_per_page)
      }
      page.pick(fn() {
        clips_rev.get() |> ignore
        clip_files.is_empty()
      }, fn(b, empty) {
        b.grow(view::Live::Is(1.0)) |> ignore
        if empty {
          b.lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle)).gap(view::Live::Is(12.0)) |> ignore
          sf_icon_node(b, "clips", 32.0, view::Live::By(ui_subtle)) |> ignore
          words(b, fn() { t("还没有保存的片段") }, 15.0, ui_text, weight=600) |> ignore
          words(b, fn() { t("在回放里按 C 选取一段，按 Enter 保存，就会出现在这里。") }, 13.0, ui_muted) |> ignore
          b.box(fn(pad) {
            pad.padding(view::Live::Is((0.0, 4.0, 0.0, 0.0))) |> ignore
            text_button(pad, fn() { t("回到回放") }, fn() { library_open.set(false) }) |> ignore
          })
          |> ignore
        } else {
          b.gap(view::Live::Is(28.0)) |> ignore
          for row in 0..<2 {
            b.box(fn(r) {
              r.row(view::Live::Is(true)).gap(view::Live::Is(20.0)) |> ignore
              for col in 0..<4 {
                r.box(fn(cell) {
                  cell.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))) |> ignore
                  cell.pick(fn() {
                    clips_rev.get() |> ignore
                    let i = library_page.get() * clips_per_page + row * 4 + col
                    if i < clip_files.length() {
                      clip_files[i]
                    } else {
                      ""
                    }
                  }, fn(x, name) { if name != "" { clip_card(x, name) } }, at_once=true)
                })
                |> ignore
              }
            })
            |> ignore
          }
        }
      }, at_once=true)
      page.box(fn(foot) {
        foot.row(view::Live::Is(true)).height(view::Live::Is(Some(28.0))).gap(view::Live::Is(10.0)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
        words(foot, fn() { library_message.get() }, 12.0, ui_muted) |> ignore
        spring(foot)
        foot.show(fn() { pages() > 1 }, fn(b) {
          b.row(view::Live::Is(true)).gap(view::Live::Is(10.0)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
          let can_prev = fn() { library_page.get() > 0 }
          let can_next = fn() { library_page.get() + 1 < pages() }
          icon_button(b, fn() { "chevron-left" }, fn() { t("上一页") }, fn() {
            library_page.set(imax(0, library_page.untracked() - 1))
          })
          .alpha(view::Live::By(fn() { if can_prev() { 1.0 } else { 0.35 } }))
          .presses(view::Live::By(can_prev))
          |> ignore
          words(b, fn() { "\{library_page.get() + 1} / \{pages()}" }, 12.0, ui_muted) |> ignore
          icon_button(b, fn() { "chevron-right" }, fn() { t("下一页") }, fn() {
            library_page.set(imin(signals::untracked(pages) - 1, library_page.untracked() + 1))
          })
          .alpha(view::Live::By(fn() { if can_next() { 1.0 } else { 0.35 } }))
          .presses(view::Live::By(can_next))
          |> ignore
        }, at_once=true)
      })
      |> ignore
    }, at_once=true)
  })
  |> ignore}

fn av1_note_layer(root : view::View) -> Unit {
  sheet(root, fn() { av1_note.get() != "" }, fn() { av1_note.set("") }, 440.0, fn(card) {
    card.box(fn(head) {
      head.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
      words(head, fn() { t("这个片段是 AV1 格式") }, 15.0, ui_text, weight=600) |> ignore
      spring(head)
      icon_button(head, fn() { "close" }, fn() { t("关闭") }, fn() { av1_note.set("") }, size=12.0) |> ignore
    })
    |> ignore
    wrapped(card, fn() {
        t(if is_mac() {
            "这台 Mac 硬件不支持 AV1 解码（需 M3 或更新芯片），无法在这里直接播放。可在 Finder 中用第三方播放器打开。"
          } else {
            "这台电脑还不能解码 AV1，所以没法在这里播放和预览它。从 Microsoft Store 装上免费的「AV1 视频扩展」，再打开这个片段就能播放。"
          })
      }, 13.0, 19.0, ui_muted)
    card.box(fn(foot) {
      foot.row(view::Live::Is(true)).gap(view::Live::Is(8.0)).padding(view::Live::Is((0.0, 8.0, 0.0, 0.0))).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
      spring(foot)
      text_button(foot, fn() { t("关闭") }, fn() { av1_note.set("") }, ghost=true) |> ignore
      if is_mac() {
        solid_button(foot, fn() { t("在 Finder 中显示") }, fn() {
          rp_reveal(cstr(av1_note.untracked()))
          av1_note.set("")
        })
        |> ignore
      } else {
        solid_button(foot, fn() { t("在 Microsoft Store 获取") }, fn() {
          rp_launch(cstr(av1_store_page)) |> ignore
          av1_note.set("")
        })
        |> ignore
      }
    })
    |> ignore
  })}

fn clip_fit(v : view::View) -> (Double, Double) {
  let (w, h) = v.window()
  let a = dmax(0.1, clip_aspect.get())
  let (room_w, room_h) = if full_screen.get() {
    (w, h)
  } else {
    (w - 2.0 * stage_side, h - stage_top - stage_head_h - stage_bar_h - stage_row_h - stage_foot)
  }
  let vw = dmax(0.0, dmin(room_w, room_h * a))
  (vw, vw / a)}

fn edge_shade(parent : view::View, at_top : Bool) -> Unit {
  parent.box(fn(o) {
    o.over(view::Live::Is(true)).presses(view::Live::Is(false)).laid_nowhere(view::Live::By(fn() { !full_screen.get() })) |> ignore
    let n = 16
    for i in 0..<n {
      let k = (if at_top { i } else { n - 1 - i }).to_double() / (n - 1).to_double()
      let a = (0.62 * (1.0 - k) * (1.0 - k) * 255.0).round().to_int64()
      o.box(fn(b) { b.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).ground(view::Live::Is(a)) |> ignore }) |> ignore
    }
  })
  |> ignore}

fn clip_player_layer(root : view::View) -> Unit {
  root.box(fn(o) {
    o.over(view::Live::Is(true)).over_all(view::Live::By(fn() { clip_playing.get() != "" })) |> ignore
    o.pick(fn() { clip_playing.get() }, fn(s, path) {
      if path == "" {
        return
      }
      guard clip_deck.v is Some(d) else { return }
      let name = pbase(path)
      let fs = fn() { full_screen.get() }
      let (moved, lately) = s.holds_for(2000.0, later=true)
      let rows_way = motion::NodeWay::new(1.0)
      let head_ref : mbt_compat::Ref[Option[view::View]] = mbt_compat::ref_new(None)
      let foot_ref : mbt_compat::Ref[Option[view::View]] = mbt_compat::ref_new(None)
      let over_rows = fn() {
        (match head_ref.v {
          Some(v) => v.pointer_within()
          None => false
        }) ||
        (match foot_ref.v {
          Some(v) => v.pointer_within()
          None => false
        })
      }
      let rows_wanted = fn() { !fs() || lately() || clip_held.get() || menu_up.get() || over_rows() }
      let rows_shown = fn(v : view::View) { rows_way.shown(v) }
      s
      .grow(view::Live::Is(1.0))
      .modal(view::Live::Is(true))
      .presses(view::Live::Is(true))
      .on_press(fn() { if !full_screen.untracked() { close_clip_player() } })
      .on_pointer_moved(fn() { moved() })
      .ground(view::Live::By(fn() { if fs() { 0x000000FFL } else { stage_ground } }))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      |> ignore
      let toggle = clip_toggle
      let act = fn(action : String, f : () -> Unit) {
        s.on_action(action, fn(_) {
          f()
          true
        })
        |> ignore
      }
      act("play", toggle)
      act("escape", fn() { if full_screen.untracked() { set_full_screen(false) } else { close_clip_player() } })
      act("full", fn() { set_full_screen(!full_screen.untracked()) })
      act("back5", fn() { clip_seek(d.pos() - 5000.0) })
      act("on5", fn() { clip_seek(d.pos() + 5000.0) })
      act("back1", fn() { clip_seek(d.pos() - 1000.0) })
      act("on1", fn() { clip_seek(d.pos() + 1000.0) })
      act("frame-back", fn() { clip_step(-1) })
      act("frame-on", fn() { clip_step(1) })
      act("home", fn() { clip_seek(0.0) })
      act("latest", fn() {
        clip_pause()
        clip_seek((d.span)())
      })
      act("mark-back", fn() { clip_go_beside(-1) })
      act("mark-on", fn() { clip_go_beside(1) })
      act("page-back", fn() { clip_go_beside(-1) })
      act("page-on", fn() { clip_go_beside(1) })
      s.box(fn(col) {
        col
        .width(view::Live::By(fn() {
          if fs() {
            Some(col.window().0)
          } else {
            let max_w = dmax(320.0, col.window().0 - 2.0 * stage_side)
            Some(dmin(max_w, dmax(480.0, clip_fit(col).0)))
          }
        }))
        .height(view::Live::By(fn() { if fs() { Some(col.window().1) } else { None } }))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Middle))
        |> ignore
        col.box(fn(head) {
          head
          .over(view::Live::By(fs))
          .fills_across(view::Live::Is(true))
          .lies_along(view::Live::Is(view::Lies::Start))
          .alpha(view::Live::By(fn() { rows_shown(head) }))
          .laid_nowhere(view::Live::By(fn() { fs() && rows_shown(head) <= 0.0 }))
          |> ignore
          head.box(fn(band) {
            band.fills_across(view::Live::Is(true)) |> ignore
            edge_shade(band, true)
          band.box(fn(row) {
            head_ref.v = Some(row)
            row
            .row(view::Live::Is(true))
            .fills_across(view::Live::Is(true))
            .height(view::Live::Is(Some(36.0)))
            .margin(view::Live::By(fn() { if fs() { (20.0, 14.0, 14.0, 56.0) } else { (0.0, 0.0, 0.0, stage_head_h - 36.0) } }))
            .gap(view::Live::Is(2.0))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .presses(view::Live::Is(true))
            .on_press(fn() {  })
            .on_pointer_moved(fn() { moved() })
            |> ignore
            row.box(fn(n) {
              n.row(view::Live::Is(true)).grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).shrink(view::Live::Is(1.0)).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(10.0)).cuts(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
              words(n, fn() { clip_title(name) }, 13.0, fn() { stage_text }, weight=600).min_width(view::Live::Is(Some(0.0))).allow_ellipsis(view::Live::Is(true)) |> ignore
              words(n, fn() {
                bytes_text(rp_size(cstr(path))) + " · " + clock((d.span)())
              }, 12.0, fn() { stage_muted })
              |> ignore
            })
            |> ignore
            let (copied, copied_lately) = row.holds_for(1600.0, later=true)
            icon_button(row, fn() { if copied_lately() { "check" } else { "copy" } }, fn() { t("复制") }, fn() {
              if rp_copy_file(cstr(path)) == 1 {
                copied()
              }
            }, stage=true, tip_words=fn() { if copied_lately() { t("已复制") } else { t("复制到剪贴板") } })
            |> ignore
            icon_button(row, fn() { "folder" }, fn() { t(if is_mac() { "在 Finder 中显示" } else { "打开位置" }) }, fn() { rp_reveal(cstr(path)) }, stage=true, tip_words=fn() {
              t(if is_mac() { "在 Finder 中显示" } else { "在文件夹中显示" })
            })
            |> ignore
            icon_button(row, fn() { "close" }, fn() { t("关闭") }, close_clip_player, stage=true, shortcut="escape") |> ignore
          })
          |> ignore
          })
          |> ignore
        })
        |> ignore
        col.box(fn(pic) {
          pic
          .width(view::Live::By(fn() { Some(clip_fit(pic).0) }))
          .height(view::Live::By(fn() { Some(clip_fit(pic).1) }))
          .ground(view::Live::Is(picture_ground))
          .shadow(view::Live::By(fn() { if fs() { (0.0, 0.0, 0L) } else { (40.0, 12.0, 0x00000099L) } }))
          .clips(view::Live::Is(true))
          .presses(view::Live::Is(true))
          .on_press(toggle)
          .on_double_press(fn() { set_full_screen(!full_screen.untracked()) })
          .on_pointer_moved(fn() { moved() })
          |> ignore
          d.picture(pic).grow(view::Live::Is(1.0)) |> ignore
          play_state_over(pic, told=clip_told, playing=fn() { clip_view_playing.get() }, badge_may=fn() { true })
        })
        |> ignore
        col.box(fn(foot) {
          foot
          .over(view::Live::By(fs))
          .fills_across(view::Live::Is(true))
          .lies_along(view::Live::Is(view::Lies::End))
          .alpha(view::Live::By(fn() { rows_shown(foot) }))
          .laid_nowhere(view::Live::By(fn() { fs() && rows_shown(foot) <= 0.0 }))
          |> ignore
          foot.box(fn(band) {
            band.fills_across(view::Live::Is(true)) |> ignore
            edge_shade(band, false)
          band.box(fn(rows) {
            foot_ref.v = Some(rows)
            rows
            .fills_across(view::Live::Is(true))
            .margin(view::Live::By(fn() { if fs() { (20.0, 64.0, 20.0, 10.0) } else { (0.0, 0.0, 0.0, 0.0) } }))
            .presses(view::Live::Is(true))
            .on_press(fn() {  })
            .on_pointer_moved(fn() { moved() })
            |> ignore
            clip_progress(rows, d, path, moved)
            rows.box(fn(row) {
              row.row(view::Live::Is(true)).height(view::Live::Is(Some(stage_row_h))).gap(view::Live::Is(2.0)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
              let beside = fn(dir : Int) {
                fn() {
                  clip_playing.get() |> ignore
                  clips_rev.get() |> ignore
                  clip_beside(dir) is Some(_)
                }
              }
              let before = beside(-1)
              let after = beside(1)
              row.box(fn(b) {
                b.row(view::Live::Is(true)).margin(view::Live::Is((-6.0, 0.0, 0.0, 0.0))) |> ignore
                let k = icon_button(b, fn() { "skip-back" }, fn() { t("上一个片段") }, fn() { clip_go_beside(-1) }, stage=true, shortcut="clip-before")
                k.alpha(view::Live::By(fn() { if before() { 1.0 } else { 0.3 } })).presses(view::Live::By(before)) |> ignore
              })
              |> ignore
              play_button(row, toggle, playing=fn() { clip_view_playing.get() }, stage=true)
              row.box(fn(b) {
                let k = icon_button(b, fn() { "skip-forward" }, fn() { t("下一个片段") }, fn() { clip_go_beside(1) }, stage=true, shortcut="clip-after")
                k.alpha(view::Live::By(fn() { if after() { 1.0 } else { 0.3 } })).presses(view::Live::By(after)) |> ignore
              })
              |> ignore
              row.box(fn(time) {
                time.row(view::Live::Is(true)).margin(view::Live::Is((12.0, 0.0, 0.0, 0.0))).gap(view::Live::Is(5.0)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
                words(time, fn() { clock(d.pos_drawn(time)) }, 12.0, fn() { stage_text }, weight=500) |> ignore
                words(time, fn() { "/" }, 12.0, fn() { stage_subtle }) |> ignore
                words(time, fn() { clock((d.span)()) }, 12.0, fn() { stage_muted }) |> ignore
              })
              |> ignore
              spring(row)
              speed_key(row, now=fn() { clip_speed.get() }, set=set_clip_speed, stage=true)
              row.box(fn(g) { g.width(view::Live::Is(Some(4.0))) |> ignore }) |> ignore
              volume_control(row, stage=true, rate=fn() { clip_speed.get() })
              row.box(fn(b) {
                b.row(view::Live::Is(true)).margin(view::Live::Is((0.0, 0.0, -6.0, 0.0))) |> ignore
                icon_button(b, fn() { if fs() { "unfull" } else { "full" } }, fn() { if fs() { t("退出全屏") } else { t("全屏") } }, fn() {
                  set_full_screen(!full_screen.untracked())
                }, stage=true, shortcut="full")
                |> ignore
              })
              |> ignore
            })
            |> ignore
          })
          |> ignore
          })
          |> ignore
        })
        |> ignore
      })
      |> ignore
      s.reacts(rows_wanted, fn(on) {
        rows_way.go_ms(s, if on { 1.0 } else { 0.0 }, if motion_off() { 1.0 } else if on { 120.0 } else { 200.0 })
        if !on {
          rp_hide_cursor()
        }
      })
    }, at_once=true)
  })
  |> ignore}

fn clip_progress(parent : view::View, d : Deck, path : String, moved : () -> Unit) -> Unit {
  parent.by_room(fn(held, room) {
    let at_x = fn(x : Double) { clamp(x / dmax(1.0, room.width()), 0.0, 1.0) * (d.span)() }
    held.box(fn(hit) {
      hit
      .height(view::Live::Is(Some(stage_bar_h)))
      .presses(view::Live::Is(true))
      .cursor(view::Live::Is(Some(view::Cursor::Arrow)))
      .says(view::Live::By(fn() { Some(view::said(view::Role::Slider, label=t("播放进度"))) }))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .on_pointer_moved(moved)
      .on_drag(fn(e) {
        let at = at_x(e.x)
        match e.kind {
          Down => {
            clip_bar_down.v = e.x
            clip_bar_x.set(clamp(e.x, 0.0, room.width()))
            clip_seek(at)
          }
          Moved =>
            if clip_held.untracked() || (e.x - clip_bar_down.v).abs() >= 4.0 {
              clip_bar_x.set(clamp(e.x, 0.0, room.width()))
              clip_held.set(true)
              d.scrub(at)
            }
          Up | Off =>
            if clip_held.untracked() {
              clip_held.set(false)
              clip_seek(at)
            }
        }
      }, captures=true)
      |> ignore
      let hover = fn() {
        if clip_held.get() {
          return Some(clip_bar_x.get())
        }
        let q = hit.pointer_piece(fn(x, _) { (dmax(0.0, x) * 4.0).round().to_int() })
        if q < 0 || !hit.pointer_within() {
          None
        } else {
          Some(clamp(q.to_double() / 4.0, 0.0, room.width()))
        }
      }
      let share = fn() {
        if clip_held.get() {
          clamp(clip_bar_x.get() / dmax(1.0, room.width()), 0.0, 1.0)
        } else {
          clamp(d.pos_drawn(hit) / dmax(1.0, (d.span)()), 0.0, 1.0)
        }
      }
      let lit = motion::NodeWay::new(0.0)
      hit.reacts(fn() { hover() is Some(_) }, fn(on) {
        lit.go_ms(hit, if on { 1.0 } else { 0.0 }, if motion_off() { 1.0 } else { 120.0 })
      })
      let thick = fn(v : view::View) { 4.0 + 2.0 * lit.shown(v) }
      hit.box(fn(track) {
        track
        .height(view::Live::By(fn() { Some(thick(track)) }))
        .fills_across(view::Live::Is(true))
        .radius(view::Live::By(fn() { thick(track) / 2.0 }))
        .ground(view::Live::Is(stage_track))
        .clips(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Start)))
        |> ignore
        track.box(fn(o) {
          o.over(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))) |> ignore
          o.box(fn(f) {
            f
            .height(view::Live::By(fn() { Some(thick(f)) }))
            .ground(view::Live::Is(0xFFFFFF24L))
            .width_share(view::Live::By(fn() {
              match hover() {
                Some(x) if !clip_held.get() => clamp(x / dmax(1.0, room.width()), 0.0, 1.0)
                _ => 0.0
              }
            }))
            |> ignore
          })
          |> ignore
        })
        |> ignore
        track.box(fn(o) {
          o.over(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))) |> ignore
          o.box(fn(f) { f.height(view::Live::By(fn() { Some(thick(f)) })).ground(view::Live::Is(stage_text)).width_share(view::Live::By(share)) |> ignore }) |> ignore
        })
        |> ignore
      })
      |> ignore
      hit.box(fn(o) {
        o.over(view::Live::Is(true)).presses(view::Live::Is(false)).lines_up(view::Live::Is(Some(view::Along::Start))).lies_along(view::Live::Is(view::Lies::Middle)) |> ignore
        o.box(fn(k) {
          k
          .width(view::Live::Is(Some(12.0)))
          .height(view::Live::Is(Some(12.0)))
          .radius(view::Live::Is(6.0))
          .ground(view::Live::Is(0xFFFFFFFFL))
          .shadow(view::Live::Is((6.0, 1.0, 0x00000073L)))
          .alpha(view::Live::By(fn() { lit.shown(k) }))
          .scale(view::Live::By(fn() { 0.5 + 0.5 * lit.shown(k) }))
          .offset(view::Live::By(fn() { (share() * room.width() - 6.0, 0.0) }))
          |> ignore
        })
        |> ignore
      })
      |> ignore
      let pic_h = fn() { clamp(clip_card_w / dmax(0.1, clip_aspect.get()), 90.0, 180.0) }
      let card_w = clip_card_w + 8.0
      let card_h = fn() { pic_h() + 4.0 + 26.0 }
      let shown_at : mbt_compat::Ref[Double] = mbt_compat::ref_new(0.0)
      let last_key : mbt_compat::Ref[String] = mbt_compat::ref_new("")
      hit.box(fn(o) {
        o.over(view::Live::Is(true)).presses(view::Live::Is(false)).lines_up(view::Live::Is(Some(view::Along::Start))).lies_along(view::Live::Is(view::Lies::Start)) |> ignore
        // Hold hover 120 ms on leave to avoid flicker during transient pointer-leave events.
        let (left, left_lately) = o.holds_for(120.0)
        o.reacts(fn() { hover() is Some(_) }, fn(over) { if !over { left() } })
        let fade = motion::NodeWay::new(0.0)
        o.reacts(fn() { hover() is Some(_) || left_lately() }, fn(on) {
          fade.go_ms(o, if on { 1.0 } else { 0.0 }, if motion_off() { 1.0 } else { 100.0 })
        })
        let at = fn() {
          match hover() {
            Some(x) => {
              let a = at_x(x)
              shown_at.v = a
              a
            }
            None => shown_at.v
          }
        }
        let x_of = fn() {
          match hover() {
            Some(x) => x
            None => shown_at.v / dmax(1.0, (d.span)()) * room.width()
          }
        }
        o.box(fn(card) {
          card
          .width(view::Live::Is(Some(card_w)))
          .height(view::Live::By(fn() { Some(card_h()) }))
          .padding(view::Live::Is((4.0, 4.0, 4.0, 0.0)))
          .radius(view::Live::Is(8.0))
          .ground(view::Live::Is(stage_card))
          .edge(view::Live::Is((1.0, 0xFFFFFF1FL)))
          .shadow(view::Live::Is((28.0, 8.0, 0x000000A6L)))
          .alpha(view::Live::By(fn() { fade.shown(card) }))
          .laid_nowhere(view::Live::By(fn() { fade.shown(card) <= 0.0 }))
          .offset(view::Live::By(fn() {
            let x = x_of()
            (clamp(x - card_w / 2.0, 0.0, dmax(0.0, room.width() - card_w)), -card_h() - 6.0)
          }))
          |> ignore
          card.box(fn(p) {
            p
            .height(view::Live::By(fn() { Some(pic_h()) }))
            .radius(view::Live::Is(5.0))
            .clips(view::Live::Is(true))
            .ground(view::Live::Is(picture_ground))
            .image(view::Live::By(fn() {
              idx_tick.get() |> ignore
              let a = at()
              // GIF frames compose sequentially on the UI thread, so only prefetch +1 s ahead.
              let steps = if is_gif_path(path) { [1000.0] } else { [1000.0, -1000.0, 2000.0, -2000.0] }
              for step in steps {
                let k = clip_frame_key(path, a + step)
                if k != "" {
                  p.image_ask(k, clip_card_px)
                }
              }
              let want = clip_frame_key(path, a)
              if want == "" {
                return if last_key.v == "" { None } else { Some((last_key.v, "", clip_card_px.to_int())) }
              }
              let ready = p.image_ready(want, clip_card_px)
              let stand_in = last_key.v
              if ready {
                last_key.v = want
              }
              Some((want, if ready { "" } else { stand_in }, clip_card_px.to_int()))
            }))
            .image_contains(view::Live::Is(true))
            |> ignore
          })
          |> ignore
          card.box(fn(foot) {
            foot.height(view::Live::Is(Some(26.0))).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle)) |> ignore
            words(foot, fn() { clock(at()) }, 12.0, fn() { stage_text }, weight=500) |> ignore
          })
          |> ignore
        })
        |> ignore
      })
      |> ignore
    })
    |> ignore
  })
  |> ignore}
fn __mbt_local_library_layer_again_4(page : view::View) -> Unit {
        page.at_moment(now() + 3000.0, fn() {
          clips_read()
          __mbt_local_library_layer_again_4(page)
        }, later=true)
        |> ignore
      }


