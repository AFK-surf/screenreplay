import "mbt_compat"

// The size a picture is shown at, read from the sequence parameter set in a track's decoder record: the coded size
// less the SPS's cropping (the recorder's 4K is coded 3840x2176, its conformance window taking 16 rows off the
// foot). What the player's picture is laid out by (`picture_aspect`); nothing else of the SPS is used.

/// Bits of a NAL unit's payload, its emulation prevention bytes (00 00 03) taken out.
pub struct Bits {
  b : Array[Int]
  mut at : Int
}

fn Bits::of(nal : Bytes) -> Bits {
  let b = []
  let mut zeros = 0
  let mut idx = 0
  while idx < nal.length() {
    let v = nal[idx].to_int()
    idx += 1
    if zeros >= 2 && v == 3 {
      zeros = 0
      continue
    }
    zeros = if v == 0 { zeros + 1 } else { 0 }
    b.push(v)
  }
  Bits::{ b: b, at: 0 }}

/// One bit; 0 past the end (a reader that runs off says so by `over`).
fn Bits::bit(self : Bits) -> Int {
  let i = self.at >> 3
  let v = if i < self.b.length() {
    (self.b[i] >> (7 - (self.at & 7))) & 1
  } else {
    0
  }
  self.at = self.at + 1
  v}

fn Bits::over(self : Bits) -> Bool {
  self.at > self.b.length() * 8}

fn Bits::u(self : Bits, n : Int) -> Int {
  let mut v = 0
  for _ in 0..<n {
    v = (v << 1) | self.bit()
  }
  v}

fn Bits::skip(self : Bits, n : Int) -> Unit {
  self.at = self.at + n}

/// Exp-Golomb, unsigned.
fn Bits::ue(self : Bits) -> Int {
  let mut zeros = 0
  while self.bit() == 0 && zeros < 32 {
    zeros = zeros + 1
  }
  if zeros >= 31 {
    self.at = self.b.length() * 8 + 1
    return 0
  }
  (1 << zeros) - 1 + self.u(zeros)}

fn Bits::se(self : Bits) -> Int {
  let k = self.ue()
  if k % 2 == 1 {
    (k + 1) / 2
  } else {
    -(k / 2)
  }}

/// The shown size for a sample entry's codec and its record (hvcC, avcC); None where it has no SPS or one not read.
fn sps_shown(codec : String, config : Bytes) -> Option[(Int, Int)] {
  if codec.starts_with("hv") || codec.starts_with("he") {
    match hvcc_sps(config) {
      Option::Some(nal) => hevc_sps_shown(nal)
      Option::None => Option::None
    }
  } else if codec.starts_with("avc") {
    match avcc_sps(config) {
      Option::Some(nal) => avc_sps_shown(nal)
      Option::None => Option::None
    }
  } else {
    Option::None
  }}

/// hvcC's first SPS (NAL type 33).
fn hvcc_sps(c : Bytes) -> Option[Bytes] {
  guard c.length() >= 23 else { return Option::None }
  let arrays = c[22].to_int()
  let mut i = 23
  for _ in 0..<arrays {
    guard i + 3 <= c.length() else { return Option::None }
    let kind = c[i].to_int() & 0x3f
    let n = be16(c, i + 1)
    i = i + 3
    for _ in 0..<n {
      guard i + 2 <= c.length() else { return Option::None }
      let len = be16(c, i)
      guard i + 2 + len <= c.length() else { return Option::None }
      if kind == 33 {
        return Option::Some(bytes_slice(c, i + 2, i + 2 + len))
      }
      i = i + 2 + len
    }
  }
  Option::None}

/// avcC's first SPS.
fn avcc_sps(c : Bytes) -> Option[Bytes] {
  guard c.length() >= 8 && (c[5].to_int() & 0x1f) > 0 else { return Option::None }
  let len = be16(c, 6)
  guard 8 + len <= c.length() else { return Option::None }
  Option::Some(bytes_slice(c, 8, 8 + len))}

/// The crop's units: chroma's sampling across and down (4:2:0 2 and 2, 4:2:2 2 and 1, 4:4:4 and none 1 and 1).
fn crop_units(chroma : Int) -> (Int, Int) {
  match chroma {
    1 => (2, 2)
    2 => (2, 1)
    _ => (1, 1)
  }}

fn hevc_sps_shown(nal : Bytes) -> Option[(Int, Int)] {
  let r = Bits::of(nal)
  r.skip(16) // the NAL's head
  r.skip(4) // its VPS
  let sub = r.u(3)
  r.skip(1)
  // profile_tier_level: the general part, then each sub-layer's said present
  r.skip(88)
  r.skip(8)
  let profile = Array::make(sub, false)
  let level = Array::make(sub, false)
  for i in 0..<sub {
    profile[i] = r.bit() == 1
    level[i] = r.bit() == 1
  }
  if sub > 0 {
    r.skip(2 * (8 - sub))
  }
  for i in 0..<sub {
    if profile[i] {
      r.skip(88)
    }
    if level[i] {
      r.skip(8)
    }
  }
  r.ue() |> ignore // its id
  let chroma = r.ue()
  if chroma == 3 {
    r.skip(1)
  }
  let w = r.ue()
  let h = r.ue()
  let (ux, uy) = crop_units(chroma)
  let (l, rt, t, bm) = if r.bit() == 1 {
    (r.ue(), r.ue(), r.ue(), r.ue())
  } else {
    (0, 0, 0, 0)
  }
  let sw = w - ux * (l + rt)
  let sh = h - uy * (t + bm)
  if r.over() || sw <= 0 || sh <= 0 {
    Option::None
  } else {
    Option::Some((sw, sh))
  }}

fn avc_sps_shown(nal : Bytes) -> Option[(Int, Int)] {
  let r = Bits::of(nal)
  r.skip(8) // the NAL's head
  let profile = r.u(8)
  r.skip(16)
  r.ue() |> ignore // its id
  let mut chroma = 1
  if [100, 110, 122, 244, 44, 83, 86, 118, 128, 138, 139, 134, 135].contains(
      profile,
    ) {
    chroma = r.ue()
    if chroma == 3 {
      r.skip(1)
    }
    r.ue() |> ignore
    r.ue() |> ignore
    r.skip(1)
    if r.bit() == 1 {
      // scaling matrices: each list said present skipped by its deltas
      let lists = if chroma == 3 { 12 } else { 8 }
      for i in 0..<lists {
        if r.bit() == 1 {
          let size = if i < 6 { 16 } else { 64 }
          let mut last = 8
          let mut next = 8
          for _ in 0..<size {
            if next != 0 {
              next = (last + r.se() + 256) % 256
            }
            last = if next == 0 { last } else { next }
          }
        }
      }
    }
  }
  r.ue() |> ignore // log2 max frame num
  let poc = r.ue()
  if poc == 0 {
    r.ue() |> ignore
  } else if poc == 1 {
    r.skip(1)
    r.se() |> ignore
    r.se() |> ignore
    let n = r.ue()
    for _ in 0..<n {
      r.se() |> ignore
    }
  }
  r.ue() |> ignore // reference frames
  r.skip(1)
  let w = (r.ue() + 1) * 16
  let maps = r.ue() + 1
  let frames_only = r.bit()
  let h = maps * 16 * (2 - frames_only)
  if frames_only == 0 {
    r.skip(1)
  }
  r.skip(1)
  let (ux0, uy0) = crop_units(chroma)
  let (ux, uy) = if chroma == 0 { (1, 2 - frames_only) } else { (ux0, uy0 * (2 - frames_only)) }
  let (l, rt, t, bm) = if r.bit() == 1 {
    (r.ue(), r.ue(), r.ue(), r.ue())
  } else {
    (0, 0, 0, 0)
  }
  let sw = w - ux * (l + rt)
  let sh = h - uy * (t + bm)
  if r.over() || sw <= 0 || sh <= 0 {
    Option::None
  } else {
    Option::Some((sw, sh))
  }}
