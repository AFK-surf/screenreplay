import "headless"
import "mbt_compat"
import "motion"
import "signals"
import "ui"
import "view"
import "hostapi"

fn formats() -> Array[Int] {
  if av1_saved_here() {
    [0, 1, 2, 3]
  } else {
    [0, 1, 3]
  }}

fn format() -> Int {
  let f = export_format.get()
  if mode() == 1 || (f == 2 && !av1_saved_here()) {
    0
  } else {
    f
  }}

// Require both GPU AV1 encode and system AV1 decode so saved clips can play back here.
fn av1_saved_here() -> Bool {
  rp_av1_here() == 1 && hostapi::av1_here()}

fn format_label(f : Int) -> String {
  ["H.264", "H.265", "AV1", "GIF"][f]}

fn codec_factor(codec : Int) -> Double {
  match codec {
    1 => 1.0 / 1.5
    2 => 1.0 / 1.5 * 0.75
    _ => 1.0
  }}

fn gif_scale(w : Double) -> Double {
  if w > 960.0 {
    960.0 / w
  } else {
    1.0
  }}

// Marks an export/concat in progress for the recorder so it does not recycle the hidden resident window mid-export.
fn set_export_busy(on : Bool) -> Unit {
  let path = cstr(pjoin(root_dir(), "export.busy"))
  if on {
    rp_write(path, mbt_compat::utf8_encode("1")) |> ignore
  } else {
    rp_delete(path)
  }}

fn source_format() -> (Double, Double, Int) {
  let info = recording_info()
  picture_aspect.get() |> ignore
  let (pw, ph) = match native().track {
    Some(t) => (t.shown_w.to_double(), t.shown_h.to_double())
    None => (0.0, 0.0)
  }
  let w = if pw > 0.0 { pw } else if info.width > 0 { info.width.to_double() } else { 1920.0 }
  let h = if ph > 0.0 { ph } else if info.height > 0 { info.height.to_double() } else { 1080.0 }
  let fps = match seg_at(t0() + clip_a.get()) {
    Option::Some(i) if segs[i].fps > 0 => fps_of(segs[i].fps.to_double())
    _ => fps_of(sets().fps.to_double())
  }
  (w, h, fps)}

fn clip_codecs() -> Array[String] {
  let (a, b) = (clip_a.get(), clip_b.get())
  let base = t0()
  let out : Array[String] = []
  for s in segs {
    let from = s.start - base
    if from + s.dur <= a || from >= b {
      continue
    }
    let name = match seg_codecs.get(s.path) {
      Option::Some(n) => n
      Option::None => {
        let n = codec_name(mp4_video_codec(s.path))
        if n != "" {
          seg_codecs.set(s.path, n)
        }
        n
      }
    }
    if name != "" && !out.contains(name) {
      out.push(name)
    }
  }
  if out.is_empty() {
    out.push(if recording_info().codec == "H264" || sets().codec == "h264" { "H.264" } else { "H.265" })
  }
  out}

// Matches recorder's recording/Bitrate.cs high-quality H.264 bitrate formula.
fn h264_estimate(w : Double, h : Double, fps : Int) -> Double {
  let megapixels = dmax(2.0, w) * dmax(2.0, h) / 1000000.0
  let rate = 3000000.0 *
    mbt_compat::math_pow(megapixels, 0.8) *
    mbt_compat::math_pow(imax(1, fps).to_double() / 30.0, 0.6) *
    1.5
  dmin(150000000.0, dmax(1000000.0, rate))}

fn mode() -> Int {
  if cropping() && export_mode.get() == 0 {
    2
  } else {
    export_mode.get()
  }}

// Clamp H.264 fps to Level 5.2 max (2,073,600 macroblocks/s) to avoid MF_E_INVALIDMEDIATYPE.
fn h264_fps(codec : Int, w : Int, h : Int, fps : Int) -> Int {
  if codec != 0 {
    return fps
  }
  let blocks = ((w + 15) / 16) * ((h + 15) / 16)
  if blocks <= 0 {
    return fps
  }
  let most = 2073600 / blocks
  if fps <= most {
    fps
  } else if most >= 90 {
    90
  } else if most >= 60 {
    60
  } else {
    30
  }}

fn export_plan() -> (Int, Int, Int, Double, Int) {
  let (sw, sh, sfps) = source_format()
  let secs = dmax(1.0, clip_kept() / 1000.0)
  let quality = [0.5, 0.75, 1.0][export_quality.get()]
  let codec = format()
  if codec == 3 {
    let (bw, bh) = if cropping() {
      let (_, cw, ch) = crop_now(sw, sh)
      (cw.to_double(), ch.to_double())
    } else {
      (sw, sh)
    }
    let k = gif_scale(bw)
    return (even(bw * k), even(bh * k), imin(gif_fps.get(), sfps), 0.0, 3)
  }
  if cropping() {
    let (_, cw, ch) = crop_now(sw, sh)
    let fps = if mode() == 1 {
      sfps
    } else if export_fps.get() > 0 {
      imin(export_fps.get(), sfps)
    } else {
      sfps
    }
    let rate = if mode() == 1 {
      dmin(h264_estimate(cw.to_double(), ch.to_double(), fps), dmax(250000.0, size_choices[export_size.get()] * 1048576.0 * 8.0 * 0.95 / secs - 128000.0))
    } else {
      h264_estimate(cw.to_double(), ch.to_double(), fps) * quality * codec_factor(codec)
    }
    let fps = h264_fps(codec, cw, ch, fps)
    return (cw, ch, fps, rate, codec)
  }
  if export_mode.get() == 1 {
    let fps = sfps
    let target = dmax(250000.0, size_choices[export_size.get()] * 1048576.0 * 8.0 * 0.95 / secs - 128000.0)
    let mut h = 480.0
    for cand in [sh, 1440.0, 1080.0, 720.0] {
      if cand <= sh && target / (sw * cand / sh * cand * fps.to_double()) >= 0.04 {
        h = cand
        break
      }
    }
    h = dmin(h, sh)
    let fps = h264_fps(0, even(sw * h / sh), even(h), fps)
    let rate = dmin(target, h264_estimate(sw * h / sh, h, fps))
    (even(sw * h / sh), even(h), fps, rate, 0)
  } else {
    let h = if export_height.get() > 0 && export_height.get().to_double() < sh {
      export_height.get().to_double()
    } else {
      sh
    }
    let fps = if export_fps.get() > 0 { imin(export_fps.get(), sfps) } else { sfps }
    let fps = h264_fps(codec, even(sw * h / sh), even(h), fps)
    let w = sw * h / sh
    let rate = h264_estimate(w, h, fps) * quality * codec_factor(codec)
    (even(w), even(h), fps, rate, codec)
  }}

fn crop_now(sw : Double, sh : Double) -> (String, Int, Int) {
  match region_on() {
    Option::Some(r) => region_crop(r)
    Option::None => crop_plan(sw, sh)
  }}

// Decode full-res crop preview in background (384px index thumbs blur when cropped).
fn crop_thumb_key() -> Option[String] {
  crop_thumb_rev.get() |> ignore
  let (sw, sh) = rec_size()
  let (plan, _, _) = crop_now(sw, sh)
  let lines = plan.split("\n")
  let first = if lines.length() > 0 { lines[0] } else { "" }
  let parts = first.split("\t")
  guard parts.length() == 5 else { return Option::None }
  let num = fn(i : Int) {
    let j : Option[mbt_compat::MbtJson] = match mbt_compat::mbt_json_parse(parts[i]) { Ok(__mbt_ok_20) => Some(__mbt_ok_20), Err(_) => Option::None }
    match j {
      Option::Some(mbt_compat::MbtJson::Number(n, _)) => n.round().to_int()
      _ => 0
    }
  }
  let (x, y, w, h) = (num(1), num(2), num(3), num(4))
  guard w > 0 && h > 0 else { return Option::None }
  let at = clip_a.get()
  guard seg_at(t0() + at) is Option::Some(i) else { return Option::None }
  let s = segs[i]
  let inside = t0() + at - s.start
  let identity = "\{s.path}|\{inside}|\{x},\{y},\{w},\{h}"
  let key = "mem:crop-" + identity
  if ui::image_bytes_for(key).is_some() {
    return Option::Some(key)
  }
  let bmp = rp_crop_thumb(cstr(s.path), cstr(identity), inside, x, y, w, h)
  if bmp.length() > 1 {
    ui::add_image(key, bmp)
    crop_images.keep(key)
    Option::Some(key)
  } else {
    if bmp.length() == 1 && bmp[0].to_int() == 0 && !crop_thumb_due.v {
      // [0] means background render in flight; schedule one 50 ms re-check.
      match the_root.v {
        Some(r) => {
          crop_thumb_due.v = true
          r.at_moment(now() + 50.0, fn() {
            crop_thumb_due.v = false
            crop_thumb_rev.set(crop_thumb_rev.untracked() + 1)
          })
          |> ignore
        }
        None => ()
      }
    }
    Option::None
  }}

fn export_bytes() -> Double {
  let (a, b) = (clip_a.get(), clip_b.get())
  let secs = (b - a) / 1000.0
  if mode() == 0 {
    data()
    let base = t0()
    let mut bytes = 0.0
    for s in segs {
      let from = s.start - base
      let x = dmax(from, a)
      let y = dmin(from + s.dur, b)
      if y > x && s.dur > 0.0 {
        bytes += s.size * (y - x) / s.dur
      }
    }
    bytes
  } else if format() == 3 {
    gif_estimate.get()
  } else {
    let (_, _, _, rate, codec) = export_plan()
    let bytes = (rate + 128000.0) * secs / 8.0
    // H.264/H.265 VBR overshoots target bitrate by ~3% on busy frames (AV1 caps via QP), so pad estimate by 5%.
    if codec == 2 {
      bytes
    } else {
      bytes * 1.05
    }
  }}

fn size_text() -> String {
  let bytes = export_bytes()
  if bytes == -1.0 {
    t("估算中…")
  } else if bytes < 0.0 {
    "—"
  } else {
    tf("约 {0}", [bytes_text(bytes)])
  }}

fn gif_estimate_key() -> String {
  if !clipping.get() || mode() != 2 || format() != 3 {
    return ""
  }
  let (w, h, fps, _, _) = export_plan()
  let (crops, scale) = gif_crops()
  "\{w}x\{h}@\{fps} \{scale}\n\{crops}\n" + clip_plan(clip_a.get(), clip_b.get())}

fn gif_crops() -> (String, Double) {
  if cropping() {
    let (sw, sh, _) = source_format()
    let (c, cw, _) = crop_now(sw, sh)
    (c, gif_scale(cw.to_double()))
  } else {
    ("", 1.0)
  }}

fn keep_gif_estimate(root : view::View) -> Unit {
  root.reacts(gif_estimate_key, fn(key) {
    match gif_estimate_due.v {
      Some(stop) => stop()
      None => ()
    }
    gif_estimate_due.v = None
    if key == "" {
      return
    }
    gif_estimate.set(-1.0)
    // Debounce 600 ms while dialog is closed so timeline handle drags don't spam expensive GIF sampling.
    let wait = if export_open.untracked() { 0.0 } else { 600.0 }
    gif_estimate_due.v = Some(
      root.at_moment(now() + wait, fn() {
        gif_estimate_due.v = None
        if signals::untracked(gif_estimate_key) != key {
          return
        }
        let (w, h, fps, _, _) = signals::untracked(export_plan)
        let (crops, scale) = signals::untracked(gif_crops)
        rp_gif_estimate_start(cstr(clip_plan(clip_a.untracked(), clip_b.untracked())), w, h, fps, cstr(crops), scale)
        follow_gif_estimate(root, key)
      }),
    )
  })}

fn follow_gif_estimate(root : view::View, key : String) -> Unit {
  if signals::untracked(gif_estimate_key) != key {
    return
  }
  let v = rp_gif_estimate()
  if v == -1.0 {
    root.at_moment(now() + 100.0, fn() { follow_gif_estimate(root, key) }) |> ignore
  } else {
    gif_estimate.set(v)
  }}

fn clip_spans(a : Double, b : Double) -> Array[(Double, Double)] {
  match axis() {
    Option::None => [(a, b)]
    Option::Some(ax) => {
      let out : Array[(Double, Double)] = []
      for k in ax.ks {
        let s = dmax(a, k.0)
        let e = dmin(b, k.1)
        if e > s {
          out.push((s, e))
        }
      }
      if out.is_empty() {
        [(a, b)]
      } else {
        out
      }
    }
  }}

fn clip_kept() -> Double {
  let mut n = 0.0
  for s in clip_spans(clip_a.get(), clip_b.get()) {
    n += s.1 - s.0
  }
  n}

// Format for rp_concat/rp_export_start: "path\toffsetMs\ttrimStartMs\tendMs" per line.
// Offset includes first_trim (first line offset = 0) so downstream trim/concat timestamps align.
fn clip_plan(a : Double, b : Double) -> String {
  let base = t0()
  let lines : Array[String] = []
  let mut first_trim = 0.0
  let mut out = 0.0
  for sp in signals::untracked(fn() { clip_spans(a, b) }) {
    let (sa, sb) = sp
    let mut origin : Option[Double] = Option::None
    let mut reach = out
    for s in segs {
      let from = s.start - base
      let to = from + s.dur
      if to <= sa || from >= sb {
        continue
      }
      let trim = dmax(0.0, sa - from)
      let end = dmin(s.dur, sb - from)
      if end <= trim {
        continue
      }
      let o = match origin {
        Option::Some(o) => o
        Option::None => {
          origin = Some(from + trim)
          from + trim
        }
      }
      let at = out + (from + trim - o)
      if lines.is_empty() {
        first_trim = trim
        lines.push("\{s.path}\t0\t\{trim}\t\{end}")
      } else {
        lines.push("\{s.path}\t\{at + first_trim}\t\{trim}\t\{end}")
      }
      reach = dmax(reach, at + (end - trim))
    }
    out = reach
  }
  lines.join("\n")}

fn new_clip_path(ext? : String) -> String {
  let ext = match ext { Some(__mbt_v) => __mbt_v, None => ".mp4" }

  let dir = clips_dir()
  rp_mkdirs(cstr(dir)) |> ignore
  let base = pjoin(dir, (if signals::untracked(is_english) { "Replay " } else { "回放 " }) + stamp(t0() + clip_a.untracked()))
  let mut path = base + ext
  let mut n = 2
  while rp_size(cstr(path)) > 0.0 || rp_size(cstr(path + ".partial" + ext)) > 0.0 {
    path = base + " (\{n})" + ext
    n += 1
  }
  path}

fn save_clip(copy? : Bool) -> Unit {
  let copy = match copy { Some(__mbt_v) => __mbt_v, None => false }

  if export_out.untracked() != "" {
    return
  }
  let out = new_clip_path()
  let partial = out + ".partial.mp4"
  set_playing(false)
  let (a, b) = (clip_a.untracked(), clip_b.untracked())
  if rp_concat_start(cstr(clip_plan(a, b)), cstr(partial)) == 0 {
    return
  }
  export_out.set(out)
  set_export_busy(true)
  export_copy.v = copy
  export_done.set(0.0)
  export_error.set("")
  if !export_open.untracked() {
    saved.set(t("正在保存…"))
    saved_path.set("")
  }
  follow_concat(out, partial, b - a)}

fn follow_concat(out : String, partial : String, len : Double) -> Unit {
  match rp_concat_state() {
    2 => {
      let mut r = rp_concat_take()
      let cancelled = r == -2147467260 // E_ABORT
      if r == 0 && rp_rename(cstr(partial), cstr(out)) != 1 {
        r = -2000
      }
      if r != 0 {
        rp_delete(cstr(partial))
      }
      export_out.set("")
      set_export_busy(false)
      if r == 0 {
        let copied = export_copy.v && rp_copy_file(cstr(out)) == 1
        saved.set(tf(if copied { "已保存并复制 {0} 的片段" } else { "已保存 {0} 的片段" }, [clock(len)]))
        saved_path.set(out)
        export_open.set(false)
        clipping.set(false)
      } else if !cancelled {
        if export_open.untracked() {
          export_error.set(tf("没能保存（{0}）", [r.to_string()]))
        } else {
          saved.set(tf("没能保存（{0}）", [r.to_string()]))
          saved_path.set("")
        }
      }
      hostapi::log("REPLAY save \{r} \{out}")
    }
    _ => {
      export_done.set(rp_concat_progress())
      match the_root.v {
        Some(root) => root.at_moment(now() + 100.0, fn() { follow_concat(out, partial, len) }) |> ignore
        None => ()
      }
    }
  }}

fn open_export() -> Unit {
  if !clipping.untracked() {
    start_clip()
  }
  set_playing(false)
  export_error.set("")
  export_open.set(true)}

fn export_now(copy : Bool) -> Unit {
  if export_out.untracked() != "" {
    return
  }
  if signals::untracked(mode) == 0 {
    save_clip(copy=copy)
    return
  }
  let (w, h, fps, rate, codec) = signals::untracked(export_plan)
  let out = new_clip_path(ext=if codec == 3 { ".gif" } else { ".mp4" })
  let (sw, sh, _) = signals::untracked(source_format)
  let (crops, cw) = if signals::untracked(cropping) {
    signals::untracked(fn() {
      let (c, cw, _) = crop_now(sw, sh)
      (c, cw)
    })
  } else {
    ("", 0)
  }
  // For cropped GIFs, scale the source frame first so the cropped region matches target GIF width.
  let scale = if codec == 3 && cw > 0 { gif_scale(cw.to_double()) } else { 1.0 }
  let plan = clip_plan(clip_a.untracked(), clip_b.untracked())
  let r = rp_export_start(cstr(plan), cstr(out), w, h, fps, rate.to_int(), codec, cstr(crops), scale)
  let said = crops.replace("\t", ",").replace("\n", ";")
  hostapi::log("REPLAY export \{r} \{format_label(codec)} \{w}x\{h}@\{fps} rate=\{rate.to_int()} est=\{signals::untracked(export_bytes).to_int()} crops=\{said} \{out}")
  if r == 0 {
    export_out.set(out)
    set_export_busy(true)
    export_copy.v = copy
    export_error.set("")
    export_done.set(0.0)
    match the_root.v {
      Some(root) => follow_export(root)
      None => ()
    }
  } else {
    export_error.set(tf("没能开始保存（{0}）", [r.to_string()]))
  }}

fn follow_export(root : view::View) -> Unit {
  let out = export_out.untracked()
  if out == "" {
    return
  }
  match rp_export_state() {
    1 => {
      export_done.set(rp_export_progress())
      root.at_moment(now() + 100.0, fn() { follow_export(root) }) |> ignore
    }
    2 => {
      let copied = export_copy.v && rp_copy_file(cstr(out)) == 1
      let len = signals::untracked(clip_kept)
      saved.set(
        tf(if copied { "已保存并复制 {0} 的片段" } else { "已保存 {0} 的片段" }, [
          clock(len),
        ]),
      )
      saved_path.set(out)
      export_out.set("")
      set_export_busy(false)
      export_open.set(false)
      clipping.set(false)
      rp_export_reset()
    }
    -2 => {
      export_out.set("")
      set_export_busy(false)
      rp_export_reset()
    }
    -1 => {
      export_error.set(tf("保存失败（{0}）", ["0x" + rp_export_failure().reinterpret_as_uint().to_string(radix=16)]))
      export_out.set("")
      set_export_busy(false)
      rp_export_reset()
    }
    _ => root.at_moment(now() + 100.0, fn() { follow_export(root) }) |> ignore
  }}

fn gif_too_big() -> Bool {
  format() == 3 && export_bytes() >= 0.0 && (clip_kept() > 20000.0 || export_bytes() > 25.0 * 1048576.0)}

fn format_hint(f : Int) -> String {
  match f {
    1 => t("比 H.264 小，但部分电脑、聊天软件和网页可能播不了")
    2 => t("比 H.265 还小，但部分电脑、聊天软件和网页可能播不了")
    3 => t("没有声音的动图，最宽 960；适合几秒钟的短片段")
    _ => t("哪里都能播")
  }}

fn segmented(parent : view::View, labels : () -> Array[String], chosen : () -> Int, choose : (Int) -> Unit) -> Unit {
  let col = fn() {
    arr_fold(labels(), 48.0, fn(m, l) { dmax(m, sf_node_words_w(l, 12.0, weight=500).ceil() + 20.0) })
  }
  // Wrap in a row so parent cross-axis stretch does not widen the track beyond its options.
  parent.box(fn(line) { line.row(view::Live::Is(true)) |> ignore ; segmented_track(line, labels, chosen, choose, col) }) |> ignore}

// Guard out-of-range index when option count shrinks before each() unmounts the cell.
fn label_at(labels : () -> Array[String], i : Int) -> String {
  let ls = labels()
  if i < ls.length() {
    ls[i]
  } else {
    ""
  }}

fn segmented_track(parent : view::View, labels : () -> Array[String], chosen : () -> Int, choose : (Int) -> Unit, col : () -> Double) -> Unit {
  parent.box(fn(track) {
    track.row(view::Live::Is(true)).pad(view::Live::Is(2.0)).radius(view::Live::Is(7.0)).ground(view::Live::By(fn() { tone(c_bg(), c_s2()) })) |> ignore
    let slide = motion::NodeWay::new(signals::untracked(chosen).to_double())
    track.reacts(chosen, fn(i) {
      slide.go_ms(track, i.to_double(), if motion_off() { 1.0 } else { 180.0 })
    })
    track.box(fn(o) {
      o.over(view::Live::Is(true)).padding(view::Live::Is((2.0, 2.0, 2.0, 2.0))).lines_up(view::Live::Is(Some(view::Along::Start))) |> ignore
      o.box(fn(g) {
        g
        .height(view::Live::Is(Some(24.0)))
        .radius(view::Live::Is(5.0))
        .ground(view::Live::By(fn() { tone(c_s4(), 0xFFFFFFFFL) }))
        .shadow(view::Live::By(fn() { if is_dark() { (0.0, 0.0, 0L) } else { (2.0, 1.0, 0x1112142EL) } }))
        .width(view::Live::By(fn() { Some(col()) }))
        .offset(view::Live::By(fn() { (slide.shown(g) * col(), 0.0) }))
        |> ignore
      })
      |> ignore
    })
    |> ignore
    track.each(fn() { mbt_compat::arr_makei(labels().length(), fn(i) { i }) }, fn(i : Int) -> Int { i }, fn(cell, i) {
      let i = i.untracked()
      pressable(cell, fn() { label_at(labels, i) }, fn() { choose(i) }, fn(b) {
        b
        .height(view::Live::Is(Some(24.0)))
        .width(view::Live::By(fn() { Some(col()) }))
        .radius(view::Live::Is(5.0))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Middle))
        .cursor(view::Live::Is(Some(view::Cursor::Arrow)))
        .edge(view::Live::By(fn() { if b.focus_shown() { (1.5, focus_ring()) } else { (0.0, 0L) } }))
        .ground(view::Live::By(fn() { if chosen() != i && b.pointed() { tone(c_s2(), c_s3()) } else { 0L } }))
        |> ignore
        b.box(fn(w) {
          w
          .words(view::Live::By(fn() { label_at(labels, i) }), look={ ..view::words_plain, size: 12.0, weight: 500, line: 17.0, wrap: false })
          .ink(view::Live::By(fn() { if chosen() == i { ui_text() } else { ui_muted() } }))
          |> ignore
        })
        |> ignore
      })
      |> ignore
    }, at_once=true)
  })
  |> ignore}

fn setting_row(parent : view::View, first : Bool, title : () -> String, note : () -> String, control : (view::View) -> Unit, note_ink? : () -> Int64) -> Unit {
  let note_ink = match note_ink { Some(__mbt_v) => __mbt_v, None => ui_subtle }
  if !first {
    rule(parent, hair)
  }
  parent.box(fn(r) {
    r.row(view::Live::Is(true)).min_height(view::Live::Is(Some(52.0))).padding(view::Live::Is((14.0, 8.0, 14.0, 8.0))).gap(view::Live::Is(16.0)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
    r.box(fn(l) {
      l.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(1.0)) |> ignore
      words(l, title, 13.0, ui_text, weight=500).min_width(view::Live::Is(Some(0.0))).allow_ellipsis(view::Live::Is(true)) |> ignore
      l.show(fn() { note() != "" }, fn(n) {
        n.box(fn(w) {
          w.words(view::Live::By(note), look={ ..view::words_plain, size: 12.0, line: 17.0, wrap: true }).ink(view::Live::By(note_ink)) |> ignore
        })
        |> ignore
      }, at_once=true)
    })
    |> ignore
    control(r)
  })
  |> ignore}

fn format_row(parent : view::View, note : () -> String, control : (view::View) -> Unit) -> Unit {
  parent.box(fn(r) {
    r.padding(view::Live::Is((14.0, 10.0, 14.0, 10.0))).gap(view::Live::Is(4.0)) |> ignore
    r.box(fn(top) {
      top.row(view::Live::Is(true)).gap(view::Live::Is(16.0)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
      top.box(fn(l) {
        l.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))) |> ignore
        words(l, fn() { t("格式") }, 13.0, ui_text, weight=500) |> ignore
      })
      |> ignore
      control(top)
    })
    |> ignore
    r.box(fn(w) { w.words(view::Live::By(note), look={ ..view::words_plain, size: 12.0, line: 17.0, wrap: true }).ink(view::Live::By(ui_subtle)) |> ignore })
    |> ignore
  })
  |> ignore}

fn sheet(root : view::View, open : () -> Bool, close : () -> Unit, w : Double, body : (view::View) -> Unit, can_close? : () -> Bool, h? : Double, bare? : Bool, keys? : Array[String], over? : (view::View) -> Unit) -> Unit {
  let can_close = match can_close { Some(__mbt_v) => __mbt_v, None => fn() { true } }
  let h = match h { Some(__mbt_v) => __mbt_v, None => 0.0 }
  let bare = match bare { Some(__mbt_v) => __mbt_v, None => false }
  let keys = match keys { Some(__mbt_v) => __mbt_v, None => ["escape"] }
  let over = match over { Some(__mbt_v) => __mbt_v, None => fn(_) {  } }

  root.box(fn(layer) {
    layer.over(view::Live::Is(true)).over_all(view::Live::Is(true)) |> ignore
    let way = motion::NodeWay::new(0.0)
    layer.reacts(open, fn(on) {
      way.go_ms(layer, if on { 1.0 } else { 0.0 }, if motion_off() { 1.0 } else if on { 140.0 } else { 120.0 })
    })
    layer.show(fn() { open() || way.shown(layer) > 0.0 }, fn(s) {
      s
      .over(view::Live::Is(true))
      .modal(view::Live::By(open))
      .presses(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .ground(view::Live::By(fn() { mix(clear(scrim_ground()), scrim_ground(), way.shown(s)) }))
      .on_press(fn() { if signals::untracked(can_close) { close() } })
      |> ignore
      layer_keys(s, keys)
      s.box(fn(card) {
        card
        .width(view::Live::Is(Some(w)))
        .ground(view::Live::By(c_s1))
        .edge(view::Live::By(fn() { (1.0, hair2()) }))
        .radius(view::Live::Is(12.0))
        .padding(view::Live::Is(if bare { (0.0, 0.0, 0.0, 0.0) } else { (24.0, 20.0, 24.0, 20.0) }))
        .gap(view::Live::Is(if bare { 0.0 } else { 12.0 }))
        .height(view::Live::Is(if h > 0.0 { Some(h) } else { None }))
        .clips(view::Live::Is(bare))
        .presses(view::Live::Is(true))
        .on_press(fn() {  })
        .shadow(view::Live::By(fn() { (60.0, 20.0, sheet_shadow()) }))
        .alpha(view::Live::By(fn() { way.shown(card) }))
        .scale(view::Live::By(fn() { if motion_off() { 1.0 } else { 0.97 + 0.03 * way.shown(card) } }))
        |> ignore
        body(card)
      })
      |> ignore
      over(s)
    }, at_once=true)
  })
  |> ignore}

fn export_fact(parent : view::View, name : () -> String, value : () -> String) -> Unit {
  parent.box(fn(f) {
    f.gap(view::Live::Is(3.0)) |> ignore
    words(f, name, 12.0, ui_subtle) |> ignore
    words(f, value, 15.0, ui_text, weight=600) |> ignore
  })
  |> ignore}

fn export_dialog(root : view::View) -> Unit {
  let running = fn() { export_out.get() != "" }
  keep_gif_estimate(root)

  sheet(root, fn() { export_open.get() }, fn() { export_open.set(false) }, 560.0, can_close=fn() { !running() }, keys=[
    "escape", "save", "save-copy",
  ], fn(card) {
    card.box(fn(head) {
      head.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
      words(head, fn() { t("保存片段") }, 15.0, ui_text, weight=600) |> ignore
      spring(head)
      head.show(fn() { !running() }, fn(b) {
        icon_button(b, fn() { "close" }, fn() { t("关闭") }, fn() { export_open.set(false) }, size=12.0) |> ignore
      }, at_once=true)
    })
    |> ignore
    card.box(fn(info) {
      info
      .row(view::Live::Is(true))
      .pad(view::Live::Is(10.0))
      .gap(view::Live::Is(16.0))
      .radius(view::Live::Is(10.0))
      .ground(view::Live::By(fn() { tone(c_s2(), 0xF4F5F7FFL) }))
      .edge(view::Live::By(fn() { if is_dark() { (0.0, 0L) } else { (1.0, 0x00000014L) } }))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      |> ignore
      info.box(fn(pic) {
        pic
        .width(view::Live::Is(Some(160.0)))
        .height(view::Live::Is(Some(90.0)))
        .radius(view::Live::Is(6.0))
        .clips(view::Live::Is(true))
        .ground(view::Live::Is(picture_ground))
        |> ignore
        // Inner square box prevents rounded corners from applying to letterboxed crops narrower than the frame.
        pic.box(fn(img) {
          img
          .width(view::Live::Is(Some(160.0)))
          .height(view::Live::Is(Some(90.0)))
          .image(view::Live::By(fn() {
            data()
            idx_tick.get() |> ignore
            if cropping() {
              return opt_map(crop_thumb_key(), fn(k) { (k, "", 400) })
            }
            let k = thumb_key(clip_a.get())
            if k == "" {
              None
            } else {
              Some((k, "", 400))
            }
          }))
          .image_contains(view::Live::Is(true))
          |> ignore
        })
        |> ignore
      })
      |> ignore
      info.box(fn(facts) {
        facts.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(10.0)) |> ignore
        facts.box(fn(r) {
          r.row(view::Live::Is(true)).gap(view::Live::Is(28.0)) |> ignore
          export_fact(r, fn() { t("时长") }, fn() { clock(clip_kept()) })
          export_fact(r, fn() { t("大小") }, size_text)
        })
        |> ignore
        words(facts, fn() {
            let (sw, sh, sfps) = source_format()
            let recorded_codec = clip_codecs().join(" + ")
            if mode() == 0 {
              "\{sw.to_int()}×\{sh.to_int()} · \{sfps} fps · \{recorded_codec} · " + t("不重新编码")
            } else {
              let (w, h, fps, _, codec) = export_plan()
              "\{w}×\{h} · \{fps} fps · " + format_label(codec) + " · " + (if codec == 3 { t("没有声音") } else { t("重新编码") })
            }
          }, 12.0, ui_muted)
        .min_width(view::Live::Is(Some(0.0)))
        .allow_ellipsis(view::Live::Is(true))
        |> ignore
        // Use laid_nowhere instead of show() so flex shrinking/ellipsis works inside the card.
        facts.box(fn(r) {
          r
          .row(view::Live::Is(true))
          .gap(view::Live::Is(7.0))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .min_width(view::Live::Is(Some(0.0)))
          .laid_nowhere(view::Live::By(fn() { picked_hwnd.get() == 0L }))
          |> ignore
          r.pick(fn() { picked_process.get() }, fn(i, p) { app_icon(i, p) }, at_once=true)
          words(r, fn() { tf("只导出 {0}", [picked_name.get()]) }, 12.0, ui_text)
          .shrink(view::Live::Is(1.0))
          .min_width(view::Live::Is(Some(0.0)))
          .allow_ellipsis(view::Live::Is(true))
          |> ignore
        })
        |> ignore
        words(facts, fn() { t("只导出自定义区域") + " · " + region_label() }, 12.0, ui_text)
        .min_width(view::Live::Is(Some(0.0)))
        .allow_ellipsis(view::Live::Is(true))
        .laid_nowhere(view::Live::By(fn() { region_on() is None }))
        |> ignore
      })
      |> ignore
    })
    |> ignore
    card.box(fn(modes) {
      modes.alpha(view::Live::By(fn() { if running() { 0.45 } else { 1.0 } })) |> ignore
      segmented(modes, fn() {
          if cropping() {
            [t("按大小"), t("自定义")]
          } else {
            [t("原样"), t("按大小"), t("自定义")]
          }
        }, fn() { if cropping() { mode() - 1 } else { export_mode.get() } }, fn(i) {
          if export_out.untracked() == "" {
            export_mode.set(if signals::untracked(cropping) { i + 1 } else { i })
          }
        })
    })
    |> ignore
    card.pick(fn() { mode() }, fn(b, m) {
      if m == 0 {
        b.box(fn(w) {
          w
          .words(
            view::Live::By(fn() {
              let h265 = clip_codecs().contains("H.265")
              t("和录像一模一样，瞬间完成。") +
              (if h265 { t("H.265 在部分聊天软件和手机上可能播不了，要发出去可以选「按大小」。") } else { "" })
            }),
            look={ ..view::words_plain, size: 12.0, line: 17.0, wrap: true },
          )
          .ink(view::Live::By(ui_subtle))
          |> ignore
        })
        |> ignore
      } else {
        b.gap(view::Live::Is(12.0)).alpha(view::Live::By(fn() { if running() { 0.45 } else { 1.0 } })) |> ignore
        b.box(fn(rows) {
          rows
          .radius(view::Live::Is(10.0))
          .ground(view::Live::By(fn() { tone(c_s2(), 0xF4F5F7FFL) }))
          .edge(view::Live::By(fn() { if is_dark() { (0.0, 0L) } else { (1.0, 0x00000014L) } }))
          .clips(view::Live::Is(true))
          |> ignore
          if m == 1 {
            size_slider(rows)
          } else {
            let one = signals::untracked(cropping)
            let gif = fn() { format() == 3 }
            format_row(rows, fn() { format_hint(format()) }, fn(c) {
              segmented(c, fn() { arr_map(formats(), format_label) }, fn() { index_of(formats(), format(), 0) }, fn(i) {
                if export_out.untracked() != "" {
                  return
                }
                export_format.set(signals::untracked(formats)[i])
                save_prefs()
              })
            })
            if !one {
              rows.show(fn() { !gif() }, fn(b) {
                setting_row(b, false, fn() { t("分辨率") }, fn() { "" }, fn(c) {
                  let opts = [0, 1440, 1080, 720]
                  segmented(c, fn() { [t("原始"), "1440p", "1080p", "720p"] }, fn() { index_of(opts, export_height.get(), 0) }, fn(i) {
                    if export_out.untracked() != "" {
                      return
                    }
                    export_height.set(opts[i])
                  })
                })
              }, at_once=true)
            }
            setting_row(rows, false, fn() { t("帧率") }, fn() { "" }, fn(c) {
              let opts = fn() {
                let sfps = source_format().2
                let above = if sfps >= 120 { [90] } else { [] }
                ({ let __mbt_sp_21 = []; __mbt_sp_21.push(0); for __mbt_spe_22 in above { __mbt_sp_21.push(__mbt_spe_22) }; __mbt_sp_21.push(60); __mbt_sp_21.push(30); __mbt_sp_21 })
              }
              let gif_opts = [15, 10]
              segmented(c, fn() {
                  if gif() {
                    ["15", "10"]
                  } else {
                    arr_map(opts(), fn(f) { if f == 0 { t("原始") } else { f.to_string() } })
                  }
                }, fn() { if gif() { index_of(gif_opts, gif_fps.get(), 0) } else { index_of(opts(), export_fps.get(), 0) } }, fn(i) {
                  if export_out.untracked() != "" {
                    return
                  }
                  if signals::untracked(gif) {
                    gif_fps.set(gif_opts[i])
                    save_prefs()
                  } else {
                    export_fps.set(signals::untracked(opts)[i])
                  }
                })
            })
            rows.show(fn() { !gif() }, fn(b) {
              setting_row(b, false, fn() { t("画质") }, fn() { t("这次导出压缩得多细；不会比录像本身更清楚") }, fn(c) {
                segmented(c, fn() { [t("低"), t("中"), t("高")] }, fn() { export_quality.get() }, fn(i) {
                  if export_out.untracked() == "" {
                    export_quality.set(i)
                  }
                })
              })
            }, at_once=true)
          }
        })
        |> ignore
        b.show(fn() { m == 2 && gif_too_big() }, fn(n) {
          n.box(fn(w) {
            w
            .words(
              view::Live::By(fn() {
                if export_bytes() > 25.0 * 1048576.0 {
                  tf("存成 GIF 约 {0}，太大了；存成视频会小得多，也更清楚", [bytes_text(export_bytes())])
                } else {
                  tf("这段有 {0}；GIF 没有声音、不能拖动，长片段存成视频更好", [clock(clip_kept())])
                }
              }),

              look={ ..view::words_plain, size: 12.0, line: 17.0, wrap: true },
            )
            .ink(view::Live::By(warn))
            |> ignore
          })
          |> ignore
        }, at_once=true)
        b.show(fn() { m == 1 && export_bytes() > size_choices[export_size.get()] * 1048576.0 }, fn(n) {
          n.box(fn(w) {
            w
            .words(
              view::Live::By(fn() {
                tf("这段太长，压不到 {0} MB 以内，会是约 {1}；可以剪短一些，或选大一档", [
                  size_choices[export_size.get()].to_int().to_string(),
                  bytes_text(export_bytes()),
                ])
              }),
              look={ ..view::words_plain, size: 12.0, line: 17.0, wrap: true },
            )
            .ink(view::Live::By(warn))
            |> ignore
          })
          |> ignore
        }, at_once=true)
      }
    }, at_once=true)
    card.pick(running, fn(b, on) {
      if on {
        b.gap(view::Live::Is(8.0)).padding(view::Live::Is((0.0, 4.0, 0.0, 0.0))) |> ignore
        b.box(fn(bar) {
          bar.height(view::Live::Is(Some(6.0))).radius(view::Live::Is(3.0)).ground(view::Live::By(c_bg)).clips(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))) |> ignore
          let fill = motion::NodeWay::new(export_done.untracked())
          bar.reacts(fn() { export_done.get() }, fn(v) { fill.go_ms(bar, v, if motion_off() { 1.0 } else { 150.0 }) })
          bar.box(fn(f) { f.height(view::Live::Is(Some(6.0))).ground(view::Live::By(ui_text)).width_share(view::Live::By(fn() { fill.shown(f) })) |> ignore }) |> ignore
        })
        |> ignore
        b.box(fn(r) {
          r.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
          words(r, fn() { tf("正在保存 {0}%", [(export_done.get() * 100.0).floor().to_int().to_string()]) }, 12.0, ui_muted) |> ignore
          spring(r)
          text_button(r, fn() { t("取消") }, fn() {
              rp_export_cancel()
              rp_concat_cancel()
            }, ghost=true)
          |> ignore
        })
        |> ignore
      } else {
        b.row(view::Live::Is(true)).gap(view::Live::Is(8.0)).padding(view::Live::Is((0.0, 4.0, 0.0, 0.0))).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
        let dest = pressable(b, fn() { t("打开文件夹") }, fn() {
          rp_mkdirs(cstr(clips_dir())) |> ignore
          rp_launch(cstr(clips_dir())) |> ignore
        }, fn(w) {
          w
          .row(view::Live::Is(true))
          .grow(view::Live::Is(1.0))
          .basis(view::Live::Is(Some(0.0)))
          .shrink(view::Live::Is(1.0))
          .min_width(view::Live::Is(Some(0.0)))
          .clips(view::Live::Is(true))
          .height(view::Live::Is(Some(28.0)))
          .padding(view::Live::Is((4.0, 0.0, 4.0, 0.0)))
          .radius(view::Live::Is(6.0))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .lies_along(view::Live::Is(view::Lies::Start))
          .edge(view::Live::By(fn() { if w.focus_shown() { (1.5, focus_ring()) } else { (0.0, 0L) } }))
          .ground(view::Live::By(fn() { if w.pointed() { press_ground() } else { 0L } }))
          |> ignore
          words(w, fn() {
              if export_error.get() != "" {
                export_error.get()
              } else {
                tf("存到 {0}", [clips_dir()])
              }
            }, 12.0, fn() {
              if export_error.get() != "" {
                warn()
              } else if w.pointed() {
                ui_muted()
              } else {
                ui_subtle()
              }
            })
          .shrink(view::Live::Is(1.0))
          .min_width(view::Live::Is(Some(0.0)))
          .allow_ellipsis(view::Live::Is(true))
          |> ignore
        })
        tip(dest, fn() { clips_dir() })
        b.box(fn(k) {
          k.row(view::Live::Is(true)).gap(view::Live::Is(8.0)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
          text_button(k, fn() { t("取消") }, fn() { export_open.set(false) }, ghost=true) |> ignore
          text_button(k, fn() { t("保存并复制") }, fn() { export_now(true) }, icon="copy") |> ignore
          solid_button(k, fn() { t("保存") }, fn() { export_now(false) }, icon="download") |> ignore
        })
        |> ignore
      }
    }, at_once=true)
  })}

fn saved_note(parent : view::View) -> Unit {
  parent.box(fn(o) {
    o.over(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::End))).lies_along(view::Live::Is(view::Lies::Start)).padding(view::Live::Is((16.0, 16.0, 16.0, 16.0))).takes(fn(_, _, _) { [] }) |> ignore
    let way = motion::NodeWay::new(0.0)
    // Retain last text/path while the card fades out.
    let kept : mbt_compat::Ref[(String, String)] = mbt_compat::ref_new(("", ""))
    let now_said = fn() {
      if saved.get() != "" {
        kept.v = (saved.get(), saved_path.get())
      }
      kept.v
    }
    o.reacts(fn() { saved.get() != "" }, fn(on) {
      way.go_ms(o, if on { 1.0 } else { 0.0 }, if motion_off() { 1.0 } else if on { 180.0 } else { 140.0 })
    })
    o.box(fn(n) {
      n
      .width(view::Live::Is(Some(note_w)))
      .radius(view::Live::Is(8.0))
      .ground(view::Live::By(c_s2))
      .edge(view::Live::By(fn() { (1.0, hair2()) }))
      .shadow(view::Live::By(fn() { (18.0, 4.0, sheet_shadow()) }))
      .presses(view::Live::By(fn() { saved.get() != "" }))
      .alpha(view::Live::By(fn() { way.shown(n) }))
      .laid_nowhere(view::Live::By(fn() { way.shown(n) <= 0.0 && saved.get() == "" }))
      .offset(view::Live::By(fn() { (0.0, if motion_off() { 0.0 } else { -8.0 * (1.0 - way.shown(n)) }) }))
      |> ignore
      n.pick(fn() { now_said().1 }, fn(b, path) {
        b.height(view::Live::Is(Some(if path == "" { note_line_h } else { note_clip_h }))) |> ignore
        note_body(b, fn() { now_said().0 }, path, fn() { open_clip_player(path) }, fn() { rp_reveal(cstr(path)) }, fn() {
          saved.set("")
        }, warning=path == "" && now_said().0.starts_with(t("没能")), mark=if path == "" { "info" } else { "check-circle" })
      }, at_once=true)
    })
    |> ignore
  })
  |> ignore}

fn size_label(mb : Double) -> String {
  if mb >= 1024.0 {
    "\{(mb / 1024.0).round().to_int()} GB"
  } else {
    "\{mb.to_int()} MB"
  }}

fn size_slider(parent : view::View) -> Unit {
  let n = size_choices.length()
  let knob = 16.0
  parent.box(fn(r) {
    r.padding(view::Live::Is((14.0, 12.0, 14.0, 12.0))).gap(view::Live::Is(10.0)) |> ignore
    r.box(fn(l) {
      l.gap(view::Live::Is(1.0)) |> ignore
      words(l, fn() { t("最大文件大小") }, 13.0, ui_text, weight=500) |> ignore
      l.box(fn(w) {
        w.words(view::Live::By(fn() { t("为发到聊天压缩成 H.264，按大小自动选清晰度") }), look={ ..view::words_plain, size: 12.0, line: 17.0, wrap: true })
        .ink(view::Live::By(ui_subtle))
        |> ignore
      })
      |> ignore
    })
    |> ignore
    r.by_room(fn(held, room) {
      let w = fn() { room.width() }
      let along = fn() { dmax(1.0, w() - knob) }
      let x_of = fn(i : Int) { knob / 2.0 + along() * i.to_double() / (n - 1).to_double() }
      headless::slider(held, fn() { t("最大文件大小") }, fn() { export_size.get().to_double() }, min=0.0, max=(n - 1).to_double(), step=1.0, thumb_room=knob, value_text=fn(v) { size_label(size_choices[clamp(v, 0.0, (n - 1).to_double()).to_int()]) }, fn(v) {
          if export_out.untracked() == "" {
            export_size.set(clamp(v.round(), 0.0, (n - 1).to_double()).to_int())
          }
        }, fn(s, state) {
          s.height(view::Live::Is(Some(20.0))).cursor(view::Live::Is(Some(view::Cursor::Arrow))) |> ignore
          s.box(fn(o) {
            o.over(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))) |> ignore
            o.box(fn(tr) {
              tr
              .width(view::Live::By(fn() { Some(along()) }))
              .height(view::Live::Is(Some(4.0)))
              .radius(view::Live::Is(2.0))
              .ground(view::Live::By(c_s4))
              .offset(view::Live::Is((knob / 2.0, 8.0)))
              |> ignore
            })
            |> ignore
          })
          |> ignore
          s.box(fn(o) {
            o.over(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))) |> ignore
            o.box(fn(f) {
              f
              .width(view::Live::By(fn() { Some(along() * state.part()) }))
              .height(view::Live::Is(Some(4.0)))
              .radius(view::Live::Is(2.0))
              .ground(view::Live::By(ui_text))
              .offset(view::Live::Is((knob / 2.0, 8.0)))
              |> ignore
            })
            |> ignore
          })
          |> ignore
          s.box(fn(o) {
            o.over(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))) |> ignore
            o.box(fn(k) {
              k
              .width(view::Live::Is(Some(knob)))
              .height(view::Live::Is(Some(knob)))
              .radius(view::Live::Is(knob / 2.0))
              .ground(view::Live::By(ui_text))
              .edge(view::Live::By(fn() { if state.focus_shown() { (2.0, ui_subtle()) } else { (0.0, 0L) } }))
              .offset(view::Live::By(fn() { (along() * state.part(), 2.0) }))
              |> ignore
            })
            |> ignore
          })
          |> ignore
        })
      |> ignore
      held.box(fn(marks) {
        marks.height(view::Live::Is(Some(30.0))) |> ignore
        for i in 0..<n {
          let idx = i
          marks.box(fn(o) {
            o.over(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))) |> ignore
            o.box(fn(tick) {
              tick.width(view::Live::Is(Some(1.0))).height(view::Live::Is(Some(4.0))).ground(view::Live::By(c_s4)).offset(view::Live::By(fn() { (x_of(idx) - 0.5, 0.0) })) |> ignore
            })
            |> ignore
            o.box(fn(lab) {
              lab
              .width(view::Live::Is(Some(60.0)))
              .lies_along(view::Live::Is(view::Lies::Middle))
              .row(view::Live::Is(true))
              .offset(view::Live::By(fn() { (x_of(idx) - 30.0, 10.0) }))
              |> ignore
              words(lab, fn() { size_label(size_choices[idx]) }, 11.0, fn() { if export_size.get() == idx { ui_text() } else { ui_subtle() } }, weight=500)
              |> ignore
            })
            |> ignore
          })
          |> ignore
        }
      })
      |> ignore
    })
    |> ignore
  })
  |> ignore}

fn clip_time(t : Double) -> Double {
  let mut n = 0.0
  for s in clip_spans(clip_a.get(), clip_b.get()) {
    if t <= s.0 {
      return n
    }
    if t < s.1 {
      return n + (t - s.0)
    }
    n += s.1 - s.0
  }
  n}
