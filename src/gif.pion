import "mbt_compat"
import "ui"

fn is_gif_path(path : String) -> Bool {
  path.ends_with(".gif")}

// Represent GIF frames as a 1000 Hz Mp4Track (sample.at holds frame index, not byte offset).
fn gif_tracks(path : String) -> Array[Mp4Track] {
  let info = text_of(rp_gif_info(cstr(path)))
  let parts = info.split(" ")
  guard parts.length() >= 3 else { return [] }
  let num = fn(s : String) { digits(s, 0, s.length()).unwrap_or(0) }
  let w = num(parts[0])
  let h = num(parts[1])
  let samples = []
  let mut t = 0L
  for i in 2..<parts.length() {
    let k = i - 2
    samples.push(Mp4Sample::{ pts: t, dts: t, at: k.to_double(), size: 0, key: true })
    t = t + num(parts[i]).to_int64()
  }
  gif_lengths.set(path, t.to_double())
  [
    Mp4Track::{
      kind: "vide",
      codec: "gif",
      timescale: 1000,
      width: w,
      height: h,
      shown_w: w,
      shown_h: h,
      config: "gif".to_bytes(),
      channels: 0,
      rate: 0,
      samples: samples,
    },
  ]}

fn gif_frame_key(path : String, at : Double) -> String {
  guard track_of(path, "vide") is Some(t) else { return "" }
  let k = imax(0, sample_at(t, (at / 1000.0).floor() * 1000.0 + 0.5))
  let key = "gx:\{path}|\{clip_modified.v}:\{k}"
  if !ui::image_bytes_for(key).is_some() {
    let bmp = rp_gif_frame(cstr(path), k, 320)
    if bmp.length() == 0 {
      return ""
    }
    ui::add_image(key, bmp)
    hover_images.keep(key)
  }
  key}
