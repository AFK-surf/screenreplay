import "motion"
import "ui"
import "view"

fn with_alpha(c : Int64, a : Double) -> Int64 {
  (c & 0xFFFFFF00L) | (clamp(a, 0.0, 1.0) * 255.0).round().to_int64()}

fn amber() -> Int64 {
  tone(0xE5A545FFL, 0x9E600DFFL)}

fn amber_hi() -> Int64 {
  tone(0xF5C36BFFL, 0x824E08FFL)}

fn steam_at(phase : Double) -> (Double, Double) {
  let p = phase - phase.floor()
  let ease = fn(t : Double) { t * t * (3.0 - 2.0 * t) }
  if p < 0.45 {
    let t = ease(p / 0.45)
    (0.15 + (0.95 - 0.15) * t, 1.2 + (-0.8 - 1.2) * t)
  } else {
    let t = ease((p - 0.45) / 0.55)
    (0.95 + (0.10 - 0.95) * t, -0.8 + (-2.4 - -0.8) * t)
  }}

fn heart_at(t : Double) -> (Double, Double, Double) {
  let lerp = fn(a : Double, b : Double, k : Double) { a + (b - a) * k }
  if t <= 0.0 || t >= 1.0 {
    (0.0, 5.0, 0.5)
  } else if t < 0.35 {
    let k = t / 0.35
    (lerp(0.0, 1.0, k), lerp(5.0, -2.0, k), lerp(0.5, 1.1, k))
  } else if t < 0.75 {
    let k = (t - 0.35) / 0.4
    (lerp(1.0, 0.95, k), lerp(-2.0, -5.0, k), lerp(1.1, 0.95, k))
  } else {
    let k = (t - 0.75) / 0.25
    (lerp(0.95, 0.0, k), lerp(-5.0, -10.0, k), lerp(0.95, 0.8, k))
  }}

fn sponsor_card(p : view::View) -> Unit {
  pressable(p, fn() { t("赞助作者") }, fn() {
    rp_launch(cstr(sponsor_url + (if is_english() { "?lang=en" } else { "?lang=zh" }))) |> ignore
  }, fn(card) {
    let hand = motion::NodeWay::new(0.0)
    let lift = motion::NodeWay::new(0.0)
    let steam = motion::NodeWay::new(0.0)
    let heart = motion::NodeWay::new(0.0)
    let sheen = motion::NodeWay::new(0.0)
    let glow = motion::NodeWay::new(0.0)
    let held = motion::NodeWay::new(1.0)
    let still = motion_off()
    if !still {
      steam.go_ms(card, 2.45, steam_breath * 2.0, ease=ui::Ease::Linear)
      sheen.go(card, 1.0, motion::tween(820.0, ease=ui::Ease::Out, delay=240.0))
      glow.go_ms(card, 1.0, 900.0, ease=ui::Ease::Linear)
    } else {
      steam.put(0.45)
    }
    // REPLAY_DEV_POINTER=1: synthetic test pointer doesn't trigger pointed(), fall back to pointer_within().
    let dev_hand = ui::env("REPLAY_DEV_POINTER") == "1"
    card.reacts(fn() { card.pointed() || card.focus_shown() || (dev_hand && card.pointer_within()) }, fn(on) {
      if motion_off() {
        hand.put(if on { 1.0 } else { 0.0 })
        return
      }
      hand.go_ms(card, if on { 1.0 } else { 0.0 }, 200.0)
      lift.go_ms(card, if on { 1.0 } else { 0.0 }, 240.0, ease=ui::Ease::Move)
      if on {
        let from = steam.target()
        steam.go_ms(card, from + 100.0, steam_breath * 100.0, ease=ui::Ease::Linear)
        let h = heart.value_at(now())
        if h <= 0.0 || h >= 1.0 {
          heart.put(0.0)
          heart.go_ms(card, 1.0, 1100.0, ease=ui::Ease::Linear)
        }
        sheen.put(0.0)
        sheen.go_ms(card, 1.0, 820.0)
      } else {
        let now_at = steam.value_at(now())
        let rest = (now_at - 0.45).ceil() + 0.45
        steam.go_ms(card, rest, dmax(1.0, (rest - now_at) * steam_breath), ease=ui::Ease::Linear)
      }
    })
    card.reacts(fn() { card.pressed() }, fn(on) {
      if motion_off() {
        held.put(1.0)
      } else {
        held.go_ms(card, if on { 0.99 } else { 1.0 }, 100.0)
      }
    })
    card
    .scale(view::Live::By(fn() { held.shown(card) }))
    .row(view::Live::Is(true))
    .padding(view::Live::Is((14.0, 12.0, 14.0, 12.0)))
    .gap(view::Live::Is(12.0))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .radius(view::Live::Is(10.0))
    .clips(view::Live::Is(true))
    .cursor(view::Live::Is(Some(view::Cursor::Arrow)))
    .ground(view::Live::By(fn() {
      let h = hand.shown(card)
      mix(tone(c_s2(), 0xF4F5F7FFL), amber(), 0.07 + 0.06 * h)
    }))
    .edge(view::Live::By(fn() {
      if card.focus_shown() {
        return (1.5, focus_ring())
      }
      let h = hand.shown(card)
      let g = glow.shown(card)
      let bump = if g <= 0.0 || g >= 1.0 { 0.0 } else if g < 0.4 { g / 0.4 } else { (1.0 - g) / 0.6 }
      let base = if is_dark() { 0.22 + 0.24 * h } else { 0.24 + 0.24 * h }
      (1.0, with_alpha(if h > 0.5 { amber_hi() } else { amber() }, base + 0.2 * bump))
    }))
    |> ignore
    card.box(fn(badge) {
      badge
      .width(view::Live::Is(Some(36.0)))
      .height(view::Live::Is(Some(36.0)))
      .radius(view::Live::Is(9.0))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .ground(view::Live::By(fn() { with_alpha(amber(), 0.13 + 0.07 * lift.shown(card)) }))
      .edge(view::Live::By(fn() { (1.0, with_alpha(amber(), if is_dark() { 0.22 } else { 0.24 })) }))
      .offset(view::Live::By(fn() { (0.0, -1.0 * lift.shown(card)) }))
      .turn(view::Live::By(fn() { -5.0 * 3.14159265358979 / 180.0 * lift.shown(card) }))
      .scale(view::Live::By(fn() { 1.0 + 0.06 * lift.shown(card) }))
      |> ignore
      badge.box(fn(icon) {
        icon.width(view::Live::Is(Some(18.0))).height(view::Live::Is(Some(18.0))) |> ignore
        icon.box(fn(cup) {
          cup
          .over(view::Live::Is(true))
          .picture(view::Live::Is(Some(vector("M2.6 6.4h8.4v3.4a3.2 3.2 0 0 1-3.2 3.2H5.8a3.2 3.2 0 0 1-3.2-3.2ZM11 7.3h0.8a1.6 1.6 0 0 1 0 3.2H11", 16.0, 16.0, stroke=1.45))))
          .tint(view::Live::By(amber_hi))
          |> ignore
        })
        |> ignore
        for k, d in ["M5 2.4v1.8", "M7.4 2.1v2.1", "M9.8 2.4v1.8"] {
          let delay = k.to_double() * 400.0 / steam_breath
          icon.box(fn(line) {
            line
            .over(view::Live::Is(true))
            .picture(view::Live::Is(Some(vector(d, 16.0, 16.0, stroke=1.45))))
            .tint(view::Live::By(amber_hi))
            .alpha(view::Live::By(fn() { steam_at(steam.shown(card) - delay).0 }))
            .offset(view::Live::By(fn() { (0.0, steam_at(steam.shown(card) - delay).1 * 18.0 / 16.0) }))
            |> ignore
          })
          |> ignore
        }
      })
      |> ignore
      badge.box(fn(h) {
        h
        .over(view::Live::Is(true), edges=(None, Some(-4.0), Some(-4.0), None))
        .width(view::Live::Is(Some(12.0)))
        .height(view::Live::Is(Some(12.0)))
        .presses(view::Live::Is(false))
        .picture(view::Live::Is(Some({ w: 16.0, h: 16.0, layers: [layer("M8 13.7C8 13.7 2 9.8 2 5.6A3.2 3.2 0 0 1 8 3.8A3.2 3.2 0 0 1 14 5.6C14 9.8 8 13.7 8 13.7Z", 0xFFFFFFFFL)] })))
        .tint(view::Live::By(fn() { tone(0xFF6B7AFFL, 0xE5384FFFL) }))
        .alpha(view::Live::By(fn() { heart_at(heart.shown(card)).0 }))
        .offset(view::Live::By(fn() { (0.0, heart_at(heart.shown(card)).1) }))
        .scale(view::Live::By(fn() { heart_at(heart.shown(card)).2 }))
        |> ignore
      })
      |> ignore
    })
    |> ignore
    card.box(fn(copy) {
      copy.grow(view::Live::Is(1.0)).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(2.0)) |> ignore
      words(copy, fn() { t("赞助作者") }, 13.0, ui_text, weight=600) |> ignore
      words(copy, fn() { t("ScreenReplay 免费使用，觉得好用可以请我喝杯咖啡") }, 12.0, ui_subtle)
      .shrink(view::Live::Is(1.0))
      .min_width(view::Live::Is(Some(0.0)))
      .allow_ellipsis(view::Live::Is(true))
      |> ignore
    })
    |> ignore
    card.box(fn(pill) {
      pill
      .row(view::Live::Is(true))
      .height(view::Live::Is(Some(28.0)))
      .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
      .gap(view::Live::Is(4.0))
      .radius(view::Live::Is(7.0))
      .clips(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .ground(view::Live::By(fn() { mix(amber(), amber_hi(), hand.shown(card)) }))
      .offset(view::Live::By(fn() { (hand.shown(card), 0.0) }))
      |> ignore
      let ink = fn() { tone(0x16120BFFL, 0xFFFFFFFFL) }
      words(pill, fn() { t("请喝咖啡") }, 12.0, ink, weight=600) |> ignore
      pill.box(fn(g) {
        g
        .width(view::Live::Is(Some(12.0)))
        .height(view::Live::Is(Some(12.0)))
        .picture(view::Live::Is(Some(vector("M5 11L11 5M6 5h5v5", 16.0, 16.0, stroke=1.8))))
        .tint(view::Live::By(ink))
        |> ignore
      })
      |> ignore
      pill.box(fn(band) {
        band
        .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), None, Some(0.0)))
        .width(view::Live::Is(Some(44.0)))
        .presses(view::Live::Is(false))
        .fades(view::Live::Is((20.0, 0.0, 20.0, 0.0)))
        .alpha(view::Live::By(fn() {
          let s = sheen.shown(card)
          if s <= 0.0 || s >= 1.0 { 0.0 } else { 1.0 }
        }))
        .offset(view::Live::By(fn() { (-50.0 + 200.0 * sheen.shown(card), 0.0) }))
        |> ignore
        // .fades() masks child content, not this node's own ground.
        band.box(fn(w) { w.grow(view::Live::Is(1.0)).ground(view::Live::Is(0xFFFFFF6BL)) |> ignore }) |> ignore
      })
      |> ignore
    })
    |> ignore
  })
  |> ignore}
