import "mbt_compat"
import "pixels"
import "signals"
import "ui"
import "view"
import "hostapi"

// The first run's sheet (the reviewer's design, the user's yes, 2026-11-13): before anything is recorded, a sheet over
// the empty window says what it records, where it is kept and for how long, what can always be done, what it does
// not do; then how far back to keep and whether to start with Windows (off), and recording starts only from its
// primary key. Either key writes the consent (settings.json's "consent": its version and when) with the choices, the
// way the settings are written, so the recorder takes them at once. Shown again where the consent is older than
// consent_version; where none is but the buffer holds recordings already (a build from before it, recording), written
// without asking. Escape or the window's close hide the window and write nothing: it shows again next time. Read
// again from About, the same words alone with 知道了.

/// The consent's version: the sheet shown again where settings.json's is older (what it says changed).


/// Read again from About: the words alone, 知道了 its only key (kept as it closes, so it goes as it came).


/// How far back is kept, minutes, as chosen in the sheet (the settings' choices: window_choices).


/// Whether it starts with Windows, as chosen in the sheet (off till turned on).


/// As the folder is first read and as the window is shown again: the sheet up where no consent of this version is.
fn consent_check() -> Unit {
  load_settings()
  if settings.consent_version >= consent_version {
    return
  }
  if !segs.is_empty() {
    // (recording already, from before the sheet: taken as given, the sheet not shown)
    settings.consent_version = consent_version
    settings.consent_at = rp_now()
    save_settings()
    return
  }
  consent_window.set(window_choices[index_of(window_choices, settings.window_minutes, 2)])
  consent_autostart.set(false)
  consent_reading.set(false)
  consent_open.set(true)}

/// One of the first run's keys: the consent written with the choices, background recording on (`record`) or off.
fn consent_given(record : Bool) -> Unit {
  // (integrated graphics, settings never written: the picture brought down to 1440p, a 4K screen's half, as the
  // first default; its video engine both records and plays video (the user, 2026-11-17 「还有很多没有独立显卡的设备」).
  // Nothing changes on a screen of 1440p or less, and the settings say it as any other choice)
  let fresh = read_text(settings_path()) == ""
  load_settings()
  if fresh && settings.max_height == 0 && recording_info().shared_gpu {
    settings.max_height = 1440
  }
  settings.consent_version = consent_version
  settings.consent_at = rp_now()
  settings.window_minutes = consent_window.untracked()
  settings.autostart = consent_autostart.untracked()
  settings.enabled = record
  save_settings()
  consent_open.set(false)
  if !record {
    asked_recorder("disabled", t("后台录制已关闭"))
  } else if recorder_code() == "" {
    start_recorder()
  } else {
    asked_recorder("recording", t("录制中"))
  }}

/// Read again from About.
fn consent_reread() -> Unit {
  consent_reading.set(true)
  consent_open.set(true)}

/// Words that wrap: `size`, `line` high, `weight`, in `ink`.
fn wrapped(parent : view::View, text : () -> String, size : Double, line : Double, ink : () -> Int64, weight? : Int) -> Unit {
  let weight = match weight { Some(__mbt_v) => __mbt_v, None => 400 }

  parent.box(fn(w) {
    w.words(view::Live::By(text), look={ ..view::words_plain, size: size, weight: weight, line: line, wrap: true }).ink(view::Live::By(ink)) |> ignore
  })
  |> ignore}

/// Room `h` high between what a column holds.
fn room(parent : view::View, h : Double) -> Unit {
  parent.box(fn(r) { r.height(view::Live::Is(Some(h))) |> ignore }) |> ignore}

/// The rows' glyphs, the design's own (on a 16 grid, 1.5 wide lines): the screen, the disk, pause in a ring, a shield.
fn consent_glyph(name : String) -> pixels::Vector {
  let paths = match name {
    "screen" =>
      [
        ("M3 2.5h10a1.5 1.5 0 0 1 1.5 1.5v5.5a1.5 1.5 0 0 1-1.5 1.5H3a1.5 1.5 0 0 1-1.5-1.5V4A1.5 1.5 0 0 1 3 2.5z", 1.5),
        ("M5.5 13.5h5M8 11v2.5", 1.5),
      ]
    "disk" =>
      [
        ("M2.5 4.5a5.5 2 0 1 0 11 0a5.5 2 0 1 0-11 0z", 1.5),
        ("M2.5 4.5v7c0 1.1 2.5 2 5.5 2c3 0 5.5-0.9 5.5-2v-7M2.5 8c0 1.1 2.5 2 5.5 2c3 0 5.5-0.9 5.5-2", 1.5),
      ]
    "pause" => [("M2 8a6 6 0 1 0 12 0a6 6 0 1 0-12 0z", 1.5), ("M6.5 5.8v4.4M9.5 5.8v4.4", 1.5)]
    _ => [("M8 1.8L3 3.6v4c0 3 2 5.3 5 6.6c3-1.3 5-3.6 5-6.6v-4z", 1.5)]
  }
  vectors(16.0, 16.0, paths)}

/// A row of the card: its glyph (16, the muted ink, 2 down), its title (13, 500) over what it says (12, 19 a line,
/// muted); a hairline over all but the first.
fn consent_row(parent : view::View, first : Bool, glyph_name : String, title : () -> String, body : () -> String) -> Unit {
  if !first {
    rule(parent, hair)
  }
  parent.box(fn(r) {
    r.row(view::Live::Is(true)).padding(view::Live::Is((14.0, 12.0, 14.0, 12.0))).gap(view::Live::Is(12.0)).lines_up(view::Live::Is(Some(view::Along::Start))) |> ignore
    r.box(fn(g) {
      g.padding(view::Live::Is((0.0, 2.0, 0.0, 0.0))) |> ignore
      g.box(fn(p) { p.width(view::Live::Is(Some(16.0))).height(view::Live::Is(Some(16.0))).picture(view::Live::Is(Some(consent_glyph(glyph_name)))).tint(view::Live::By(ui_muted)) |> ignore }) |> ignore
    })
    |> ignore
    r.box(fn(c) {
      c.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).gap(view::Live::Is(1.0)) |> ignore
      wrapped(c, title, 13.0, 20.0, ui_text, weight=500)
      wrapped(c, body, 12.0, 19.0, ui_muted)
    })
    |> ignore
  })
  |> ignore}

/// The sheet's keys, 34 high, radius 8, 16 either side, words 13 at 500: `primary` the accent's ground (the red dot
/// before its words where `dot`: it starts recording), else bare, its words muted, s3 under the pointer.
fn consent_button(parent : view::View, label : () -> String, press : () -> Unit, primary? : Bool, dot? : Bool) -> Unit {
  let primary = match primary { Some(__mbt_v) => __mbt_v, None => false }
  let dot = match dot { Some(__mbt_v) => __mbt_v, None => false }

  pressable(parent, label, press, fn(b) {
    let (hand, _) = answer(b)
    b
    .row(view::Live::Is(true))
    .height(view::Live::Is(Some(32.0)))
    .padding(view::Live::Is((16.0, 0.0, 16.0, 0.0)))
    .gap(view::Live::Is(8.0))
    .radius(view::Live::Is(8.0))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .edge(view::Live::By(fn() { if b.focus_shown() { (1.5, if primary { ui_subtle() } else { focus_ring() }) } else { (0.0, 0L) } }))
    .ground(view::Live::By(fn() {
      let h = hand.shown(b)
      if primary {
        mix(ui_accent(), ui_accent_hover(), h)
      } else {
        mix(clear(c_s3()), c_s3(), h)
      }
    }))
    |> ignore
    if dot {
      b.box(fn(d) { d.width(view::Live::Is(Some(8.0))).height(view::Live::Is(Some(8.0))).radius(view::Live::Is(4.0)).ground(view::Live::By(rec_red)) |> ignore }) |> ignore
    }
    words(b, label, 13.0, fn() { if primary { ui_on_accent() } else { mix(ui_muted(), ui_text(), hand.shown(b)) } }, weight=500) |> ignore
  })
  |> ignore}

/// 保留最近's choice: what is chosen (13, 500) and a chevron on s3 (s2 in the light), 32 high, radius 8; pressed, a
/// menu of the settings' choices under it, the one chosen ticked.
fn consent_choice(parent : view::View) -> Unit {
  let labels = fn() { [t("30 分钟"), t("1 小时"), t("2 小时"), t("4 小时")] }
  let chosen = fn() { index_of(window_choices, consent_window.get(), 2) }
  let key : mbt_compat::Ref[Option[view::View]] = mbt_compat::ref_new(None)
  let k = pressable(parent, fn() { t("保留最近") }, fn() {
    guard key.v is Some(b) else { return }
    let now_i = signals::untracked(chosen)
    open_menu_under(b, arr_mapi(labels(), fn(i, l) {
        Some(MenuEntry::{ label: l, key: if i == now_i { "✓" } else { "" }, act: fn() { consent_window.set(window_choices[i]) } })
      }))
  }, fn(b) {
    let (hand, _) = answer(b)
    b
    .row(view::Live::Is(true))
    .height(view::Live::Is(Some(32.0)))
    .padding(view::Live::Is((12.0, 0.0, 10.0, 0.0)))
    .gap(view::Live::Is(8.0))
    .radius(view::Live::Is(8.0))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .cursor(view::Live::Is(Some(view::Cursor::Arrow)))
    .ground(view::Live::By(fn() { mix(tone(c_s3(), c_s2()), tone(c_s4(), c_s3()), hand.shown(b)) }))
    |> ignore
    words(b, fn() { labels()[chosen()] }, 13.0, ui_text, weight=500) |> ignore
    b.box(fn(c) {
      c.width(view::Live::Is(Some(8.0))).height(view::Live::Is(Some(8.0))).picture(view::Live::Is(Some(vector("M1 2.5 4 5.5 7 2.5", 8.0, 8.0, stroke=1.5)))).tint(view::Live::By(ui_text)) |> ignore
    })
    |> ignore
  })
  key.v = Some(k)}

/// An option's line, 32 high: its words (13) on the left, its control on the right.
fn consent_option(parent : view::View, label : () -> String, control : (view::View) -> Unit) -> Unit {
  parent.box(fn(o) {
    o.row(view::Live::Is(true)).height(view::Live::Is(Some(32.0))).gap(view::Live::Is(10.0)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
    o.box(fn(l) {
      l.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))) |> ignore
      words(l, label, 13.0, ui_text) |> ignore
    })
    |> ignore
    control(o)
  })
  |> ignore}

/// 隐私政策: 12, subtle (muted under the pointer), a line 3 under it; the site's page opened, as About's is.
fn privacy_link(parent : view::View) -> Unit {
  pressable(parent, fn() { t("隐私政策") }, fn() {
    rp_launch(cstr(site_url + "/privacy" + (if is_english() { "?lang=en" } else { "" }))) |> ignore
  }, fn(b) {
    let (hand, _) = answer(b)
    let ink = fn() { mix(ui_subtle(), ui_muted(), hand.shown(b)) }
    b.gap(view::Live::Is(1.0)) |> ignore
    words(b, fn() { t("隐私政策") }, 12.0, ink) |> ignore
    b.box(fn(u) { u.height(view::Live::Is(Some(1.0))).fills_across(view::Live::Is(true)).ground(view::Live::By(ink)) |> ignore }) |> ignore
  })
  |> ignore}

/// Over the scrim while the first run's sheet is up, where the title bar is: its empty room still moves the window,
/// its keys still minimize, maximize and close it (closed, hidden: nothing written).
fn consent_window_keys(layer : view::View) -> Unit {
  layer.box(fn(o) {
    o.over(view::Live::Is(true)) |> ignore
    o.show(fn() { !consent_reading.get() }, fn(s) {
      s.box(fn(bar) {
        let h = title_h()
        bar.row(view::Live::Is(true)).height(view::Live::Is(Some(h))).fills_across(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
        bar.box(fn(mid) {
          mid.grow(view::Live::Is(1.0)).height(view::Live::Is(Some(h))).presses(view::Live::Is(true)).moves_window(view::Live::Is(true)) |> ignore
        })
        |> ignore
        if !is_mac() {
          window_key(bar, fn() { t("最小化") }, fn() { "minus" }, fn() { hostapi::window_act(1) })
          window_key(bar, fn() { if ui::window_zoomed() { t("还原") } else { t("最大化") } }, fn() {
            if ui::window_zoomed() {
              "copy"
            } else {
              "square"
            }
          }, fn() { hostapi::window_act(2) })
          window_key(bar, fn() { t("关闭") }, fn() { "close" }, fn() { hostapi::window_act(3) }, close=true)
        }
      })
      |> ignore
    }, at_once=true)
  })
  |> ignore}

/// The sheet: 560 wide, 28 in (22 under); the app's mark (44) by the title (18, 600) and what it does (13, muted);
/// 20 under, the four rows in a card of s2 (in the light a near-white with a hairline), radius 10; 16 under, the two
/// options; 20 under, 隐私政策 and the keys. Read again, no options and 知道了 alone.
fn consent_sheet(root : view::View) -> Unit {
  sheet(root, fn() { consent_open.get() }, fn() { if consent_reading.untracked() { consent_open.set(false) } }, 560.0, bare=true, can_close=fn() { consent_reading.get() }, over=consent_window_keys, fn(card) {
      card.padding(view::Live::Is((28.0, 28.0, 28.0, 22.0))) |> ignore
      card.box(fn(head) {
        head.row(view::Live::Is(true)).gap(view::Live::Is(14.0)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
        app_logo(head, 44.0)
        head.box(fn(c) {
          c.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).gap(view::Live::Is(2.0)) |> ignore
          wrapped(c, fn() { t("开始之前，先说清楚它做什么") }, 18.0, 23.0, ui_text, weight=600)
          wrapped(c, fn() { t("ScreenReplay 会在后台一直录着你的屏幕，直到你暂停或退出。") }, 13.0, 20.0, ui_muted)
        })
        |> ignore
      })
      |> ignore
      room(card, 16.0)
      card.box(fn(sc) {
        sc.max_height(view::Live::Is(Some(440.0))) |> ignore
        sc.scrolls(view::Scroll::new(), slop=ui::touch_slop(), bar=ui::tree_scroll_bar(), fn(body) {
          body.box(fn(rows) {
            rows
            .radius(view::Live::Is(10.0))
            .ground(view::Live::By(fn() { tone(c_s2(), 0xF4F5F7FFL) }))
            .edge(view::Live::By(fn() { if is_dark() { (0.0, 0L) } else { (1.0, 0x00000014L) } }))
            .clips(view::Live::Is(true))
            |> ignore
            consent_row(rows, true, "screen", fn() { t("录什么") }, fn() {
              t(if is_mac() {
                  "主屏幕的画面和系统声音。麦克风默认不录。还会记下每个时刻在前台的应用和各窗口的位置、标题，用来画时间线和按窗口导出。也会记下鼠标、键盘和手柄用得多频繁（只记次数，不记按了哪个键、点在哪里），在时间线上标出忙碌的时段。首次开始录制时，需要在「系统设置 › 隐私与安全性 › 屏幕与系统音频录制」中授予录制权限。"
                } else {
                  "主屏幕的画面和系统声音。麦克风默认不录。还会记下每个时刻在前台的应用和各窗口的位置、标题，用来画时间线和按窗口导出。也会记下鼠标、键盘和手柄用得多频繁（只记次数，不记按了哪个键、点在哪里），在时间线上标出忙碌的时段。开始录制时，Windows 可能会问一次是否允许它截屏时不显示黄色边框，允许即可。"
                })
            })
            consent_row(rows, false, "disk", fn() { t("存在哪、留多久") }, fn() {
              t(if is_mac() {
                  "只存在这台 Mac 上，不上传。只保留最近一段时间，更早的自动删除。"
                } else {
                  "只存在这台电脑上，不上传。只保留最近一段时间，更早的自动删除。"
                })
            })
            consent_row(rows, false, "pause", fn() { t("你随时可以") }, fn() {
              t(if is_mac() {
                  "从菜单栏图标暂停或退出；在「设置 › 存储」里删除全部录像；在设置里关掉声音或整个后台录制。"
                } else {
                  "从托盘图标暂停或退出；在「设置 › 存储」里删除全部录像；在设置里关掉声音或整个后台录制。"
                })
            })
            consent_row(rows, false, "shield", fn() { t("它不做的") }, fn() { t("这个版本不收集任何使用统计，也不发送崩溃报告。") })
          })
          |> ignore
          body.show(fn() { !consent_reading.get() }, fn(opts) {
            opts.padding(view::Live::Is((0.0, 14.0, 0.0, 0.0))).gap(view::Live::Is(10.0)) |> ignore
            consent_option(opts, fn() { t("保留最近") }, consent_choice)
            let autostart_label = fn() {
              t(if is_mac() { "登录时自动启动并开始录制" } else { "开机时自动启动并开始录制" })
            }
            consent_option(opts, autostart_label, fn(c) {
              switch(c, autostart_label, fn() { consent_autostart.get() }, fn(v) { consent_autostart.set(v) })
            })
          }, at_once=true)
        })
        |> ignore
      })
      |> ignore
      room(card, 16.0)
      card.box(fn(foot) {
        foot.row(view::Live::Is(true)).gap(view::Live::Is(10.0)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
        privacy_link(foot)
        spring(foot)
        foot.pick(fn() { consent_reading.get() }, fn(b, reading) {
          b.row(view::Live::Is(true)).gap(view::Live::Is(10.0)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
          if reading {
            consent_button(b, fn() { t("知道了") }, fn() { consent_open.set(false) }, primary=true)
          } else {
            consent_button(b, fn() { t("暂不录制") }, fn() { consent_given(false) })
            consent_button(b, fn() { t("开始录制") }, fn() { consent_given(true) }, primary=true, dot=true)
          }
        }, at_once=true)
      })
      |> ignore
    })}
