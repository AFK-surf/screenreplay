import "mbt_compat"
import "signals"
import "view"

fn keep_view() -> Unit {
  signals::untracked(fn() {
    let len = view_len()
    let total = ax_span(len)
    let mut from = view_from.get()
    if follow_latest.get() {
      from = total - len
    }
    view_from.set(dmax(0.0, dmin(from, total - len)))
  })}

fn zoom_about(k : Double, anchor : Double) -> Unit {
  view_by_hand.v = now()
  signals::untracked(fn() {
    let old = view_len()
    let along = (anchor - view_from.get()) / old
    // Convert anchor to buffer time before changing view_duration, as seam widths depend on view_len.
    let at = ax_b(anchor, old)
    let at_end = view_from.get() + old >= ax_span(old) - 1.0
    let all = view_total()
    let mut d = dmax(min_view, dmin(all, old / k))
    if d >= all {
      // Sentinel (24 h) so view stays fitted to the whole buffer as new segments arrive.
      d = 86400000.0
    }
    view_duration.set(d)
    let len = view_len()
    view_from.set(ax_d(at, len) - along * len)
    follow_latest.set(follow_latest.get() && at_end)
  })
  keep_view()}

fn zoom_by(k : Double) -> Unit {
  glide()
  let (from, len) = signals::untracked(fn() { (view_from.get(), view_len()) })
  let p = ax_d(pos_now(), len)
  let anchor = if p >= from && p <= from + len { p } else { from + len / 2.0 }
  zoom_about(k, anchor)}

fn zoom_to(len : Double) -> Unit {
  glide()
  let (from, old) = signals::untracked(fn() { (view_from.get(), view_len()) })
  let p = ax_d(pos_now(), old)
  let anchor = ax_b(if p >= from && p <= from + old { p } else { from + old / 2.0 }, old)
  if len >= view_total() {
    view_duration.set(86400000.0)
    view_from.set(0.0)
    follow_latest.set(true)
  } else {
    view_duration.set(dmax(min_view, len))
    let l = signals::untracked(view_len)
    let total = ax_span(l)
    view_from.set(dmax(0.0, dmin(ax_d(anchor, l) - l / 2.0, total - l)))
    follow_latest.set(view_from.untracked() + l >= total - 1.0)
  }
  keep_view()}

fn view_len_words(len : Double) -> String {
  let tenth = fn(x : Double) -> String {
    let r = (x * 10.0).round() / 10.0
    if r == r.floor() {
      r.to_int().to_string()
    } else {
      r.to_string()
    }
  }
  if len < 60000.0 {
    tf("{0} 秒", [(len / 1000.0).round().to_int().to_string()])
  } else if len < 600000.0 {
    tf("{0} 分钟", [tenth(len / 60000.0)])
  } else if len < 3600000.0 {
    tf("{0} 分钟", [(len / 60000.0).round().to_int().to_string()])
  } else {
    tf("{0} 小时", [tenth(len / 3600000.0)])
  }}

fn pan_timeline(delta : Double) -> Unit {
  view_by_hand.v = now()
  signals::untracked(fn() {
    view_from.set(view_from.get() + delta)
    follow_latest.set(view_from.get() + view_len() >= ax_span(view_len()) - 1.0 && delta > 0.0)
  })
  keep_view()}

fn show_latest() -> Unit {
  glide()
  follow_latest.set(true)
  keep_view()
  seek_to(span() - 1000.0)}

fn reveal(at : Double) -> Unit {
  let (from, len) = signals::untracked(fn() { (view_from.get(), view_len()) })
  let at = ax_d(at, len)
  if at < from || at > from + len {
    glide()
    follow_latest.set(false)
    view_from.set(at - len / 2.0)
    keep_view()
  }}

fn jump_to(at : Double) -> Unit {
  // Key-repeat (<250 ms): scrub keyframes while held to avoid decoder backlog, then exact-seek 150 ms after release.
  let t = now()
  let repeat = t - key_jump_at.v < 250.0
  key_jump_at.v = t
  if !repeat {
    seek_to(at)
    reveal(pos_now())
    return
  }
  key_seeking.v = true
  scrub_to(at)
  reveal(pos_now())
  match the_root.v {
    Some(r) =>
      r.at_moment(t + 150.0, fn() {
        if key_jump_at.v == t {
          key_seeking.v = false
          seek_to(pos_now())
        }
      })
      |> ignore
    None => {
      key_seeking.v = false
      seek_to(at)
    }
  }}

fn set_view(from : Double, len : Double) -> Unit {
  view_by_hand.v = now()
  let len = dmax(min_view, len)
  view_duration.set(if len >= view_total() { 86400000.0 } else { len })
  view_from.set(from)
  let l = signals::untracked(view_len)
  follow_latest.set(from + l >= ax_span(l) - 1.0)
  keep_view()}

fn start_clip() -> Unit {
  if clipping.untracked() {
    return
  }
  load_windows()
  clipping.set(true)
  pick_window(Option::None)
  clear_region()
  clip_kind.set(0)
  saved.set("")
  let total = span()
  let a = dmax(0.0, pos_now())
  let mut b = dmin(total, a + 30000.0)
  let mut a = a
  if b - a < 1000.0 {
    a = dmax(0.0, b - 30000.0)
    b = total
  }
  clip_a.set(a)
  clip_b.set(b)
  frame_clip()
  clip_history_start()}

fn frame_clip() -> Unit {
  glide()
  let vl = signals::untracked(view_len)
  let len = ax_d(clip_b.untracked(), vl) - ax_d(clip_a.untracked(), vl)
  if len * 6.0 < vl {
    view_duration.set(dmax(min_view, len * 3.0))
    follow_latest.set(false)
    let l = signals::untracked(view_len)
    view_from.set((ax_d(clip_a.untracked(), l) + ax_d(clip_b.untracked(), l)) / 2.0 - l / 2.0)
    keep_view()
  }}

fn show_clip() -> Unit {
  frame_clip()
  let vl = signals::untracked(view_len)
  let len = ax_d(clip_b.untracked(), vl) - ax_d(clip_a.untracked(), vl)
  if len > vl * 0.9 {
    view_duration.set(len * 1.25)
  }
  let (from, vlen) = signals::untracked(fn() { (view_from.get(), view_len()) })
  let (a, b) = (ax_d(clip_a.untracked(), vlen), ax_d(clip_b.untracked(), vlen))
  if a < from || b > from + vlen {
    follow_latest.set(false)
    view_from.set((a + b) / 2.0 - vlen / 2.0)
  }
  keep_view()}

fn set_clip_start(at : Double) -> Unit {
  if !clipping.untracked() {
    start_clip()
  }
  clip_a.set(dmax(0.0, at))
  if clip_b.untracked() < clip_a.untracked() + 1000.0 {
    clip_b.set(dmin(span(), clip_a.untracked() + 30000.0))
  }}

fn set_clip_end(at : Double) -> Unit {
  if !clipping.untracked() {
    start_clip()
  }
  clip_b.set(dmin(span(), at))
  if clip_a.untracked() > clip_b.untracked() - 1000.0 {
    clip_a.set(dmax(0.0, clip_b.untracked() - 30000.0))
  }}

fn play_clip() -> Unit {
  let (a, b) = (clip_a.untracked(), clip_b.untracked())
  let p = pos_now()
  if p >= a && p < b - 500.0 {
    set_playing(true)
    return
  }
  seek_to(a)
  reveal(a)
  set_playing(true)}

fn next_mark(dir : Int) -> Option[Double] {
  let base = t0()
  let p = pos_now()
  let mut best : Option[Double] = Option::None
  for m in marks {
    let at = m - base
    if dir > 0 && at > p + 500.0 {
      match best {
        Option::Some(b) if b <= at => ()
        _ => best = Option::Some(at)
      }
    }
    if dir < 0 && at < p - 500.0 {
      match best {
        Option::Some(b) if b >= at => ()
        _ => best = Option::Some(at)
      }
    }
  }
  best}

fn add_marker(at : Double) -> Unit {
  let abs = (t0() + at).round()
  if rp_append(cstr(pjoin(root_dir(), "markers.jsonl")), mbt_compat::utf8_encode("{\"at\":\{abs.to_int64()}}\n")) == 1 {
    marks.push(abs)
    arr_sort_double(marks)
    just_marked.v = abs
    data_changed()
    tell(tf("已在 {0} 加标记", [wall(abs)]), icon="check-circle")
  }}

fn mark_at_playhead(v : view::View) -> Option[Double] {
  data()
  let at = t0() + pos_drawn(v)
  for m in marks {
    if (m - at).abs() <= 500.0 {
      return Option::Some(m)
    }
  }
  Option::None}

fn toggle_marker(v : view::View) -> Unit {
  match signals::untracked(fn() { mark_at_playhead(v) }) {
    Some(m) => {
      remove_marker(m)
      tell(tf("已移除 {0} 的标记", [wall(m)]), icon="check-circle")
    }
    None => add_marker(pos_now())
  }}

fn remove_marker(abs : Double) -> Unit {
  let path = pjoin(root_dir(), "markers.jsonl")
  let kept : Array[String] = []
  for line in read_text(path).split("\n") {
    let line = line
    match parse(line) {
      Option::Some(mbt_compat::MbtJson::Object(o)) => {
        match o.get("at") {
          Some(mbt_compat::MbtJson::Number(at, _)) if (at - abs).abs() < 1.0 => ()
          _ => if line.trim() != "" { kept.push(line) }
        }
      }
      _ => if line.trim() != "" { kept.push(line) }
    }
  }
  rp_write(cstr(path), mbt_compat::utf8_encode(kept.join("\n") + (if kept.is_empty() { "" } else { "\n" }))) |> ignore
  match arr_search_double(marks, abs) {
    Option::Some(i) => arr_remove(marks, i) |> ignore
    Option::None => ()
  }
  data_changed()}

fn ago(at : Double) -> String {
  let s = ((rp_now() - at) / 1000.0).floor().to_int()
  if s < 5 {
    t("刚刚")
  } else if s < 60 {
    tf("{0} 秒前", [s.to_string()])
  } else if s < 3600 {
    tf("{0} 分钟前", [(s / 60).to_string()])
  } else if s % 3600 / 60 == 0 {
    tf("{0} 小时前", [(s / 3600).to_string()])
  } else {
    tf("{0} 小时 {1} 分前", [(s / 3600).to_string(), (s % 3600 / 60).to_string()])
  }}

fn month_day(m : Int, d : Int) -> String {
  let names = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
  tf("{0}月{1}日", [m.to_string(), d.to_string(), names[(m - 1) % 12]])}

fn local_day(at : Double) -> Int {
  ((at + rp_local_offset().to_double() * 60000.0) / 86400000.0).floor().to_int()}

fn day_name(at : Double) -> String {
  let d = local_day(at)
  let today = local_day(rp_now())
  if d == today {
    t("今天")
  } else if d == today - 1 {
    t("昨天")
  } else {
    let (_, m, dd) = civil_from_days(d)
    month_day(m, dd)
  }}
