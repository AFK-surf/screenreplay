import "mbt_compat"
import "motion"
import "pixels"
import "signals"
import "ui"
import "view"

fn app_name_usable(text : String) -> Bool {
  text != "" && !text.contains(" - ") && !text.contains(" — ") && !text.contains(" – ") && !text.contains(" | ") &&
  (text.contains(" ") || !text.contains(":"))
}

fn app_name(process : String) -> String {
  let key = str_to_ascii_lower(process)
  match app_names.get(key) {
    Option::Some(n) => return n
    Option::None => ()
  }
  let now = rp_now()
  if now - app_names_missed.get(key).unwrap_or(-10000.0) < 5000.0 {
    return process
  }
  let text = read_text(pjoin(pjoin(root_dir(), "AppIcons"), key + ".txt")).trim()
  // Ignore legacy AppIcons .txt entries containing document/page or internal scheme:id window titles.
  if !app_name_usable(text) {
    app_names_missed.set(key, now)
    return process
  }
  app_names.set(key, text)
  text}

fn app_at(at : Double) -> String {
  let abs = t0() + at
  let mut lo = 0
  let mut hi = apps.length()
  while lo < hi {
    let mid = (lo + hi) / 2
    if apps[mid].0 <= abs {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  if lo == 0 {
    ""
  } else {
    apps[lo - 1].1
  }}

fn recorded_runs() -> Array[(Double, Double)] {
  let base = t0()
  let runs : Array[(Double, Double)] = []
  for s in segs {
    let from = s.start - base
    let to = from + s.dur
    if runs.length() > 0 && from - runs[runs.length() - 1].1 <= 1500.0 {
      let last = runs[runs.length() - 1]
      runs[runs.length() - 1] = (last.0, dmax(last.1, to))
    } else {
      runs.push((from, to))
    }
  }
  runs}

fn app_pieces() -> Array[(Double, Double, String)] {
  let base = t0()
  let stretches : Array[(Double, Double, String)] = []
  for i, e in apps {
    let (at, app) = e
    let next = if i + 1 < apps.length() { apps[i + 1].0 } else { base + span() }
    stretches.push((dmax(0.0, at - base), next - base, app))
  }
  if stretches.is_empty() && !segs.is_empty() {
    stretches.push((0.0, span(), ""))
  } else if !stretches.is_empty() && stretches[0].0 > 0.0 {
    arr_insert(stretches, 0, (0.0, stretches[0].0, ""))
  }
  let runs = recorded_runs()
  let pieces : Array[(Double, Double, String)] = []
  for st in stretches {
    for r in runs {
      let from = dmax(st.0, r.0)
      let to = dmin(st.1, r.1)
      if to > from {
        pieces.push((from, to, st.2))
      }
    }
  }
  pieces}

fn stretch_at(at : Double) -> Option[(Double, Double)] {
  let ps = pieces_now.get()
  let mut k = -1
  for i, p in ps {
    if at >= p.0 && at < p.1 {
      k = i
    }
  }
  if k < 0 || ps[k].2 == "" {
    return Option::None
  }
  let app = ps[k].2
  let mut a = k
  while a > 0 && ps[a - 1].2 == app && ps[a].0 - ps[a - 1].1 <= 1500.0 {
    a -= 1
  }
  let mut z = k
  while z + 1 < ps.length() && ps[z + 1].2 == app && ps[z + 1].0 - ps[z].1 <= 1500.0 {
    z += 1
  }
  Option::Some((ps[a].0, ps[z].1))}

fn gaps() -> Array[(Double, Double)] {
  let base = t0()
  let out : Array[(Double, Double)] = []
  let mut end = 0.0
  for s in segs {
    let from = s.start - base
    if from - end > 1500.0 {
      out.push((end, from))
    }
    end = from + s.dur
  }
  out}

fn rect_d(x : Double, y : Double, w : Double, h : Double) -> String {
  let r = fn(v : Double) { (v * 10.0).round() / 10.0 }
  let x0 = r(x)
  let y0 = r(y)
  "M\{x0} \{y0}H\{r(x + w)}V\{r(y + h)}H\{x0}Z"}

fn layer(d : String, fill : Int64, stroke? : Int64, width? : Double) -> pixels::VectorPath {
  let stroke = match stroke { Some(__mbt_v) => __mbt_v, None => 0L }
  let width = match width { Some(__mbt_v) => __mbt_v, None => 0.0 }

  { d: d, fill: fill, stroke: stroke, width: width, even_odd: false, sx: 1.0, sy: 1.0, tx: 0.0, ty: 0.0 }}

fn hatch_d(x : Double, w : Double, h : Double) -> String {
  let b = StringBuilder()
  let r = fn(v : Double) { (v * 10.0).round() / 10.0 }
  let mut u = -h - 7.0 + ((x / 7.0).floor() * 7.0 - x) + x
  while u < x + w {
    let x0 = u
    let x1 = u + h
    let a = dmax(x0, x)
    let c = dmin(x1, x + w)
    if c > a {
      b.write_string("M\{r(a)} \{r(h - (a - x0))}L\{r(c)} \{r(h - (c - x0))}")
    }
    u += 7.0
  }
  b.to_string()}

fn drawn_spans(w : Double, from : Double, len : Double) -> Array[(Double, Double)] {
  let x_of = fn(at : Double) { clamp((at - from) / len * w, 0.0, w) }
  let out : Array[(Double, Double)] = []
  let mut last_end = -1.0e300
  let mut last_w = 0.0
  for p in pieces_now.get() {
    if p.1 <= from || p.0 >= from + len {
      continue
    }
    let a = x_of(p.0)
    let b = x_of(p.1)
    let touching = out.length() > 0 && p.0 - last_end <= 1.0
    if touching && (b - a < cut_min_w || last_w < cut_min_w) {
      let k = out.length() - 1
      out[k] = (out[k].0, b)
    } else {
      out.push((a, b))
    }
    last_end = p.1
    last_w = b - a
  }
  out}

fn grounds_picture(w : Double, from : Double, len : Double) -> Option[pixels::Vector] {
  if w <= 0.0 || len <= 0.0 || segs.is_empty() {
    return Option::None
  }
  let x_of = fn(at : Double) { clamp((at - from) / len * w, 0.0, w) }
  let fill = StringBuilder()
  let hatches = StringBuilder()
  let boxes = StringBuilder()
  for sp in drawn_spans(w, from, len) {
    let (a, b) = sp
    if b - a >= 2.0 {
      fill.write_string(rect_d(a, 0.0, b - a - 1.0, strip_h))
    }
  }
  for g in gaps_now.get() {
    if g.1 <= from || g.0 >= from + len {
      continue
    }
    let a = x_of(g.0)
    let b = x_of(g.1)
    if b - a >= 2.0 {
      hatches.write_string(hatch_d(a, b - a - 1.0, strip_h))
      boxes.write_string(rect_d(a + 0.5, 0.5, b - a - 2.0, strip_h - 1.0))
    }
  }
  let layers : Array[pixels::VectorPath] = []
  let fd = fill.to_string()
  if fd != "" {
    layers.push(layer(fd, c_s2()))
  }
  let hd = hatches.to_string()
  if hd != "" {
    layers.push(layer(hd, 0L, stroke=tone(0xFFFFFF17L, 0x00000017L), width=1.0))
  }
  let bd = boxes.to_string()
  if bd != "" {
    layers.push(layer(bd, 0L, stroke=hair(), width=1.0))
  }
  Option::Some({ w: w, h: strip_h, layers: layers })}

// Sample peaks on a time-aligned grid so panning translates without reshaping the waveform.
fn loud_picture(w : Double, from : Double, len : Double, ink : Int64) -> Option[pixels::Vector] {
  if w <= 0.0 || len <= 0.0 || segs.is_empty() {
    return Option::None
  }
  let cell = 3.0 / w * len
  let k0 = (from / cell).floor() - 1.0
  let k1 = ((from + len) / cell).ceil() + 1.0
  let n = (k1 - k0).to_int() + 1
  if n < 2 {
    return Option::None
  }
  let (raw, any_raw) = peaks_grid(k0, n, cell, false)
  if !any_raw {
    return Option::None
  }
  let r = fn(v : Double) { (v * 10.0).round() / 10.0 }
  let xs = mbt_compat::arr_makei(n, fn(i) { ((k0 + i.to_double()) * cell - from) / len * w })
  let top_y = Array::make(n, strip_h)
  let mut any = false
  for i in 0..<n {
    let s = (raw[imax(0, i - 1)] + 4 * raw[i] + raw[imin(n - 1, i + 1)]).to_double() / 6.0
    if s >= 26.0 {
      any = true
      // Input is -50..0 dB mapped to 0..255; gamma 1.6 prevents typical -20 dB audio from pegging the top.
      top_y[i] = r(strip_h - mbt_compat::math_pow(s / 255.0, 1.6) * (strip_h - 6.0))
    }
  }
  if !any {
    return Option::None
  }
  let all_d = StringBuilder()
  for sp in drawn_spans(w, from, len) {
    let a = sp.0
    let b = sp.1 - 1.0
    if b - a < 1.0 {
      continue
    }
    let i0 = imax(0, ((from + a / w * len) / cell - k0).floor().to_int() - 1)
    let i1 = imin(n - 1, ((from + b / w * len) / cell - k0).ceil().to_int() + 1)
    if i1 - i0 < 1 {
      continue
    }
    let mut piece_any = false
    for i in i0..=i1 {
      if top_y[i] < strip_h {
        piece_any = true
        break
      }
    }
    if !piece_any {
      continue
    }
    all_d.write_string("M\{r(clamp(xs[i0], a, b))} \{strip_h}")
    for i in i0..=i1 {
      all_d.write_string("L\{r(clamp(xs[i], a, b))} \{top_y[i]}")
    }
    all_d.write_string("L\{r(clamp(xs[i1], a, b))} \{strip_h}Z")
  }
  let d = all_d.to_string()
  let layers : Array[pixels::VectorPath] = if d == "" { [] } else { [layer(d, ink)] }
  Option::Some({ w: w, h: strip_h, layers: layers })}

fn heat_ink(v : Double) -> Int64 {
  let stops : Array[(Double, Int64)] = [(0.0, 0xFFC44000L), (0.3, 0xFFC4405CL), (0.65, 0xFF8C28A6L), (1.0, 0xEB3232D9L)]
  for k in 1..<stops.length() {
    let (b, cb) = stops[k]
    if v <= b {
      let (a, ca) = stops[k - 1]
      return mix(ca, cb, (v - a) / (b - a))
    }
  }
  stops[stops.length() - 1].1}

fn heat_pictures(w : Double, from : Double, len : Double) -> (Option[pixels::Vector], Option[pixels::Vector]) {
  if w <= 0.0 || len <= 0.0 || segs.is_empty() {
    return (None, None)
  }
  let cell = 2.0 / w * len
  let half = imax(4, (750.0 / cell).ceil().to_int())
  let k0 = (from / cell).floor() - 2.0 * half.to_double() - 1.0
  let n = ((from + len) / cell).ceil().to_int() - k0.to_int() + 2 * half + 2
  if n <= 4 * half + 1 {
    return (None, None)
  }
  let (raw, any) = peaks_grid(k0, n, cell, true)
  if !any {
    return (None, None)
  }
  let sum = Array::make(n + 1, 0.0)
  for i in 0..<n {
    sum[i + 1] = sum[i] + raw[i].to_double()
  }
  // Two-pass box filter (triangular kernel) to smooth bursty input spikes.
  let box = fn(sums : Array[Double], i : Int) {
    let lo = imax(0, i - half)
    let hi = imin(n - 1, i + half)
    (sums[hi + 1] - sums[lo]) / (hi - lo + 1).to_double()
  }
  let sum2 = Array::make(n + 1, 0.0)
  for i in 0..<n {
    sum2[i + 1] = sum2[i] + box(sum, i)
  }
  let steps = mbt_compat::arr_makei(n, fn(i) {
    let v = box(sum2, i)
    (dmin(1.0, v / 255.0) * heat_steps.to_double()).round().to_int()
  })
  let x_of = fn(at : Double) { clamp((at - from) / len * w, 0.0, w) }
  let paths = mbt_compat::arr_makei(heat_steps + 1, fn(_) { StringBuilder() })
  // Draw across continuous recorded runs (not per-app pieces) to avoid gaps at app switches.
  for p in runs_now.get() {
    if p.1 <= from || p.0 >= from + len {
      continue
    }
    let a = x_of(p.0)
    let b = x_of(p.1)
    if b - a < 1.0 {
      continue
    }
    let first = imax(0, ((from + a / w * len) / cell - k0).floor().to_int())
    let last = imin(n - 1, ((from + b / w * len) / cell - k0).ceil().to_int())
    let mut i = first
    while i <= last {
      let s = steps[i]
      let mut j = i + 1
      while j <= last && steps[j] == s {
        j += 1
      }
      if s > 0 {
        let x0 = clamp(((k0 + i.to_double()) * cell - from) / len * w, a, b)
        let x1 = clamp(((k0 + j.to_double()) * cell - from) / len * w, a, b)
        if x1 > x0 {
          // Overlap adjacent opaque runs by 0.75 pt to prevent anti-aliasing seam lines.
          paths[s].write_string(rect_d(x0, 0.0, dmin(b, x1 + 0.75) - x0, heat_h))
        }
      }
      i = j
    }
  }
  let bg = c_bg()
  let played_layers : Array[pixels::VectorPath] = []
  let ahead_layers : Array[pixels::VectorPath] = []
  for s in 1..=heat_steps {
    let d = paths[s].to_string()
    if d != "" {
      // Pre-composite opaque against c_bg() so 0.75 pt run overlaps do not double-blend.
      let c = heat_ink(s.to_double() / heat_steps.to_double())
      let a = (c & 0xFFL).to_double() / 255.0
      let solid = c | 0xFFL
      played_layers.push(layer(d, mix(bg, solid, a)))
      ahead_layers.push(layer(d, mix(bg, solid, a * 0.6)))
    }
  }
  (Some({ w: w, h: heat_h, layers: played_layers }), Some({ w: w, h: heat_h, layers: ahead_layers }))}

fn fine_words_w() -> Double {
  sf_node_words_w(".000", 11.0, weight=600).ceil()}

fn playhead(band : view::View, w : () -> Double) -> Unit {
  let fine = motion::NodeWay::new(0.0)
  let fine_w = fine_words_w()
  let cw = fn(v : view::View) { capsule_w + fine_w * fine.shown(v) }
  let x_drawn = fn(v : view::View) -> Option[Double] {
    let (from, len) = shown(v)
    let p = ax_d(pos_drawn(v), view_len())
    if p < from || p > from + len {
      None
    } else {
      Some(clamp((p - from) / len * w(), 1.0, dmax(1.0, w() - 1.0)))
    }
  }
  let cap_x = fn(v : view::View, x : Double) { clamp(x - cw(v) / 2.0, 0.0, dmax(0.0, w() - cw(v))) }
  let cap_h = 19.0
  let total_h = 23.0 + strip_h
  // Lift 0.5 pt to optically center digits (no descenders).
  let time = fn(b : view::View) {
    b.lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle)) |> ignore
    b.box(fn(lift) {
      lift.row(view::Live::Is(true)).padding(view::Live::Is((0.0, 0.0, 0.0, 0.5))) |> ignore
      words(lift, fn() { wall(t0() + pos_drawn(lift)) }, 11.0, ui_on_accent, weight=600) |> ignore
      lift.box(fn(m) {
        m.width(view::Live::By(fn() { Some(fine_w * fine.shown(m)) })).shrink(view::Live::Is(0.0)).clips(view::Live::Is(true)) |> ignore
        // Fixed-width inner box inside expanding clip container creates a wipe without re-wrapping text.
        m.box(fn(f) {
          f.width(view::Live::Is(Some(fine_w))).shrink(view::Live::Is(0.0)) |> ignore
          words(f, fn() { ms_words(t0() + pos_drawn(f)) }, 11.0, fn() { mix(clear(ui_on_accent()), ui_on_accent(), fine.shown(f)) }, weight=600)
          |> ignore
        })
        |> ignore
      })
      |> ignore
    })
    |> ignore
  }
  band.box(fn(layer) {
    layer.over(view::Live::Is(true)).presses(view::Live::Is(false)) |> ignore
    layer.show(fn() { has_segs() }, fn(ph) {
      ph.over(view::Live::Is(true)) |> ignore
      ph.reacts(fn() { fine_time.get() }, fn(on) { fine.go_ms(ph, if on { 1.0 } else { 0.0 }, if motion_off() { 1.0 } else { 160.0 }) })
      ph.box(fn(o) {
        o.over(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))) |> ignore
        o.box(fn(b) {
          // Memoize (width, stem_left) so the vector path only rebuilds near band edges or during ms animation.
          let shape = signals::computed_by(fn(_) {
            let c = cw(b)
            let x = x_drawn(b).unwrap_or(0.0)
            let cx = cap_x(b, x)
            let sl = clamp(x - 1.0 - cx, 0.0, dmax(0.0, c - 2.0))
            ((c * 20.0).round() / 20.0, (sl * 20.0).round() / 20.0)
          }, fn(a, b) { a == b })
          b
          .width(view::Live::By(fn() { Some(cw(b)) }))
          .height(view::Live::Is(Some(total_h)))
          .laid_nowhere(view::Live::By(fn() { x_drawn(b) is None }))
          .drawn_off(view::Live::By(fn() { (cap_x(b, x_drawn(b).unwrap_or(0.0)), -23.0) }), exact=true)
          .picture(view::Live::By(fn() {
            let (c, sl) = shape.get()
            Some(vector(playhead_path(c, cap_h, total_h, sl), c, total_h))
          }))
          .tint(view::Live::By(ui_accent))
          |> ignore
          b.box(fn(cap) {
            cap.width(view::Live::By(fn() { Some(cw(cap)) })).height(view::Live::Is(Some(cap_h))) |> ignore
            time(cap)
          })
          |> ignore
        })
        |> ignore
      })
      |> ignore
    }, at_once=true)
  })
  |> ignore}

// Single closed SVG path: squircle capsule joined via G1-continuous cubics to a 2 pt stem at sl,
// tapering to a flush flag when room near a band edge drops to 0.
fn playhead_path(w : Double, cap_h : Double, total_h : Double, sl : Double) -> String {
  let f = fn(v : Double) { (v * 100.0).round() / 100.0 }
  let q = 0.36
  let lim = dmin(w, cap_h) / 2.0
  let top_r = dmin(9.0, lim)
  let c_max = dmin(9.0, cap_h / 2.0)
  let f_max = 4.0
  let fy_max = 4.0
  let span_full = c_max + f_max
  let sr = sl + 2.0
  let dl = sl
  let dr = w - sr
  let b = StringBuilder()
  b.write_string("M\{f(top_r)} 0H\{f(w - top_r)}C\{f(w - top_r * q)} 0 \{f(w)} \{f(top_r * q)} \{f(w)} \{f(top_r)}")
  if dr <= 0.01 {
    b.write_string("V\{f(cap_h)}L\{f(sr)} \{f(cap_h)}V\{f(total_h)}")
  } else if dr >= span_full {
    b.write_string(
      "V\{f(cap_h - c_max)}C\{f(w)} \{f(cap_h - c_max * q)} \{f(w - c_max * q)} \{f(cap_h)} \{f(w - c_max)} \{f(cap_h)}H\{f(sr + f_max)}C\{f(sr + f_max * 0.32)} \{f(cap_h)} \{f(sr)} \{f(cap_h + fy_max * 0.36)} \{f(sr)} \{f(cap_h + fy_max)}V\{f(total_h)}",
    )
  } else {
    let t = dr / span_full
    let u_m = f_max * t
    let s_small = dmin(1.0, t / 0.45)
    let alpha = 1.5707963267948966 * (1.0 - (1.0 - s_small) * (1.0 - s_small))
    let tu = -mbt_compat::math_sin(alpha)
    let ty = mbt_compat::math_cos(alpha)
    let cy = c_max * (t * 0.65 + mbt_compat::math_pow(t, 0.72) * 0.35)
    let fy = fy_max * (t * 0.55 + mbt_compat::math_pow(t, 0.6) * 0.45)
    let l0 = cy * (1.0 - q)
    let du = dr - u_m
    let l1 = (du * du + cy * cy).sqrt() * 0.452548
    let l2 = (u_m * u_m + fy * fy).sqrt() * 0.480833
    let l3 = fy * (1.0 - 0.36)
    b.write_string(
      "V\{f(cap_h - cy)}C\{f(w)} \{f(cap_h - cy + l0)} \{f(sr + u_m - l1 * tu)} \{f(cap_h - l1 * ty)} \{f(sr + u_m)} \{f(cap_h)}C\{f(sr + u_m + l2 * tu)} \{f(cap_h + l2 * ty)} \{f(sr)} \{f(cap_h + fy - l3)} \{f(sr)} \{f(cap_h + fy)}V\{f(total_h)}",
    )
  }
  b.write_string("H\{f(sl)}")
  if dl <= 0.01 {
    b.write_string("V\{f(cap_h)}L0 \{f(cap_h)}V\{f(top_r)}")
  } else if dl >= span_full {
    b.write_string(
      "V\{f(cap_h + fy_max)}C\{f(sl)} \{f(cap_h + fy_max * 0.36)} \{f(sl - f_max * 0.32)} \{f(cap_h)} \{f(sl - f_max)} \{f(cap_h)}H\{f(c_max)}C\{f(c_max * q)} \{f(cap_h)} 0 \{f(cap_h - c_max * q)} 0 \{f(cap_h - c_max)}V\{f(top_r)}",
    )
  } else {
    let t = dl / span_full
    let u_m = f_max * t
    let s_small = dmin(1.0, t / 0.45)
    let alpha = 1.5707963267948966 * (1.0 - (1.0 - s_small) * (1.0 - s_small))
    let tu = -mbt_compat::math_sin(alpha)
    let ty = mbt_compat::math_cos(alpha)
    let cy = c_max * (t * 0.65 + mbt_compat::math_pow(t, 0.72) * 0.35)
    let fy = fy_max * (t * 0.55 + mbt_compat::math_pow(t, 0.6) * 0.45)
    let l0 = cy * (1.0 - q)
    let du = dl - u_m
    let l1 = (du * du + cy * cy).sqrt() * 0.452548
    let l2 = (u_m * u_m + fy * fy).sqrt() * 0.480833
    let l3 = fy * (1.0 - 0.36)
    b.write_string(
      "V\{f(cap_h + fy)}C\{f(sl)} \{f(cap_h + fy - l3)} \{f(sl - (u_m + l2 * tu))} \{f(cap_h + l2 * ty)} \{f(sl - u_m)} \{f(cap_h)}C\{f(sl - (u_m - l1 * tu))} \{f(cap_h - l1 * ty)} 0 \{f(cap_h - cy + l0)} 0 \{f(cap_h - cy)}V\{f(top_r)}",
    )
  }
  b.write_string("C0 \{f(top_r * q)} \{f(top_r * q)} 0 \{f(top_r)} 0Z")
  b.to_string()}

fn near_edge(at : Double, w : Double) -> Int {
  if !clipping.untracked() || w <= 0.0 {
    return 0
  }
  let room = 10.0 / w * signals::untracked(view_len)
  let near_a = (at - clip_a.untracked()).abs()
  let near_b = (at - clip_b.untracked()).abs()
  if near_a <= near_b && near_a < room {
    1
  } else if near_b < room {
    2
  } else {
    0
  }}

fn snap_to_clip(at : Double, w : Double) -> Double {
  if !clipping.untracked() || w <= 0.0 {
    return at
  }
  let room = 6.0 / w * signals::untracked(view_len)
  let (a, b) = (clip_a.untracked(), clip_b.untracked())
  if (at - a).abs() < room {
    a
  } else if (at - b).abs() < room {
    b
  } else {
    at
  }}

fn edge_speed(x : Double, w : Double) -> Double {
  if x < edge_room {
    -clamp((edge_room - x) / edge_room, 0.0, 2.0)
  } else if x > w - edge_room {
    clamp((x - (w - edge_room)) / edge_room, 0.0, 2.0)
  } else {
    0.0
  }}

fn edge_scroll(w : Double) -> Unit {
  if edge_running.v {
    return
  }
  guard band_node.v is Some(band) else { return }
  if edge_speed(edge_x.v, w) != 0.0 {
    edge_running.v = true
    let t = now()
    band.at_moment(t + 16.0, fn() { __mbt_local_edge_scroll_step_12(band, w, t) }, later=true) |> ignore
  }}

fn band_moved(x : Double, w : Double) -> Unit {
  let at = at_x(x, w)
  let g = grabbed.untracked()
  if (g == 1 || g == 2 || g == 4) && !clip_moved.v {
    if (x - band_down_x.v).abs() < 4.0 {
      return
    }
    clip_moved.v = true
  }
  match g {
    1 =>
      if at > clip_b.untracked() {
        let b = clip_b.untracked()
        clip_a.set(b)
        clip_b.set(clamp(at, b + 1000.0, span()))
        grabbed.set(2)
      } else {
        clip_a.set(clamp(at, 0.0, clip_b.untracked() - 1000.0))
      }
    2 =>
      if at < clip_a.untracked() {
        let a = clip_a.untracked()
        clip_b.set(a)
        clip_a.set(clamp(at, 0.0, a - 1000.0))
        grabbed.set(1)
      } else {
        clip_b.set(clamp(at, clip_a.untracked() + 1000.0, span()))
      }
    3 =>
      if scrub_dragged.untracked() || (x - band_down_x.v).abs() >= 4.0 {
        scrub_dragged.set(true)
        scrub_to(snap_to_clip(at, w))
      }
    4 => {
      let length = clip_b.untracked() - clip_a.untracked()
      let start = clamp(clip_origin.v + (at - band_down_at.v), 0.0, span() - length)
      clip_a.set(start)
      clip_b.set(start + length)
      clip_moved.v = true
    }
    _ => ()
  }}

fn band_drag(d : view::Drag, w : Double) -> Unit {
  if w <= 0.0 {
    return
  }
  let at = at_x(d.x, w)
  match d.kind {
    Down => {
      clip_mark()
      region_let_go()
      let edge = near_edge(at, w)
      let (a, b) = (clip_a.untracked(), clip_b.untracked())
      let inside = clipping.untracked() && edge == 0 && at > a && at < b
      clip_moved.v = false
      clip_origin.v = a
      // Record press x manually (raw drag events update origin to current position).
      band_down_x.v = d.x
      band_down_at.v = at
      scrub_dragged.set(false)
      grabbed.set(if edge != 0 { edge } else if inside { 4 } else { 3 })
      follow_latest.set(false)
      if grabbed.untracked() == 3 {
        band_drag_x.set(Some((clamp(d.x, 0.0, w) * 4.0).round() / 4.0))
        seek_to(at)
      } else {
        band_drag_x.set(None)
      }
    }
    Moved => {
      edge_x.v = d.x
      if grabbed.untracked() == 3 {
        band_drag_x.set(Some((clamp(d.x, 0.0, w) * 4.0).round() / 4.0))
      }
      band_moved(d.x, w)
      edge_scroll(w)
    }
    Up | Off => {
      let was = grabbed.untracked()
      let dragged = scrub_dragged.untracked()
      grabbed.set(0)
      band_drag_x.set(None)
      scrub_dragged.set(false)
      // Do not re-seek on simple click release (already sought on Down; re-seeking replays ~100 ms of audio).
      if d.kind == view::DragIs::Up && ((was == 3 && dragged) || (was == 4 && !clip_moved.v)) {
        seek_to(if was == 3 { snap_to_clip(at, w) } else { at })
      } else if d.kind == view::DragIs::Up && (was == 1 || was == 2) && !clip_moved.v {
        seek_to(if was == 1 { clip_a.untracked() } else { clip_b.untracked() })
      }
    }
  }}

fn block_wheel(e : view::Wheel, x : Double, w : Double) -> Unit {
  if w <= 0.0 || (e.dx == 0.0 && e.dy == 0.0) {
    return
  }
  let g = grabbed.untracked()
  let at_before = if g != 0 { at_x(x, w) } else { 0.0 }
  let len = signals::untracked(view_len)
  if (e.mods & (ui::wheel_mod_ctrl | ui::wheel_mod_cmd | ui::wheel_mod_pinch)) != 0 && e.dy != 0.0 {
    let (from, slen) = shown_now()
    zoom_about(mbt_compat::math_exp(-e.dy * 0.001), from + clamp(x / w, 0.0, 1.0) * slen)
  } else {
    pan_timeline((if e.dx != 0.0 { e.dx } else { e.dy }) * 0.0005 * len)
  }
  if g != 0 {
    let at_after = at_x(x, w)
    if (at_after - at_before).abs() > 0.5 {
      edge_x.v = x
      if g == 3 {
        scrub_dragged.set(true)
        band_drag_x.set(Some((clamp(x, 0.0, w) * 4.0).round() / 4.0))
      } else if g == 1 || g == 2 || g == 4 {
        clip_moved.v = true
      }
      band_moved(x, w)
    }
  }
}

fn timeline(parent : view::View) -> Unit {
  parent.by_room(fn(held, room) {
    hover_node.v = Some(held)
    held.padding(view::Live::Is((0.0, dock_over, 0.0, 0.0))) |> ignore
    let w = fn() { room.width() }
    held.on_wheel(fn(e) { block_wheel(e, e.x, room.width()) }) |> ignore
    held.presses(view::Live::Is(true)).on_drag(fn(d) { band_drag(d, room.width()) }, captures=true) |> ignore
    held.box(fn(band) {
      band_node.v = Some(band)
      band
      .height(view::Live::Is(Some(strip_h)))
      .presses(view::Live::Is(true))
      .cursor(view::Live::By(fn() {
        Some(
          match grabbed.get() {
            1 | 2 => view::Cursor::ResizeX
            3 | 4 => view::Cursor::Arrow
            _ =>
              match (clipping.get(), hover_now()) {
                (true, Some(x)) => {
                  let (_, len) = shown(band)
                  let at = at_x_drawn(band, x, w())
                  let room = 10.0 / w() * len
                  if (at - clip_a.get()).abs() < room || (at - clip_b.get()).abs() < room {
                    view::Cursor::ResizeX
                  } else if at > clip_a.get() && at < clip_b.get() {
                    view::Cursor::Arrow
                  } else {
                    view::Cursor::Arrow
                  }
                }
                _ => view::Cursor::Arrow
              }
          },
        )
      }))
      .on_drag(fn(d) { band_drag(d, signals::untracked(w)) }, captures=true)
      |> ignore
      band.box(fn(s) {
        s
        .over(view::Live::Is(true))
        .presses(view::Live::Is(false))
        .clips(view::Live::Is(true))
        |> ignore
        let dim = motion::NodeWay::new(if clipping.untracked() { 0.45 } else { 1.0 })
        s.reacts(fn() { clipping.get() }, fn(on) { dim.go_ms(s, if on { 0.45 } else { 1.0 }, if motion_off() { 1.0 } else { 160.0 }) })
        s
        .alpha(view::Live::By(fn() { dim.shown(s) }))
        |> ignore
        // Render 3x view width (1x overscan each side) so panning translates without rebuilding vectors.
        let cover = signals::computed_by(fn(_) {
          let (from, len) = shown(s)
          if view_resizing.get() {
            (from, len, w())
          } else {
            let at = (from / len).floor() * len
            (at - len, 3.0 * len, 3.0 * w())
          }
        }, fn(a, b) { a == b })
        let slid = fn(v : view::View) {
          let (from, len) = shown(v)
          ((cover.get().0 - from) / len * w(), 0.0)
        }
        s.box(fn(o) {
          o.over(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))) |> ignore
          o.box(fn(g) {
            g
            .height(view::Live::Is(Some(strip_h)))
            .width(view::Live::By(fn() { Some(cover.get().2) }))
            .drawn_off(view::Live::By(fn() { slid(g) }), exact=true)
            .picture(view::Live::By(fn() {
              data()
              let (at, len, cw) = cover.get()
              let g = ax_picture(cw, at, len, grounds_picture)
              match (g, seams_picture(cw, at, len, strip_h)) {
                (Some(p), Some(s)) => {
                  let ls = p.layers.copy()
                  arr_append(ls, s.layers)
                  Some(pixels::Vector::{ w: p.w, h: p.h, layers: ls })
                }
                (None, s) => s
                (p, None) => p
              }
            }))
            |> ignore
          })
          |> ignore
        })
        |> ignore
        current_piece(s, w)
        // During overview drag, keep existing 3x cover until viewport exits it to avoid per-move rebuilds.
        let loud_held : mbt_compat::Ref[Option[(Double, Double, Double)]] = mbt_compat::ref_new(None)
        let loud_cover = signals::computed_by(fn(_) {
          let c = cover.get()
          let (from, len) = shown(s)
          match (view_dragging.get(), loud_held.v) {
            (true, Some(h)) if h.1 == c.1 && h.2 == c.2 && from >= h.0 && from + len <= h.0 + h.1 => h
            _ => {
              loud_held.v = Some(c)
              c
            }
          }
        }, fn(a, b) { a == b })
        let loud_slid = fn(v : view::View) {
          let (from, len) = shown(v)
          ((loud_cover.get().0 - from) / len * w(), 0.0)
        }
        let loud = signals::computed_ref(fn(_) {
          data()
          let (at, len, cw) = loud_cover.get()
          ax_picture(cw, at, len, fn(w, f, l) { loud_picture(w, f, l, 0x000000FFL) })
        })
        let heat_both = signals::computed_ref(fn(_) {
          data()
          let (at, len, cw) = loud_cover.get()
          if axis_now.get() is None {
            heat_pictures(cw, at, len)
          } else {
            (
              ax_picture(cw, at, len, fn(w, f, l) { heat_pictures(w, f, l).0 }),
              ax_picture(cw, at, len, fn(w, f, l) { heat_pictures(w, f, l).1 }),
            )
          }
        })
        let head_x = fn(v : view::View) {
          let (from, len) = shown(v)
          clamp((ax_d(pos_drawn(v), view_len()) - from) / len * w(), 0.0, w())
        }
        for played in [true, false] {
          band.box(fn(o) {
            // Clip outer container to band width so the played-side overscan cannot bleed left past the band.
            o
            .over(view::Live::Is(true))
            .presses(view::Live::Is(false))
            .lines_up(view::Live::Is(Some(view::Along::Start)))
            .offset(view::Live::Is((0.0, -heat_gap - heat_h)))
            .width(view::Live::By(fn() { Some(w()) }))
            .height(view::Live::Is(Some(heat_h)))
            .clips(view::Live::Is(true))
            |> ignore
            // Clip at playhead via opposing drawn_off transforms so playback never triggers relayout.
            o.box(fn(c) {
              c
              .height(view::Live::Is(Some(heat_h)))
              .clips(view::Live::Is(true))
              .width(view::Live::By(fn() { Some(w()) }))
              .drawn_off(view::Live::By(fn() { (if played { head_x(c) - w() } else { head_x(c) }, 0.0) }), exact=true)
              |> ignore
              c.box(fn(l) {
                l
                .width(view::Live::By(fn() { Some(loud_cover.get().2) }))
                .height(view::Live::Is(Some(heat_h)))
                .drawn_off(
                  view::Live::By(fn() { ((if played { w() - head_x(l) } else { -head_x(l) }) + loud_slid(l).0, 0.0) }),
                  exact=true,
                )
                .picture(view::Live::By(fn() { if played { heat_both.get().0 } else { heat_both.get().1 } }))
                |> ignore
              })
              |> ignore
            })
            |> ignore
          })
          |> ignore
        }
        s.box(fn(o) {
          o.over(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))) |> ignore
          o.box(fn(l) {
            l
            .height(view::Live::Is(Some(strip_h)))
            .width(view::Live::By(fn() { Some(loud_cover.get().2) }))
            .drawn_off(view::Live::By(fn() { loud_slid(l) }), exact=true)
            .picture(view::Live::By(fn() { loud.get() }))
            .tint(view::Live::By(fn() { tone(0xEDEEF033L, 0x17181B29L) }))
            |> ignore
          })
          |> ignore
        })
        |> ignore
        s.box(fn(cut) {
          cut
          .over(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Start)))
          |> ignore
          let played = fn(v : view::View) {
            let (from, len) = shown(v)
            clamp((ax_d(pos_drawn(v), view_len()) - from) / len * w(), 0.0, w())
          }
          cut.box(fn(c) {
            c
            .height(view::Live::Is(Some(strip_h)))
            .clips(view::Live::Is(true))
            .width(view::Live::By(fn() { Some(w()) }))
            .drawn_off(view::Live::By(fn() { (played(c) - w(), 0.0) }), exact=true)
            |> ignore
            c.box(fn(l) {
              l
              .width(view::Live::By(fn() { Some(loud_cover.get().2) }))
              .height(view::Live::Is(Some(strip_h)))
              .drawn_off(view::Live::By(fn() { (w() - played(l) + loud_slid(l).0, 0.0) }), exact=true)
              .picture(view::Live::By(fn() { loud.get() }))
              .tint(view::Live::By(fn() { tone(0xEDEEF046L, 0x17181B37L) }))
              |> ignore
            })
            |> ignore
          })
          |> ignore
        })
        |> ignore
        time_ticks(s, w)
        piece_labels(s, w)
        gap_labels(s, w)
        s.box(fn(o) {
          o.over(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))) |> ignore
          o.box(fn(g) {
            g
            .height(view::Live::Is(Some(strip_h)))
            .width(view::Live::By(fn() { Some(cover.get().2) }))
            .drawn_off(view::Live::By(fn() { slid(g) }), exact=true)
            .picture(view::Live::By(fn() {
              data()
              let (at, len, cw) = cover.get()
              let f = app_filter.get()
              ax_picture(cw, at, len, fn(w, from, l) { filter_dim_picture(w, from, l, f) })
            }))
            |> ignore
          })
          |> ignore
        })
        |> ignore
      })
      |> ignore
      marks_layer(band, w)
      clip_layer(band, w)
      hover_line(band, w)
      playhead(band, w)
      away_chip(band, w)
      band
      .on_menu(fn(m) { open_moment_menu(m.wx, m.wy, at_x(m.x, signals::untracked(w)), false) })
      |> ignore
      hover_card(band, w)
      seam_tip(band, w)
    })
    |> ignore
    window_strip(held, w)
    overview(held)
  })
  |> ignore}
fn __mbt_local_edge_scroll_step_12(band : view::View, w : Double, last : Double) -> Unit {
    let g = grabbed.untracked()
    let v = edge_speed(edge_x.v, w)
    if !clipping.untracked() || (g != 1 && g != 2 && g != 4) || v == 0.0 {
      edge_running.v = false
      return
    }
    let t = now()
    let dt = clamp(t - last, 0.0, 50.0)
    pan_timeline(v * signals::untracked(view_len) * dt / 1000.0)
    band_moved(edge_x.v, w)
    band.at_moment(t + 16.0, fn() { __mbt_local_edge_scroll_step_12(band, w, t) }, later=true) |> ignore
  }


