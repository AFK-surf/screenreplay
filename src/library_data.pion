import "mbt_compat"
import "ui"
import "hostapi"

fn clips_dir() -> String {
  env_or("REPLAY_OUT", {
    if is_mac() {
      pjoin(ui::env("HOME"), "Movies/ScreenReplay")
    } else {
      // Preserve existing "回放" folder even when UI language is English.
      let videos = ui::env("USERPROFILE") + "\\Videos\\"
      if is_english() && rp_size(cstr(videos + "回放")) < 0.0 { videos + "Replay" } else { videos + "回放" }
    }
  })}

fn load_clips() -> Unit {
  clip_files.clear()
  let names = mbt_compat::utf8_decode_lossy(rp_list_clips(cstr(clips_dir())))
  for name in names.split("\n") {
    // Clean up orphaned partial exports when no export is running.
    if name.ends_with(".partial.mp4") || name.ends_with(".partial.gif") {
      if export_out.untracked() == "" {
        rp_delete(cstr(pjoin(clips_dir(), name)))
      }
      continue
    }
    if name != "" { clip_files.push(name) }
  }
  arr_sort_by(clip_files, fn(a, b) { if b < a { -1 } else if b > a { 1 } else { 0 } })
  clips_gone_forget(clips_dir(), clip_files)
  library_page.set(imin(library_page.untracked(), imax(0, (clip_files.length() - 1) / clips_per_page)))}

fn clip_duration(path : String) -> Double {
  match clip_durations.get(path) {
    Option::Some(ms) => ms
    Option::None => {
      let ms = rp_duration(cstr(path))
      clip_durations.set(path, ms)
      ms
    }
  }}

fn clip_title(name : String) -> String {
  let stem = str_replace_all(name, ".mp4", "")
  if stem.ends_with(".gif") {
    return clip_title(str_replace_all(stem, ".gif", "")) + " · GIF"
  }
  let pfx = "回放 "
  let stem = if stem.starts_with("Replay ") { pfx + stem.slice(7, stem.length()) } else { stem }
  if !stem.starts_with(pfx) {
    return stem
  }
  let o = pfx.length() + 5
  match (digits(stem, o, 2), digits(stem, o + 3, 2), digits(stem, o + 6, 2), digits(stem, o + 9, 2), digits(stem, o + 12, 2)) {
    (Some(m), Some(d), Some(h), Some(mi), Some(s)) => month_day(m, d) + " \{two(h)}:\{two(mi)}:\{two(s)}"
    _ => stem
  }}

fn clip_length(path : String) -> Double {
  if is_gif_path(path) && track_of(path, "vide") is Some(_) {
    return dmax(1.0, gif_lengths.get(path).unwrap_or(1.0))
  }
  match track_of(path, "vide") {
    Option::Some(t) => {
      let n = t.samples.length()
      let last = sample_ms(t, n - 1)
      let step = if n > 1 { (last - sample_ms(t, 0)) / (n - 1).to_double() } else { 0.0 }
      dmax(1.0, last + step)
    }
    Option::None => 1.0
  }}

fn open_clip_player(path : String) -> Unit {
  if av1_unplayable(path) {
    av1_note.set(path)
    return
  }
  if !plays_here(path) {
    return
  }
  let gif = is_gif_path(path)
  close_clip_player()
  set_playing(false)
  let length = clip_length(path)
  let d = Deck::new(count=fn() { 1 }, file=fn(_) { path }, start=fn(_) { 0.0 }, dur=fn(_) { length }, span=fn() { length }, play=clip_play, speed=fn() { clip_speed.untracked() }, wants=fn() { clip_view_playing.untracked() }, held=fn() { clip_held.untracked() }, ended=if gif { fn() { clip_seek(0.0) } } else { clip_ended }, shape=clip_aspect)
  clip_deck.v = Some(d)
  // Index timestamps are file-relative, so include the edit-list lead offset.
  if !gif {
    rp_idx_add_clip(cstr(path), length + clip_lead(path))
  }
  clip_modified.v = rp_modified(cstr(path))
  clip_play.set(Play::{ pos: 0.0, at: now(), rate: clip_speed.untracked(), going: false })
  clip_done.set(false)
  clip_view_playing.set(true)
  clip_playing.set(path)
  d.go(0.0, false)}

fn set_clip_speed(r : Double) -> Unit {
  clip_speed.set(r)
  match clip_deck.v {
    Some(d) => d.set_rate(r)
    None => ()
  }}

fn clip_seek(at : Double) -> Unit {
  guard clip_deck.v is Some(d) else { return }
  clip_done.set(false)
  d.go(clamp(at, 0.0, (d.span)()), false)}

fn clip_pause() -> Unit {
  if clip_view_playing.untracked() {
    clip_toggle()
  }}

fn clip_step(dir : Int) -> Unit {
  guard clip_deck.v is Some(d) else { return }
  guard track_of(clip_playing.untracked(), "vide") is Some(t) else { return }
  clip_pause()
  let k = clamp_int(sample_at(t, d.pos() + 0.5) + dir, 0, t.samples.length() - 1)
  clip_seek(sample_ms(t, k))}

fn clamp_int(v : Int, lo : Int, hi : Int) -> Int {
  imax(lo, imin(hi, v))}

fn clip_beside(dir : Int) -> Option[String] {
  let path = clip_playing.untracked()
  let mut i = -1
  for k, name in clip_files {
    if pjoin(clips_dir(), name) == path {
      i = k
    }
  }
  if i < 0 {
    return Option::None
  }
  let mut k = i + dir
  while k >= 0 && k < clip_files.length() {
    let p = pjoin(clips_dir(), clip_files[k])
    if plays_here(p) {
      return Option::Some(p)
    }
    k += dir
  }
  Option::None}

fn clip_go_beside(dir : Int) -> Unit {
  match clip_beside(dir) {
    Option::Some(p) => open_clip_player(p)
    Option::None => ()
  }}

fn plays_here(path : String) -> Bool {
  if is_gif_path(path) {
    return track_of(path, "vide") is Some(_)
  }
  !is_av1_clip(path) || hostapi::av1_here()}

fn is_av1_clip(path : String) -> Bool {
  if path.ends_with(".gif") {
    return false
  }
  // Cache header-only codec probe to avoid re-parsing full sample tables per library card.
  match saved_clip_codecs.get(path) {
    Option::Some(c) => c == "av01"
    Option::None => {
      let c = mp4_video_codec(path)
      // Don't cache empty codec while file is still being written.
      if c != "" {
        saved_clip_codecs.set(path, c)
      }
      c == "av01"
    }
  }}

fn av1_unplayable(path : String) -> Bool {
  is_av1_clip(path) && !hostapi::av1_here()}

fn clip_ended() -> Unit {
  tell_playing(clip_view_playing.untracked(), false, told=clip_told)
  clip_view_playing.set(false)
  clip_done.set(true)
  match clip_deck.v {
    Some(d) => d.set_playing(false)
    None => ()
  }}

fn clip_toggle() -> Unit {
  guard clip_deck.v is Some(d) else { return }
  let on = !clip_view_playing.untracked()
  tell_playing(!on, on, told=clip_told)
  clip_view_playing.set(on)
  if on && (clip_done.untracked() || d.pos() >= (d.span)() - 100.0) {
    clip_done.set(false)
    d.go(0.0, false)
  } else {
    d.set_playing(on)
  }}

fn close_clip_player() -> Unit {
  match clip_deck.v {
    Some(d) => d.close()
    None => ()
  }
  clip_deck.v = None
  clip_view_playing.set(false)
  clip_held.set(false)
  let was = clip_playing.untracked()
  if was != "" {
    rp_idx_drop(cstr(was))
    rp_gif_drop(cstr(was))
  }
  clip_playing.set("")}

fn clip_frame_key(path : String, at : Double) -> String {
  if is_gif_path(path) {
    return gif_frame_key(path, at)
  }
  let p = cstr(path)
  // Convert clip-relative time to file-relative index time.
  let at = at + clip_lead(path)
  let ms = rp_idx_at(p, at)
  if ms < 0.0 {
    return ""
  }
  // Include mtime so overwritten clips don't hit stale cached thumbnails.
  let key = "cx:\{path}|\{clip_modified.v}:\{ms}"
  if !ui::image_bytes_for(key).is_some() {
    let jpeg = rp_idx_jpeg(p, at)
    if jpeg.length() == 0 {
      return ""
    }
    ui::add_image(key, jpeg)
    hover_images.keep(key)
  }
  key}
