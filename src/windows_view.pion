import "mbt_compat"
import "motion"
import "pixels"
import "signals"
import "view"

fn picker_snap(v : view::View, w : Double) -> Option[(Snap, Double)] {
  data()
  let abs = t0() + pos_drawn(v)
  match snap_at(abs) {
    Option::Some(s) if s.sw > 0.0 && w > 0.0 => Option::Some((s, w / s.sw))
    _ => Option::None
  }}

fn picker_under(v : view::View, w : Double) -> Option[Win] {
  match picker_layer.v {
    Some(l) if l.pointer_within() && !layer_over() => ()
    _ => return Option::None
  }
  match (picker_at.get(), picker_snap(v, w)) {
    (Some((x, y)), Some((s, k))) => window_under(t0() + pos_drawn(v), s.sx + x / k, s.sy + y / k)
    _ => Option::None
  }}

fn hover_window(v : view::View, w : Double) -> Option[Win] {
  if clip_kind.get() != 1 || region_grab.get() != 0 {
    return Option::None
  }
  match (region_on(), picker_at.get()) {
    (Some(r), Some((x, y))) => {
      let (sw, _) = rec_size()
      if sw > 0.0 && region_hit(r, w / sw, x, y) is Some(_) {
        return Option::None
      }
    }
    _ => ()
  }
  picker_under(v, w)}

fn window_picker(pic : view::View) -> Unit {
  pic.by_room(fn(lay, room) {
    picker_layer.v = Some(lay)
    let w = fn() { room.width() }
    let click = fn(x : Double, y : Double) {
      if snaps.is_empty() {
        set_playing(!want_play.untracked())
        return
      }
      let under = signals::untracked(fn() {
        match picker_snap(lay, room.width()) {
          Option::Some((s, k)) => window_under(t0() + pos_drawn(lay), s.sx + x / k, s.sy + y / k)
          Option::None => None
        }
      })
      match under {
        Some(u) if u.hwnd == picked_hwnd.untracked() => pick_window(Option::None)
        _ => pick_window(under)
      }
    }
    lay
    .over(view::Live::Is(true))
    .presses(view::Live::By(fn() { clipping.get() && clip_kind.get() != 0 }))
    .cursor(view::Live::By(fn() {
      if !clipping.get() {
        return Some(view::Cursor::Arrow)
      }
      if clip_kind.get() == 1 {
        return Some(if hover_window(lay, w()) is Some(_) { view::Cursor::Arrow } else { view::Cursor::Arrow })
      }
      let (sw, _) = rec_size()
      match region_cursor(if sw > 0.0 { w() / sw } else { 1.0 }, picker_at.get()) {
        Option::Some(c) => Some(c)
        Option::None => Some(view::Cursor::Crosshair)
      }
    }))
    .on_pointer_moved(fn() {
      (pointer_moved.v)()
      picker_at.set(lay.pointer_here())
    })
    .on_drag(fn(d) { region_drag(d, room.width(), click, signals::untracked(fn() { clip_kind.get() == 2 })) }, captures=true)
    |> ignore
    lay.show(fn() { clipping.get() }, fn(o) {
      o.over(view::Live::Is(true)).presses(view::Live::Is(false)).lines_up(view::Live::Is(Some(view::Along::Start))) |> ignore
      let h = fn() { w() / picture_aspect.get() }
      let to_view = fn(s : Snap, k : Double, r : (Double, Double, Double, Double)) {
        ((r.0 - s.sx) * k, (r.1 - s.sy) * k, r.2 * k, r.3 * k)
      }
      o.box(fn(p) {
        p
        .width(view::Live::By(fn() { Some(w()) }))
        .height(view::Live::By(fn() { Some(h()) }))
        .picture(view::Live::By(fn() {
          let width = w()
          let height = h()
          let layers : Array[pixels::VectorPath] = []
          // Omit border edges flush with the picture boundary so they don't protrude as an outer rim.
          let frame = fn(r : (Double, Double, Double, Double), fill : Int64) {
            let (rx, ry, rw, rh) = r
            if fill != 0L {
              layers.push(layer(rect_d(rx, ry, rw, rh), fill))
            }
            let top = ry > 0.5
            let left = rx > 0.5
            let right = rx + rw < width - 0.5
            let bottom = ry + rh < height - 0.5
            let side = fn(x : Double, y : Double, sw : Double, sh : Double, ink : Int64) {
              layers.push(layer(rect_d(x, y, sw, sh), ink))
            }
            let white = 0xEDEEF0E6L
            if top {
              side(rx - 2.0, ry - 2.0, rw + 4.0, 1.0, over_picture_edge)
              side(rx - 1.0, ry - 1.0, rw + 2.0, 2.0, white)
            }
            if bottom {
              side(rx - 2.0, ry + rh + 1.0, rw + 4.0, 1.0, over_picture_edge)
              side(rx - 1.0, ry + rh - 1.0, rw + 2.0, 2.0, white)
            }
            if left {
              side(rx - 2.0, ry - 2.0, 1.0, rh + 4.0, over_picture_edge)
              side(rx - 1.0, ry - 1.0, 2.0, rh + 2.0, white)
            }
            if right {
              side(rx + rw + 1.0, ry - 2.0, 1.0, rh + 4.0, over_picture_edge)
              side(rx + rw - 1.0, ry - 1.0, 2.0, rh + 2.0, white)
            }
          }
          let shade = 0x08090A99L
          // Single opposite-wound cutout path (4 separate rects leave subpixel AA light seams at 150% DPI).
          let shade_round = fn(r : (Double, Double, Double, Double)) {
            let (rx, ry, rw, rh) = r
            let x0 = clamp(rx, 0.0, width)
            let y0 = clamp(ry, 0.0, height)
            let x1 = clamp(rx + rw, x0, width)
            let y1 = clamp(ry + rh, y0, height)
            let hole = "M\{x0} \{y0}V\{y1}H\{x1}V\{y0}Z"
            layers.push(layer(rect_d(0.0, 0.0, width, height) + hole, shade))
          }
          let snap = picker_snap(p, width)
          match region_on() {
            Option::Some(r) => {
              let (sw, _) = rec_size()
              let k = if sw > 0.0 { width / sw } else { 1.0 }
              let v = (r.0 * k, r.1 * k, r.2 * k, r.3 * k)
              let (rx, ry, rw, rh) = v
              shade_round(v)
              if region_grab.get() != 0 {
                let third = 0xFFFFFF47L
                for i in 1..<3 {
                  let f = i.to_double() / 3.0
                  layers.push(layer(rect_d(rx + rw * f - 0.5, ry, 1.0, rh), third))
                  layers.push(layer(rect_d(rx, ry + rh * f - 0.5, rw, 1.0), third))
                }
              }
              let line = 0xEDEEF0E6L
              let white = 0xEDEEF0FFL
              let rim = 0x00000073L
              if ry > 0.5 {
                layers.push(layer(rect_d(rx - 1.0, ry - 1.0, rw + 2.0, 1.0), line))
              }
              if ry + rh < height - 0.5 {
                layers.push(layer(rect_d(rx - 1.0, ry + rh, rw + 2.0, 1.0), line))
              }
              if rx > 0.5 {
                layers.push(layer(rect_d(rx - 1.0, ry, 1.0, rh), line))
              }
              if rx + rw < width - 0.5 {
                layers.push(layer(rect_d(rx + rw, ry, 1.0, rh), line))
              }
              let mark = fn(d : String) {
                layers.push(layer(d, 0L, stroke=rim, width=2.0))
                layers.push(layer(d, white))
              }
              let (arm, thick) = (12.0, 3.0)
              for hx in [-1, 1] {
                for hy in [-1, 1] {
                  let sx = hx.to_double()
                  let sy = hy.to_double()
                  let ex = if hx < 0 { rx } else { rx + rw }
                  let ey = if hy < 0 { ry } else { ry + rh }
                  let px = clamp(ex + sx * thick, 0.0, width)
                  let py = clamp(ey + sy * thick, 0.0, height)
                  let ax = px - sx * arm
                  let ay = py - sy * arm
                  let ix = px - sx * thick
                  let iy = py - sy * thick
                  mark("M\{px} \{py}H\{ax}V\{iy}H\{ix}V\{ay}H\{px}Z")
                }
              }
              if region_selected.get() || region_grab.get() != 0 {
                let (bar, half) = (16.0, 8.0)
                let mx = rx + rw / 2.0
                let my = ry + rh / 2.0
                mark(rect_d(mx - half, clamp(ry - 2.0, 0.0, height - thick), bar, thick))
                mark(rect_d(mx - half, clamp(ry + rh - 1.0, 0.0, height - thick), bar, thick))
                mark(rect_d(clamp(rx - 2.0, 0.0, width - thick), my - half, thick, bar))
                mark(rect_d(clamp(rx + rw - 1.0, 0.0, width - thick), my - half, thick, bar))
              }
            }
            Option::None =>
              if picked_hwnd.get() != 0L {
                match snap {
                  Option::Some((s, k)) =>
                    match picked_rect(s) {
                      Option::Some(r) => {
                        let v = to_view(s, k, r)
                        shade_round(v)
                        frame(v, 0L)
                      }
                      Option::None => layers.push(layer(rect_d(0.0, 0.0, width, height), shade))
                    }
                  Option::None => ()
                }
              }
          }
          match (snap, hover_window(p, width)) {
            (Some((s, k)), Some(u)) if u.hwnd != picked_hwnd.get() =>
              match intersect((u.x, u.y, u.w, u.h), (s.sx, s.sy, s.sw, s.sh)) {
                Option::Some(r) => frame(to_view(s, k, r), ui_accent_faint())
                Option::None => ()
              }
            _ => ()
          }
          if layers.is_empty() {
            return None
          }
          Some({ w: width, h: height, layers: layers })
        }))
        |> ignore
      })
      |> ignore
      let tag = fn(v : view::View) -> Option[(Double, Double, String, String)] {
        guard picker_snap(v, w()) is Some((s, k)) else { return None }
        match hover_window(v, w()) {
          Option::Some(u) if u.hwnd != picked_hwnd.get() =>
            match intersect((u.x, u.y, u.w, u.h), (s.sx, s.sy, s.sw, s.sh)) {
              Option::Some(r) => {
                let (rx, ry, _, _) = to_view(s, k, r)
                return Some((rx + 8.0, ry + 8.0, tf("点击只导出 {0}", [win_label(u)]), u.process))
              }
              Option::None => ()
            }
          _ => ()
        }
        if picked_hwnd.get() != 0L {
          match picked_rect(s) {
            Option::Some(r) => {
              let (rx, ry, _, _) = to_view(s, k, r)
              Some((rx + 8.0, ry + 8.0, picked_name.get(), picked_process.get()))
            }
            Option::None => Some((w() / 2.0 - 120.0, h() / 2.0 - 13.0, tf("这时 {0} 不在屏幕上", [picked_name.get()]), ""))
          }
        } else {
          None
        }
      }
      o.box(fn(t) {
        t.over(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))) |> ignore
        t.box(fn(b) {
          b
          .row(view::Live::Is(true))
          .height(view::Live::Is(Some(26.0)))
          .padding(view::Live::Is((9.0, 0.0, 9.0, 0.0)))
          .gap(view::Live::Is(7.0))
          .radius(view::Live::Is(6.0))
          .ground(view::Live::Is(0x0E0F11DBL))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .laid_nowhere(view::Live::By(fn() { tag(b) is None }))
          .offset(view::Live::By(fn() {
            match tag(b) {
              Some((x, y, _, _)) => (x, y)
              None => (0.0, 0.0)
            }
          }))
          |> ignore
          b.pick(fn() { opt_map(tag(b), fn(x) { x.3 }).unwrap_or("") }, fn(i, p) { if p != "" { app_icon(i, p) } }, at_once=true)
          words(b, fn() { opt_map(tag(b), fn(x) { x.2 }).unwrap_or("") }, 12.0, fn() { 0xEDEEF0FFL }, weight=500) |> ignore
        })
        |> ignore
      })
      |> ignore
      o.box(fn(t) {
        t.over(view::Live::Is(true)).presses(view::Live::Is(false)).lines_up(view::Live::Is(Some(view::Along::Start))) |> ignore
        t.box(fn(b) {
          let at = fn() -> Option[(Double, Double)] {
            guard region_on() is Some(r) else { return None }
            let (sw, _) = rec_size()
            let k = if sw > 0.0 { w() / sw } else { 1.0 }
            let (rx, ry) = (r.0 * k, r.1 * k)
            Some(if ry >= 30.0 { (rx, ry - 28.0) } else { (rx + 8.0, ry + 8.0) })
          }
          b
          .row(view::Live::Is(true))
          .height(view::Live::Is(Some(22.0)))
          .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
          .radius(view::Live::Is(6.0))
          .ground(view::Live::Is(0x0E0F11DBL))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .laid_nowhere(view::Live::By(fn() { at() is None }))
          .offset(view::Live::By(fn() { at().unwrap_or((0.0, 0.0)) }))
          |> ignore
          words(b, region_label, 12.0, fn() { 0xEDEEF0FFL }, weight=500) |> ignore
        })
        |> ignore
      })
      |> ignore
    }, at_once=true)
  })
  // Overlay on pic (otherwise laid out with 0 height in column and clicks fall through to player).
  .over(view::Live::Is(true))
  |> ignore}

fn window_note() -> (String, String, Bool) {
  if picked_hwnd.get() == 0L {
    return ("", "", false)
  }
  let mut absent = 0.0
  let mut covered = 0.0
  let mut longest = 0.0
  let mut present = 0.0
  for r in picked_runs(clip_a.get(), clip_b.get()) {
    if r.2 == 0 {
      absent += r.1 - r.0
    } else {
      present += r.1 - r.0
      if r.2 == 1 {
        covered += r.1 - r.0
      } else {
        longest = dmax(longest, r.1 - r.0)
      }
    }
  }
  if absent >= 1000.0 {
    (tf("有 {0} 不在屏幕上", [clock(absent)]), tf("只留有画面的 {0}", [clock(present)]), false)
  } else if covered >= 1000.0 {
    (tf("有 {0} 被遮住", [clock(covered)]), tf("只留完整可见的 {0}", [clock(longest)]), true)
  } else {
    ("", "", false)
  }}

fn window_bar(parent : view::View) -> Unit {
  segmented(parent, fn() { [t("整屏"), t("选窗口"), t("框选区域")] }, fn() { clip_kind.get() }, set_clip_kind)
  parent.box(fn(g) { g.width(view::Live::Is(Some(8.0))) |> ignore }) |> ignore
  parent.pick(fn() {
    match clip_kind.get() {
      1 => if picked_hwnd.get() != 0L { 2 } else { 1 }
      2 => if region_on() is Some(_) { 4 } else { 3 }
      _ => 0
    }
  }, fn(b, kind) {
    b.row(view::Live::Is(true)).gap(view::Live::Is(10.0)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
    match kind {
      0 => {
        words(b, fn() { t("导出整个画面") }, 12.0, ui_subtle) |> ignore
        return
      }
      1 => {
        words(b, fn() { t("在画面上点一个窗口，只导出它") }, 12.0, ui_subtle) |> ignore
        return
      }
      3 => {
        words(b, fn() { t("在画面上拖出一个区域") }, 12.0, ui_subtle) |> ignore
        return
      }
      4 => {
        region_chip(b)
        return
      }
      _ => ()
    }
    b.box(fn(chip) {
      chip.row(view::Live::Is(true)).height(view::Live::Is(Some(28.0))).padding(view::Live::Is((9.0, 0.0, 6.0, 0.0))).gap(view::Live::Is(8.0)).radius(view::Live::Is(6.0)).ground(view::Live::By(c_s2)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
      chip.pick(fn() { picked_process.get() }, fn(i, p) { app_icon(i, p) }, at_once=true)
      words(chip, fn() { tf("只导出 {0}", [app_name(picked_process.get())]) }, 12.0, ui_text, weight=500) |> ignore
      icon_button(chip, fn() { "close" }, fn() { t("改回整屏") }, fn() { pick_window(Option::None) }, w=18.0, h=18.0, size=10.0) |> ignore
    })
    |> ignore
    words(b, fn() { window_note().0 }, 12.0, warn) |> ignore
    b.show(fn() { window_note().1 != "" }, fn(x) {
      pressable(x, fn() { window_note().1 }, fn() { trim_to_window(signals::untracked(window_note).2) }, fn(f) {
        f.gap(view::Live::Is(2.0)) |> ignore
        words(f, fn() { window_note().1 }, 12.0, ui_text) |> ignore
        f.box(fn(u) { u.height(view::Live::Is(Some(1.0))).ground(view::Live::By(fn() { if f.pointed() { ui_muted() } else { ui_subtle() } })) |> ignore }) |> ignore
      })
      |> ignore
    }, at_once=true)
  }, at_once=true)}

fn region_chip(parent : view::View) -> Unit {
  let key : mbt_compat::Ref[Option[view::View]] = mbt_compat::ref_new(None)
  parent.box(fn(chip) {
    chip.row(view::Live::Is(true)).height(view::Live::Is(Some(28.0))).padding(view::Live::Is((0.0, 0.0, 6.0, 0.0))).gap(view::Live::Is(2.0)).radius(view::Live::Is(6.0)).ground(view::Live::By(c_s2)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
    let body = pressable(chip, fn() { t("自定义区域") }, fn() {
      guard key.v is Some(b) else { return }
      let now = region_ratio.untracked()
      // Preserve selection state across opening/picking from the aspect-ratio menu.
      let was = region_selected.untracked()
      open_menu_under(b, mbt_compat::arr_makei(region_ratios.length(), fn(i) {
          Some(MenuEntry::{
            label: if i == 0 { t(region_ratios[i].0) } else { region_ratios[i].0 },
            key: if i == now { "✓" } else { "" },
            act: fn() {
              set_region_ratio(i)
              region_selected.set(was)
            },
          })
        }), above=true)
    }, fn(b) {
      let (hand, _) = answer(b)
      b
      .row(view::Live::Is(true))
      .height(view::Live::Is(Some(28.0)))
      .padding(view::Live::Is((9.0, 0.0, 6.0, 0.0)))
      .gap(view::Live::Is(5.0))
      .radius(view::Live::Is(6.0))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .ground(view::Live::By(fn() { mix(clear(c_s3()), c_s3(), hand.shown(b)) }))
      |> ignore
      words(b, fn() { t("自定义区域") }, 12.0, ui_text, weight=500) |> ignore
      b.box(fn(c) {
        c.width(view::Live::Is(Some(8.0))).height(view::Live::Is(Some(8.0))).picture(view::Live::Is(Some(vector("M1.5 3 4 5.5 6.5 3", 8.0, 8.0, stroke=1.25)))).tint(view::Live::By(ui_muted)) |> ignore
      })
      |> ignore
    }, keeps_region=true)
    let nudge_words = fn() {
      t(if is_mac() { "方向键微调 · Shift 加快 · ⌥ 改大小" } else { "方向键微调 · Shift 加快 · Alt 改大小" })
    }
    key.v = Some(body)
    tip(body, fn() { t("区域比例") + " · " + nudge_words() })
    icon_button(chip, fn() { "close" }, fn() { t("改回整屏") }, clear_region, w=18.0, h=18.0, size=10.0) |> ignore
  })
  |> ignore
  words(parent, fn() { if region_selected.get() { t(if is_mac() { "方向键微调 · Shift 加快 · ⌥ 改大小" } else { "方向键微调 · Shift 加快 · Alt 改大小" }) } else { "" } }, 12.0, ui_subtle) |> ignore}

fn window_strip(parent : view::View, w : () -> Double) -> Unit {
  parent.box(fn(o) {
    o.height(view::Live::By(fn() { Some(if clipping.get() && picked_hwnd.get() != 0L { 7.0 } else { 0.0 }) })) |> ignore
    o.box(fn(p) {
      p
      .height(view::Live::Is(Some(7.0)))
      .laid_nowhere(view::Live::By(fn() { !(clipping.get() && picked_hwnd.get() != 0L) }))
      .picture(view::Live::By(fn() {
        let width = w()
        if !clipping.get() || picked_hwnd.get() == 0L || width <= 0.0 {
          return None
        }
        let (from, len) = shown(p)
        let vl = view_len()
        let x = fn(at : Double) { clamp((ax_d(at, vl) - from) / len * width, 0.0, width) }
        let layers = [layer(rect_d(x(clip_a.get()), 4.0, x(clip_b.get()) - x(clip_a.get()), 3.0), c_s3())]
        for r in picked_runs(clip_a.get(), clip_b.get()) {
          if r.2 != 0 && x(r.1) > x(r.0) {
            layers.push(
              layer(rect_d(x(r.0), 4.0, x(r.1) - x(r.0), 3.0), if r.2 == 2 { ui_muted() } else { tone(0xA0A4AB66L, 0x4A4E5566L) }),
            )
          }
        }
        Some({ w: width, h: 7.0, layers: layers })
      }))
      |> ignore
    })
    |> ignore
  })
  |> ignore}

fn switch(parent : view::View, label : () -> String, on : () -> Bool, set : (Bool) -> Unit) -> Unit {
  pressable(parent, label, fn() { set(!signals::untracked(on)) }, fn(b) {
    let way = motion::NodeWay::new(if signals::untracked(on) { 1.0 } else { 0.0 })
    b.reacts(on, fn(v) { way.go_ms(b, if v { 1.0 } else { 0.0 }, if motion_off() { 1.0 } else { 140.0 }) })
    b
    .width(view::Live::Is(Some(34.0)))
    .height(view::Live::Is(Some(20.0)))
    .radius(view::Live::Is(10.0))
    .lines_up(view::Live::Is(Some(view::Along::Start)))
    .cursor(view::Live::Is(Some(view::Cursor::Arrow)))
    .ground(view::Live::By(fn() {
      let off_g = if b.pointed() { tone(0x555860FFL, 0xB8BDC6FFL) } else { tone(0x454850FFL, 0xC5C9D1FFL) }
      mix(off_g, ui_accent(), way.shown(b))
    }))
    .edge(view::Live::By(fn() {
      if b.focus_shown() {
        (1.5, focus_ring())
      } else if way.shown(b) < 0.5 {
        (1.0, tone(0xFFFFFF38L, 0x17181B45L))
      } else {
        (0.0, 0L)
      }
    }))
    |> ignore
    b.box(fn(k) {
      k
      .width(view::Live::Is(Some(16.0)))
      .height(view::Live::Is(Some(16.0)))
      .radius(view::Live::Is(8.0))
      .ground(view::Live::By(fn() { mix(tone(0xD5D8DEFFL, 0xFFFFFFFFL), ui_on_accent(), way.shown(k)) }))
      .offset(view::Live::By(fn() { (2.0 + 14.0 * way.shown(k), 2.0) }))
      |> ignore
    })
    |> ignore
  })
  |> ignore}

fn window_options_button(parent : view::View) -> Unit {
  parent.show(fn() { picked_hwnd.get() != 0L }, fn(b) {
    let key = icon_button(b, fn() { "sliders" }, fn() { t("选项") }, fn() {
      window_options_open.set(!window_options_open.untracked())
      menu_up.set(window_options_open.untracked())
    })
    options_anchor.v = Some(key.id())
  }, at_once=true)}

fn window_options_layer(root : view::View) -> Unit {
  root.box(fn(o) {
    o.over(view::Live::Is(true)).over_all(view::Live::Is(true)) |> ignore
    o.show(fn() { window_options_open.get() && picked_hwnd.get() != 0L }, fn(m) {
      let close = fn() {
        window_options_open.set(false)
        menu_up.set(false)
      }
      m.over(view::Live::Is(true)).modal(view::Live::Is(true)).presses(view::Live::Is(true)).on_press(close) |> ignore
      layer_keys(m, ["escape"])
      m.box(fn(card) {
        card
        .width(view::Live::Is(Some(320.0)))
        .radius(view::Live::Is(10.0))
        .ground(view::Live::By(c_s2))
        .edge(view::Live::By(fn() { (1.0, hair2()) }))
        .shadow(view::Live::By(fn() { (30.0, 8.0, sheet_shadow()) }))
        .presses(view::Live::Is(true))
        .on_press(fn() {  })
        |> ignore
        match options_anchor.v {
          Some(a) => card.beside(a, side=view::Side::Top, along=view::Along::End, offset=8.0) |> ignore
          None => ()
        }
        setting_row(card, true, fn() { t("窗口移动时") }, fn() {
          if picked_moved_and_popups().0 {
            t("这段里它移动或改变过大小")
          } else {
            t("这段里它没有移动")
          }
        }, fn(c) {
          segmented(c, fn() { [t("跟随"), t("固定")] }, fn() { if follow_window.get() { 0 } else { 1 } }, fn(i) {
            follow_window.set(i == 0)
          })
        })
        setting_row(card, false, fn() { t("包含菜单和对话框") }, fn() {
          if picked_moved_and_popups().1 {
            t("这段里出现过")
          } else {
            t("这段里没有出现")
          }
        }, fn(c) { switch(c, fn() { t("包含菜单和对话框") }, fn() { with_popups.get() }, fn(v) { with_popups.set(v) }) })
      })
      |> ignore
    }, at_once=true)
  })
  |> ignore}
