import "mbt_compat"
import "motion"
import "signals"
import "ui"
import "view"

fn set_volume(v : Double, m : Bool) -> Unit {
  volume.set(v)
  muted.set(m)
  apply_volume()}

fn volume_control(parent : view::View, stage? : Bool, rate? : () -> Double) -> Unit {
  let stage = match stage { Some(__mbt_v) => __mbt_v, None => false }
  let rate = match rate { Some(__mbt_v) => __mbt_v, None => fn() { speed.get() } }

  parent.box(fn(area) {
    area.row(view::Live::Is(true)).gap(view::Live::Is(4.0)).lines_up(view::Live::Is(Some(view::Along::Middle))).presses(view::Live::Is(true)) |> ignore
    let silent = fn() { muted.get() || volume.get() <= 0.0 }
    let words = fn() {
      if silent() {
        t("取消静音")
      } else {
        t("静音")
      }
    }
    let speaker = icon_button(area, fn() { if silent() || !sounds_at(rate()) { "volume-x" } else { "volume" } }, words, fn() {
      if signals::untracked(silent) {
        set_volume(if volume.untracked() <= 0.0 { 0.6 } else { volume.untracked() }, false)
      } else {
        set_volume(volume.untracked(), true)
      }
      save_prefs()
    }, stage=stage, tip_words=fn() { if sounds_at(rate()) { words() } else { t("超过 4× 没有声音") } })
    let open = motion::NodeWay::new(0.0)
    let close_later : mbt_compat::Ref[() -> Unit] = mbt_compat::ref_new(fn() {  })
    area.reacts(fn() { area.pointer_within() || speaker.pointed() || speaker.focus_shown() || volume_drag.get() }, fn(on) {
      (close_later.v)()
      close_later.v = fn() {  }
      if on {
        open.go_ms(area, 80.0, if motion_off() { 1.0 } else { 140.0 })
      } else {
        close_later.v = area.at_moment(now() + 400.0, fn() {
            open.go_ms(area, 0.0, if motion_off() { 1.0 } else { 140.0 })
          }, later=true)
      }
    })
    area.box(fn(clip) {
      clip.height(view::Live::Is(Some(20.0))).clips(view::Live::Is(true)).width(view::Live::By(fn() { Some(open.shown(clip)) })) |> ignore
      clip.box(fn(s) {
        let k = fn() { if muted.get() { 0.0 } else { volume.get() } }
        s
        .width(view::Live::Is(Some(80.0)))
        .height(view::Live::Is(Some(20.0)))
        .presses(view::Live::Is(true))
        .cursor(view::Live::Is(Some(view::Cursor::Arrow)))
        .says(view::Live::By(fn() { Some(view::said(view::Role::Slider, label=t("音量"))) }))
        .on_drag(fn(d) {
          if d.kind == view::DragIs::Down {
            region_let_go()
          }
          set_volume(clamp((d.x - 6.0) / 60.0, 0.0, 1.0), false)
          volume_drag.set(d.kind == view::DragIs::Down || d.kind == view::DragIs::Moved)
          if d.kind == view::DragIs::Up || d.kind == view::DragIs::Off {
            save_prefs()
          }
        }, captures=true)
        |> ignore
        s.box(fn(o) {
          o.over(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))) |> ignore
          o.box(fn(tr) {
            tr.width(view::Live::Is(Some(60.0))).height(view::Live::Is(Some(4.0))).radius(view::Live::Is(2.0)).ground(view::Live::By(fn() { if stage { stage_track } else { c_s4() } })).offset(view::Live::Is((6.0, 8.0))) |> ignore
          })
          |> ignore
        })
        |> ignore
        s.box(fn(o) {
          o.over(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))) |> ignore
          o.box(fn(f) {
            f
            .height(view::Live::Is(Some(4.0)))
            .radius(view::Live::Is(2.0))
            .ground(view::Live::By(fn() { if stage { stage_text } else { ui_text() } }))
            .width(view::Live::By(fn() { Some(60.0 * k()) }))
            .offset(view::Live::Is((6.0, 8.0)))
            |> ignore
          })
          |> ignore
        })
        |> ignore
        s.box(fn(o) {
          o.over(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))) |> ignore
          o.box(fn(knob) {
            knob
            .width(view::Live::Is(Some(12.0)))
            .height(view::Live::Is(Some(12.0)))
            .radius(view::Live::Is(6.0))
            .ground(view::Live::By(fn() { if stage { stage_text } else { ui_text() } }))
            .offset(view::Live::By(fn() { (60.0 * k(), 4.0) }))
            |> ignore
          })
          |> ignore
        })
        |> ignore
      })
      |> ignore
    })
    |> ignore
  })
  |> ignore}

fn bars_pointed() -> Bool {
  for b in chrome_bars {
    if b.pointed_in() {
      return true
    }
  }
  false}

fn chrome(root : view::View, bar : view::View, floats_too? : Bool) -> Unit {
  let floats_too = match floats_too { Some(__mbt_v) => __mbt_v, None => false }
  let floats = fn() { full_screen.get() || (floats_too && dock_floats()) }
  let way = motion::NodeWay::new(1.0)
  chrome_bars.push(bar)
  let wanted = fn() {
    !floats() ||
    (pointer_lately.v)() ||
    bars_pointed() ||
    view_dragging.get() ||
    clipping.get() ||
    menu_up.get() ||
    grabbed.get() != 0 ||
    settings_open.get() ||
    export_open.get() ||
    library_open.get() ||
    clip_playing.get() != "" ||
    window_options_open.get()
  }
  if floats_too {
    bars_wanted.v = wanted
  }
  root.reacts(wanted, fn(on) {
    way.go_ms(root, if on { 1.0 } else { 0.0 }, if motion_off() { 1.0 } else if on { 120.0 } else { 200.0 })
    if !on && full_screen.untracked() {
      rp_hide_cursor()
    }
  })
  bar
  .on_pointer_moved(fn() { (pointer_moved.v)() })
  .alpha(view::Live::By(fn() { way.shown(bar) }))
  .over_all(view::Live::By(floats))
  .laid_nowhere(view::Live::By(fn() { floats() && way.shown(bar) <= 0.0 }))
  |> ignore}

fn watch_pointer(root : view::View) -> Unit {
  let (tell, lately) = root.holds_for(2000.0, later=true)
  pointer_lately.v = lately
  pointer_moved.v = tell
  root.on_pointer_moved(fn() { tell() }) |> ignore}

// Test harness (REPLAY_DEV_POINTER=1): poll pointer.txt every 16 ms to hold a synthetic hover without OS mouse-leave.
fn dev_pointer(root : view::View) -> Unit {
  if ui::env("REPLAY_DEV_POINTER") != "1" {
    return
  }
  let look = fn() -> Unit { __mbt_local_dev_pointer_look_1(root) }
  __mbt_local_dev_pointer_look_1(root)}

fn recorder_status() -> (String, Bool) {
  match asked_state.get() {
    Option::Some((code, words, at)) if now_status() - at < 8000.0 && real_code() != code => return (words, code == "recording")
    _ => ()
  }
  real_status()}

fn now_status() -> Double {
  status_rev.get() |> ignore
  signals::untracked(now)}

fn asked_recorder(code : String, words : String) -> Unit {
  asked_state.set(Some((code, words, now())))
  match the_root.v {
    Some(r) => {
      let until = now() + 8000.0
      asked_follow.v += 1
      let mine = asked_follow.v
      __mbt_local_asked_recorder_look_2(r, mine, until, code)
    }
    None => ()
  }}

fn real_code() -> String {
  recorder_code()}

fn real_status() -> (String, Bool) {
  status_rev.get() |> ignore
  match state_json() {
    Option::Some(mbt_compat::MbtJson::Object(o)) => {
      match o.get("at") {
        Some(mbt_compat::MbtJson::Number(at, _)) if rp_now() - at > 10000.0 => return (t("录制程序没在运行"), false)
        _ => ()
      }
      match (o.get("statusCode"), o.get("recording")) {
        (Some(mbt_compat::MbtJson::String(code)), Some(r)) => {
          let arg = match o.get("statusArg") {
            Some(mbt_compat::MbtJson::String(a)) => a
            _ => ""
          }
          return (status_words(code, arg), r is mbt_compat::MbtJson::True)
        }
        _ => ()
      }
      match o.get("status") {
        Some(mbt_compat::MbtJson::String(s)) => (s, o.get("recording") is Some(mbt_compat::MbtJson::True))
        _ => (t("录制程序没在运行"), false)
      }
    }
    _ => (t("录制程序没在运行"), false)
  }}

fn recorder_chip(parent : view::View) -> Unit {
  let ask = fn(b : view::View) {
    let (_, on) = signals::untracked(recorder_status)
    let code = signals::untracked(recorder_code)
    let entries : Array[Option[MenuEntry]] = []
    if on {
      entries.push(Some(MenuEntry::{ label: t("暂停 15 分钟"), key: "", act: fn() { pause_for(15) } }))
      entries.push(Some(MenuEntry::{ label: t("暂停 1 小时"), key: "", act: fn() { pause_for(60) } }))
      entries.push(None)
      entries.push(Some(MenuEntry::{ label: t("关闭后台录制"), key: "", act: fn() { set_recording(false) } }))
    } else if code == "paused" {
      entries.push(Some(MenuEntry::{ label: t("继续录制"), key: "", act: fn() {
            ask_recorder("resume")
            asked_recorder("recording", t("录制中"))
          } }))
      entries.push(None)
      entries.push(Some(MenuEntry::{ label: t("关闭后台录制"), key: "", act: fn() { set_recording(false) } }))
    } else if code == "disabled" {
      entries.push(Some(MenuEntry::{ label: t("开启后台录制"), key: "", act: fn() { set_recording(true) } }))
    } else if code == "noPermission" {
      entries.push(Some(MenuEntry::{ label: t("开启屏幕录制权限…"), key: "", act: fn() { ask_recorder("permissions") } }))
      entries.push(None)
      entries.push(Some(MenuEntry::{ label: t("关闭后台录制"), key: "", act: fn() { set_recording(false) } }))
    } else if code == "" {
      entries.push(Some(MenuEntry::{ label: t("启动录制"), key: "", act: start_recorder }))
    } else {
      entries.push(Some(MenuEntry::{ label: t("关闭后台录制"), key: "", act: fn() { set_recording(false) } }))
    }
    if signals::untracked(fn() { info().buffer_trouble }) != "" {
      entries.push(None)
      entries.push(Some(MenuEntry::{ label: t("录像位置设置…"), key: "", act: fn() {
            load_settings()
            settings_page.set(2)
            settings_open.set(true)
          } }))
    }
    open_menu_under(b, entries)
  }
  pressable(parent, fn() { recorder_status().0 }, fn() {  }, fn(k) {
    k.on_press(fn() { if real_code() == "" { start_recorder() } else { ask(k) } }) |> ignore
    k
    .row(view::Live::Is(true))
    .height(view::Live::Is(Some(28.0)))
    .padding(view::Live::Is((10.0, 0.0, 8.0, 0.0)))
    .gap(view::Live::Is(6.0))
    .radius(view::Live::Is(6.0))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .cursor(view::Live::Is(Some(view::Cursor::Arrow)))
    .edge(view::Live::By(fn() { if k.focus_shown() { (1.5, focus_ring()) } else { (0.0, 0L) } }))
    .ground(view::Live::By(fn() { if k.pointed() || k.focus_shown() { press_ground() } else { 0L } }))
    |> ignore
    k.pick(fn() { recorder_status().1 }, fn(b, on) {
      b.row(view::Live::Is(true)).gap(view::Live::Is(7.0)).lines_up(view::Live::Is(Some(view::Along::Middle))) |> ignore
      if on {
        // Gate pulse animation on window focus (bit 0) to avoid background redraw CPU usage; REPLAY_STILL_DOT=1 disables it.
        let still_dot = ui::env("REPLAY_STILL_DOT") == "1"
        let out = motion::cubic_bezier(0.2, 0.6, 0.3, 1.0)
        let trouble = fn() { info().buffer_trouble != "" }
        b.box(fn(cell) {
          cell.width(view::Live::Is(Some(7.0))).height(view::Live::Is(Some(7.0))) |> ignore
          cell.show(fn() { !trouble() && !motion_off() && !still_dot && (rp_window_state() & 1) != 0 }, fn(ring) {
            let step : signals::Signal[Int] = signals::signal(48)
            __mbt_local_recorder_chip_tick_3(ring, step, 0)
            let at = fn() {
              let k = step.get()
              if k >= 48 {
                -1.0
              } else {
                out(k.to_double() / 48.0)
              }
            }
            ring
            .over(view::Live::Is(true))
            .width(view::Live::Is(Some(7.0)))
            .height(view::Live::Is(Some(7.0)))
            .radius(view::Live::Is(3.5))
            .ground(view::Live::By(rec_red))
            .scale(view::Live::By(fn() { let e = at(); if e < 0.0 { 1.0 } else { 1.0 + 2.2 * e } }))
            .alpha(view::Live::By(fn() { let e = at(); if e < 0.0 { 0.0 } else { 0.55 * (1.0 - e) } }))
            |> ignore
          }, at_once=true)
          |> ignore
          cell.box(fn(dot) {
            dot
            .over(view::Live::Is(true))
            .width(view::Live::Is(Some(7.0)))
            .height(view::Live::Is(Some(7.0)))
            .radius(view::Live::Is(3.5))
            .ground(view::Live::By(fn() { if trouble() { warn() } else { rec_red() } }))
            |> ignore
          })
          |> ignore
        })
        |> ignore
        words(b, fn() { if info().buffer_trouble != "" { t("录制中 · 暂存到默认位置") } else { t("录制中") } }, 12.0, fn() {
            if info().buffer_trouble != "" {
              warn()
            } else {
              ui_muted()
            }
          })
        |> ignore
      } else {
        b.box(fn(d) { d.width(view::Live::Is(Some(7.0))).height(view::Live::Is(Some(7.0))).radius(view::Live::Is(3.5)).ground(view::Live::By(warn)) |> ignore }) |> ignore
        words(b, fn() {
          if now_starting() {
            t("正在启动录制…")
          } else if recorder_code() == "" {
            t("没在录制 · 点击启动")
          } else {
            recorder_status().0
          }
        }, 12.0, warn)
        |> ignore
      }
    }, at_once=true)
    k.box(fn(c) {
      c
      .width(view::Live::Is(Some(8.0)))
      .height(view::Live::Is(Some(8.0)))
      .laid_nowhere(view::Live::By(fn() { recorder_code() == "" }))
      .picture(view::Live::Is(Some(vector("M1.5 3 4 5.5 6.5 3", 8.0, 8.0, stroke=1.25))))
      .tint(view::Live::By(ui_subtle))
      |> ignore
    })
    |> ignore
  })
  |> ignore}

fn recorder_code() -> String {
  status_rev.get() |> ignore
  match state_json() {
    Option::Some(mbt_compat::MbtJson::Object(o)) => {
      match o.get("at") {
        Some(mbt_compat::MbtJson::Number(at, _)) if rp_now() - at > 10000.0 => return ""
        _ => ()
      }
      match o.get("statusCode") {
        Some(mbt_compat::MbtJson::String(code)) => code
        _ => ""
      }
    }
    _ => ""
  }}

fn now_starting() -> Bool {
  now() - recorder_asked_at.get() < 12000.0}

fn ask_recorder(what : String) -> Unit {
  rp_write(cstr(pjoin(root_dir(), "pause.request")), mbt_compat::utf8_encode(what)) |> ignore}

fn set_recording(on : Bool) -> Unit {
  load_settings()
  settings.enabled = on
  save_settings()
  if on {
    asked_recorder("recording", t("录制中"))
  } else {
    asked_recorder("disabled", t("后台录制已关闭"))
  }}

fn pause_for(minutes : Int) -> Unit {
  ask_recorder(minutes.to_string())
  asked_recorder("paused", tf("已暂停，{0} 继续", [wall(rp_now() + minutes.to_double() * 60000.0, short=true)]))}

fn start_recorder() -> Unit {
  if ui::env("REPLAY_NO_RECORDER") != "1" && rp_launch_recorder() == 1 {
    recorder_asked_at.set(now())
    match the_root.v {
      Some(r) => r.at_moment(now() + 12000.0, fn() { recorder_asked_at.set(-1.0e18) }) |> ignore
      None => ()
    }
  }}
fn __mbt_local_dev_pointer_look_1(root : view::View) -> Unit {
    let nums : Array[Int] = []
    let n : mbt_compat::MbtCell[Int] = mbt_compat::MbtCell::{ v: -1 }
    let s = read_text(pjoin(root_dir(), "pointer.txt")) + " "
    let mut i = 0
    while i < s.length() {
      let cu = s.code_unit_at(i)
      i += 1
      if cu >= 48 && cu <= 57 {
        n.v = (if n.v < 0 { 0 } else { n.v }) * 10 + (cu - 48)
      } else if n.v >= 0 {
        nums.push(n.v)
        n.v = -1
      }
    }
    if nums.length() >= 2 {
      root.tree.unfollow()
      root.tree.pointed_to(None)
      root.tree.pointer_is(nums[0].to_double(), nums[1].to_double())
    }
    root.at_moment(now() + 16.0, fn() { __mbt_local_dev_pointer_look_1(root) }, later=true) |> ignore
  }

fn __mbt_local_asked_recorder_look_2(r : view::View, mine : Int, until : Double, code : String) -> Unit {
        if asked_follow.v != mine {
          return
        }
        status_rev.set(status_rev.untracked() + 1)
        if now() < until && signals::untracked(real_code) != code {
          r.at_moment(now() + 250.0, fn() { __mbt_local_asked_recorder_look_2(r, mine, until, code) }) |> ignore
        }
      }

fn __mbt_local_recorder_chip_tick_3(ring : view::View, step : signals::Signal[Int], k : Int) -> Unit {
              step.set(k)
              if k < 48 {
                ring.at_moment(ring.cause_at() + 1600.0 / 48.0, fn() { __mbt_local_recorder_chip_tick_3(ring, step, k + 1) }, later=true) |> ignore
              } else {
                ring.at_moment(ring.cause_at() + 800.0, fn() { __mbt_local_recorder_chip_tick_3(ring, step, 0) }, later=true) |> ignore
              }
            }


