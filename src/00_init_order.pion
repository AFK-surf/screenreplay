  "这时 {0} 不在屏幕上", "{0} isn't on screen here"), ("点击只导出 {0}", "Click to export only {0}"), ("有 {0} 不在屏幕上", "{0} of it is off screen"), ("只留有画面的 {0}", "Keep only the {0} on screen"), ("有 {0} 被遮住", "{0} of it is covered"), ("只留完整可见的 {0}", "Keep only the fully visible {0}"), ("整屏", "Whole screen"), ("选窗口", "Window"), ("框选区域", "Area"), ("导出整个画面", "Exports the whole picture"), ("在画面上点一个窗口，只导出它", "Click a window in the picture to export only it"), ("在画面上拖出一个区域", "Drag out an area on the picture"), ("自定义区域", "Custom area"), ("只导出自定义区域", "Only the custom area"), ("自由", "Free"), ("区域比例", "Aspect ratio"), ("方向键微调 · Shift 加快 · Alt 改大小", "Arrows nudge · Shift for 10 px · Alt resizes"), ("只导出 {0}", "Only {0}"), ("改回整屏", "Whole screen"), ("选项", "Options"), ("窗口移动时", "When the window moves"), ("这段里它移动或改变过大小", "It moves or resizes in this clip"), ("这段里它没有移动", "It doesn't move in this clip"), ("跟随", "Follow"), ("固定", "Fixed"), ("包含菜单和对话框", "Include menus and dialogs"), ("这段里出现过", "Some appear in this clip"), ("这段里没有出现", "None in this clip"), (// saving a clip
  "保存片段", "Save clip"), ("时长", "Length"), ("大小", "Size"), ("不重新编码", "no re-encode"), ("重新编码", "re-encoded"), ("按大小", "By size"), ("自定义", "Custom"), ("原样", "Original"), ("和录像一模一样，瞬间完成。", "Exactly as recorded, saved instantly."), ("H.265 在部分聊天软件和手机上可能播不了，要发出去可以选「按大小」。", " Some chat apps and phones can't play H.265. To share it, choose By size."), ("为发到聊天压缩成 H.264，按大小自动选清晰度", "H.264 for chats, sharpness picked to fit"), ("分辨率", "Resolution"), ("原始", "Original"), ("帧率", "Frame rate"), ("画质", "Quality"), ("低", "Low"), ("中", "Medium"), ("高", "High"), ("极高", "Ultra"), ("编码", "Codec"), ("格式", "Format"), ("哪里都能播", "Plays anywhere"), ("比 H.264 小，但部分电脑、聊天软件和网页可能播不了", "Smaller than H.264, but some PCs, chat apps and web pages may not play it"), ("比 H.265 还小，但部分电脑、聊天软件和网页可能播不了", "Smaller still, but some PCs, chat apps and web pages may not play it"), ("没有声音的动图，最宽 960；适合几秒钟的短片段", "A silent animation, up to 960 px wide. Best for a few seconds."), ("没有声音", "no sound"), ("估算中…", "Estimating…"), ("存成 GIF 约 {0}，太大了；存成视频会小得多，也更清楚", "About {0} as a GIF, which is large. Saving as a video will be much smaller and sharper."), ("这段有 {0}；GIF 没有声音、不能拖动，长片段存成视频更好", "This clip is {0} long. A GIF has no sound and can't be scrubbed; a long clip is better as a video."), ("这段太长，压不到 {0} MB 以内，会是约 {1}；可以剪短一些，或选大一档", "Too long to fit in {0} MB; it will be about {1}. Trim it, or pick a larger size."), ("正在保存 {0}%", "Saving {0}%"), ("正在保存…", "Saving…"), ("存到 {0}", "Saves to {0}"), ("保存并复制", "Save and copy"), ("没能开始保存（{0}）", "Couldn't start saving ({0})"), ("保存失败（{0}）", "Save failed ({0})"), (// the saved clips
  "播放 / 暂停", "Play / pause"), ("播放 / 暂停 (空格)", "Play / pause (Space)"), ("播放 / 暂停（空格）", "Play / pause (Space)"), ("上一个片段", "Previous clip"), ("下一个片段", "Next clip"), ("退出全屏", "Exit full screen"), ("已复制", "Copied"), ("暂无预览", "No preview"), ("需要 AV1 视频扩展", "Needs the AV1 Video Extension"), ("这个片段是 AV1 格式", "This clip is in AV1"), ("这台电脑还不能解码 AV1，所以没法在这里播放和预览它。从 Microsoft Store 装上免费的「AV1 视频扩展」，再打开这个片段就能播放。", "This PC can't decode AV1 yet, so the clip can't be played or previewed here. Get the free AV1 Video Extension from the Microsoft Store, then open the clip again."), ("在 Microsoft Store 获取", "Get it from Microsoft Store"), ("加载预览…", "Loading preview…"), ("小于 1 MB", "Under 1 MB"), ("移到回收站", "Move to Recycle Bin"), ("已移到回收站，可在回收站恢复", "Moved to the Recycle Bin. You can restore it there."), ("未能移到回收站（{0}），文件仍保留", "Couldn't move it to the Recycle Bin ({0}). The file is still there."), ("已复制「{0}」，可直接粘贴到聊天或文件夹", "Copied “{0}”. Paste it into a chat or a folder."), ("没能复制到剪贴板", "Couldn't copy to the clipboard"), ("复制当前帧", "Copy frame"), ("最大文件大小", "Max file size"), ("显卡编码器不支持这个帧率，正在按 60 帧录制", "The GPU's encoder can't take this frame rate; recording at 60 fps instead."), ("集成显卡录制和播放视频共用同一个视频单元，屏幕大于 1440p 时建议调低，看高清视频更流畅", "Integrated graphics records and plays video on the same video engine; above 1440p, a lower setting keeps HD video playing smoothly."), ("显卡编码跟不上", "The GPU's encoder can't keep up"), ("最近 10 秒有 {0}% 的画面没来得及录，实际约 {1} 帧/秒。可以在「画质」里调低分辨率或帧率", "{0}% of frames in the last 10 s were dropped, about {1} fps recorded. Lower the resolution or frame rate under Quality."), ("比 60 帧多占约 {0} 空间，显卡编码更忙，玩游戏时可能略降帧率", "About {0} more space than 60 fps, more work for the GPU's encoder; games may lose a few frames"), ("；显示器只有 {0} Hz，多出来的帧都是重复画面，白占空间", "; the display runs at {0} Hz, so the extra frames repeat and only take space"), ("复制这一帧", "Copy this frame"), ("已复制当前帧", "Frame copied"), ("删除", "Delete"), ("还没有保存的片段", "No saved clips yet"), ("在回放里按 C 选取一段，按 Enter 保存，就会出现在这里。", "Press C in the replay to pick a stretch and Enter to save it. It will show up here."), ("上一页", "Previous"), ("下一页", "Next"), (// settings
  "录制", "Recording"), ("存储", "Storage"), ("快捷键", "Shortcuts"), ("外观", "Appearance"), ("录像只存在这台电脑上，不会上传。", "Recordings stay on this PC and are never uploaded."), ("后台录制", "Background recording"), ("关掉后不再录制，已录的保留到过期", "When off, nothing new is recorded; what's kept stays until it expires"), ("录制系统声音", "Record system audio"), ("电脑播放的声音一起录下", "Sound your PC plays is recorded too"), ("声音没能写进最近的录像，详情在 recorder.log", "Sound didn't make it into the latest recording; see recorder.log"), ("录制麦克风", "Record microphone"), ("和系统声音同开时，片段里只带系统声音", "With system audio on too, clips carry only system audio"), ("全屏时暂停", "Pause in full screen"), ("游戏、全屏视频在前台时不录", "Nothing is recorded while a game or full-screen video is in front"), ("开机时启动", "Start with Windows"), ("登录 Windows 后自动开始后台录制", "Start background recording when you sign in"), ("保存最近一段", "Save the last moments"), ("长度", "Length"), ("按 Ctrl+Alt+S，不开窗口直接存成片段", "Ctrl+Alt+S saves a clip without opening the window"), ("15 秒", "15 s"), ("30 秒", "30 s"), ("1 分钟", "1 min"), ("2 分钟", "2 min"), ("这台电脑现在用 H.264 录", "This PC records H.264 for now"), ("H.265 同样画质约省 40% 空间", "H.265 takes about 40% less space at the same quality"), ("{0}×{1} · 约 {2} Mbps · 每小时最多 {3}", "{0}×{1} · ~{2} Mbps · up to {3} an hour"), ("{0}×{1} · 约 {2} Mbps　每小时最多 {3}", "{0}×{1} · ~{2} Mbps · up to {3} an hour"), ("，画面不动时少得多", ", far less when the screen is still"), ("占用", "Used"), ("保留多久", "Keep for"), ("更早的录像自动删除", "Older recordings are deleted"), ("30 分钟", "30 min"), ("1 小时", "1 hour"), ("2 小时", "2 hours"), ("4 小时", "4 hours"), ("录像 {0}", "Recordings {0}"), ("缩略图 {0}", "Thumbnails {0}"), ("保留时长约需 {0}", "The time kept needs about {0}"), ("撤销", "Undo"), ("重做", "Redo"), ("更早的录像自动删除；约需 {0}", "Older recordings are deleted; needs about {0}"), ("按应用统计和过滤", "Stats and filter by app"), ("应用", "Apps"), ("{0} 个应用", "{0} apps"), ("、", ", "), ("清除过滤", "Clear filter"), ("只看它", "Only this"), ("{0} 段 · 共 {1}", "{0} stretches · {1}"), ("跳过 {0} · {1} – {2}", "{0} left out · {1} – {2}"), ("未录制 {0} · {1} – {2}", "{0} not recorded · {1} – {2}"), ("时间线", "Timeline"), ("跳过没录制的时段", "Skip time not recorded"), ("没开 ScreenReplay、关掉或暂停录制的时间，不计入保留时长，在时间线上也折成一条细缝", "Time ScreenReplay wasn't running, or recording was off or paused, doesn't count toward retention and folds to a thin seam on the timeline"), ("不到 1 秒", "< 1 s"), ("不到 1 分", "Under 1 min"), ("暂无应用记录", "No apps recorded yet"), ("{0} 分", "{0} min"), ("{0} 小时 {1} 分", "{0} h {1} min"), ("前台应用", "Apps in front"), ("过去 {0} · 共录 {1}", "Past {0} · {1} recorded"), ("显示全部", "Show all"), ("其他 1 个", "1 other"), ("其他 {0} 个", "{0} others"), ("其它 {0} 个", "{0} others"), ("播放和前进/后退 15 秒只经过所选应用", "Playback and 15 s jumps stay in the selected apps"), ("勾选应用后，只看它们的时段", "Select apps to watch only their segments"), ("清除", "Clear"), ("NVIDIA 显卡开着「快速同步」", "NVIDIA Fast Sync is on"), ("部分游戏的录像可能会一帧新、一帧旧地闪烁。打开 NVIDIA 控制面板 → 管理 3D 设置 → 垂直同步，改成「使用 3D 应用程序设置」或「关」", "Some games may flicker in recordings, alternating between the new picture and an old one. In NVIDIA Control Panel → Manage 3D settings → Vertical sync, choose “Use the 3D application setting” or “Off”"), ("磁盘剩余不到 10 GB，正在提前删除最早的录像。可以降低画质或帧率、缩短保留时长，或把录像缓冲换到另一块盘", "Under 10 GB left on the disk: the oldest recordings are being deleted early. Lower the quality or frame rate, keep less time, or move the buffer to another drive"), ("磁盘剩余 {0}", "{0} free"), ("主题", "Theme"), ("跟随系统", "System"), ("深色", "Dark"), ("浅色", "Light"), ("语言", "Language"), ("打开回放", "Open replay"), ("标记此刻", "Mark this moment"), ("前后 5 秒", "Back / forward 5 s"), ("前后 15 秒", "Back / forward 15 s"), ("逐帧", "Frame by frame"), ("上一个 / 下一个标记", "Previous / next marker"), ("设起点 / 终点", "Set start / end"), ("跳到最新", "Jump to live"), ("全屏", "Full screen"), ("关于", "About"), ("一直在后台录屏，随时倒回去存下刚才那一段。", "Always recording in the background, so you can rewind and keep what just happened."), ("版本 {0}", "Version {0}"), ("构建 {0}", "Build {0}"), ("开发构建", "Development build"), ("通过 Microsoft Store 自动更新", "Updated automatically via Microsoft Store"), ("版本更新", "Software update"), ("当前版本 {0}", "Current version {0}"), ("当前版本 {0} · 便携/开发构建", "Current version {0} · Development build"), ("正在检查更新…", "Checking for updates…"), ("已是最新版本", "Up to date"), ("发现新版本 {0}", "Version {0} is available"), ("正在下载 {0}（{1}%）", "Downloading {0} ({1}%)"), ("正在下载 {0}…", "Downloading {0}…"), ("新版本 {0} 已下载，空闲时自动完成更新", "Version {0} downloaded — will update when idle"), ("正在重启并安装更新…", "Restarting to install update…"), ("安装包签名或校验失败", "Installer signature or checksum check failed"), ("未能启动更新安装程序", "Couldn't launch the update installer"), ("检查或下载更新失败，请检查网络", "Couldn't check or download update. Check your network."), ("检查更新", "Check for updates"), ("检查中…", "Checking…"), ("立即更新", "Update now"), ("前往下载", "Download"), ("下载中…", "Downloading…"), ("重启并更新", "Restart to update"), ("正在更新…", "Updating…"), ("自动更新", "Automatic updates"), ("每天检查一次，空闲时在后台静默下载并更新", "Check daily and install updates silently in the background when idle"), ("更新日志", "What's new"), ("保存最近 {0} 秒", "Save the last {0} s"), ("已保存最近 {0} 秒", "Saved the last {0} s"), ("正在保存最近 {0} 秒…", "Saving the last {0} s…"), ("已保存片段文件夹", "Open saved clips folder"), ("打开已保存片段文件夹", "Open saved clips folder"), ("设置…", "Settings…"), ("退出", "Quit"), ("已关闭", "Off"), ("15 分钟", "15 min"), ("隐私政策", "Privacy policy"), ("反馈问题", "Send feedback"), ("诊断", "Diagnostics"), ("联系作者", "Contact the author"), ("邮件", "Email"), ("复制诊断信息", "Copy diagnostics"), ("版本、系统、显卡、当前编码器", "Version, system, graphics, encoder"), ("已复制诊断信息", "Diagnostics copied"), ("打开日志文件夹", "Open logs folder"), ("赞助作者", "Sponsor"), ("ScreenReplay 免费使用，觉得好用可以请我喝杯咖啡", "ScreenReplay is free. If it helps you, buy me a coffee."), ("请喝咖啡", "Buy me a coffee"), ("开源许可", "Open-source licenses"), ("{0} 秒", "{0} s"), ("录像缓冲位置", "Where recordings are kept"), ("录制中 · 暂存到默认位置", "Recording · in the default place for now"), ("录像位置设置…", "Recording location settings…"), ("正在切换…", "Switching…"), ("已切换，新的录像存到这里", "Switched: new recordings go here"), ("旧位置还有 {0}，约 {1} 后自动清空", "{0} left in the old place, cleared in about {1}"), ("切换时会有几秒不录", "A few seconds aren't recorded while switching"), ("旧位置还有 {0}，即将自动清空", "{0} left in the old place, cleared shortly"), ("所在磁盘剩余 {0}", "{0} free on its drive"), ("恢复默认", "Back to default"), ("更改…", "Change…"), ("这个文件夹写不进去，没有更改", "This folder can't be written to; nothing changed"), ("这块磁盘只剩 {0}，不够放下保留时长所需的 1.2 倍（{1}），没有更改", "Only {0} free on this drive, less than 1.2 times what the time kept needs ({1}); nothing changed"), ("选的文件夹现在写不进去（磁盘被拔出或没有权限），录像暂时存到默认位置", "The chosen folder can't be written to now (drive removed or no permission); recordings go to the default place meanwhile"), ("录像 {0} · 缩略图 {1} · 每小时约写入 {2}，全天约 {3}", "Recordings {0} · thumbnails {1} · writes about {2} an hour, {3} a day"), ("。长期这样录会明显消耗固态硬盘的写入寿命，可以降低帧率或画质", ". Over months this wears an SSD noticeably; a lower frame rate or quality writes less"), ("这次导出压缩得多细；不会比录像本身更清楚", "How finely this export is compressed; never clearer than the recording"), ("录下来有多清楚，也决定录像占多少空间；导出时还能另选", "How clear recordings are and how much room they take; exports can pick their own"), ("{0} 分钟", "{0} min"), ("{0} 小时", "{0} h"), ("5 分钟", "5 min"), ("10 分钟", "10 min"), ("全部", "All"), ("时间线缩放 · Ctrl+滚轮", "Timeline zoom · Ctrl+wheel"), ("超过 4× 没有声音", "No sound above 4×"), (// the first run's sheet
  "开始之前，先说清楚它做什么", "Before you start, here is what it does"), ("ScreenReplay 会在后台一直录着你的屏幕，直到你暂停或退出。", "ScreenReplay records your screen in the background all the time, until you pause it or quit."), ("录什么", "What it records"), ("主屏幕的画面和系统声音。麦克风默认不录。还会记下每个时刻在前台的应用和各窗口的位置、标题，用来画时间线和按窗口导出。也会记下鼠标、键盘和手柄用得多频繁（只记次数，不记按了哪个键、点在哪里），在时间线上标出忙碌的时段。开始录制时，Windows 可能会问一次是否允许它截屏时不显示黄色边框，允许即可。", "The main display's picture and the computer's sound; the microphone is off by default. It also notes the app in front at each moment and each window's place and title, to draw the timeline and to save one window on its own. And how often the mouse, keyboard and game controller are used (counts only, never which keys, buttons or where), to mark the busy stretches on the timeline. When it starts, Windows may ask once whether it may capture without a yellow border: allow it."), ("存在哪、留多久", "Where it is kept, and for how long"), ("只存在这台电脑上，不上传。只保留最近一段时间，更早的自动删除。", "Only on this PC, never uploaded. Only the most recent stretch is kept; anything older is deleted automatically."), ("你随时可以", "You can always"), ("从托盘图标暂停或退出；在「设置 › 存储」里删除全部录像；在设置里关掉声音或整个后台录制。", "Pause or quit from the tray icon; delete every recording in Settings › Storage; turn off the sound, or background recording altogether, in Settings."), ("它不做的", "What it does not do"), ("这个版本不收集任何使用统计，也不发送崩溃报告。", "This version collects no usage statistics and sends no crash reports."), ("保留最近", "Keep the last"), ("开机时自动启动并开始录制", "Start with Windows and begin recording"), ("暂不录制", "Not now"), ("开始录制", "Start recording"), ("知道了", "Got it"), ("录制说明", "About recording"), (// macOS
  "未授予录屏权限", "Screen recording permission needed"), ("开启屏幕录制权限…", "Grant Screen Recording…"), ("在 Finder 中显示", "Show in Finder"), ("移到废纸篓", "Move to Trash"), ("已移到废纸篓，可在废纸篓恢复", "Moved to the Trash. You can put it back from there."), ("未能移到废纸篓（{0}），文件仍保留", "Couldn't move it to the Trash ({0}). The file is still there."), ("此设备不支持 AV1 硬解", "AV1 hardware decode isn't supported here"), ("这台 Mac 硬件不支持 AV1 解码（需 M3 或更新芯片），无法在这里直接播放。可在 Finder 中用第三方播放器打开。", "This Mac doesn't decode AV1 in hardware (requires M3 or newer), so the clip can't be played here. Show it in Finder to open it in another player."), ("时间线缩放 · ⌘+滚轮", "Timeline zoom · ⌘+scroll"), ("方向键微调 · Shift 加快 · ⌥ 改大小", "Arrows nudge · Shift for 10 px · ⌥ resizes"), ("登录时自动启动", "Launch at login"), ("登录 macOS 后自动开始后台录制", "Start background recording when you log in"), ("按 ⌃⌥S，不开窗口直接存成片段", "⌃⌥S saves a clip without opening the window"), ("Mac 播放的声音一起录下", "Sound your Mac plays is recorded too"), ("这台 Mac 现在用 H.264 录", "This Mac records H.264 for now"), ("录像只存在这台 Mac 上，不会上传。", "Recordings stay on this Mac and are never uploaded."), ("主屏幕的画面和系统声音。麦克风默认不录。还会记下每个时刻在前台的应用和各窗口的位置、标题，用来画时间线和按窗口导出。也会记下鼠标、键盘和手柄用得多频繁（只记次数，不记按了哪个键、点在哪里），在时间线上标出忙碌的时段。首次开始录制时，需要在「系统设置 › 隐私与安全性 › 屏幕与系统音频录制」中授予录制权限。", "The main display's picture and the Mac's sound; the microphone is off by default. It also notes the app in front at each moment and each window's place and title, to draw the timeline and to save one window on its own. And how often the mouse, keyboard and game controller are used (counts only, never which keys, buttons or where), to mark the busy stretches on the timeline. When you start recording for the first time, grant permission in System Settings › Privacy & Security › Screen & System Audio Recording."), ("只存在这台 Mac 上，不上传。只保留最近一段时间，更早的自动删除。", "Only on this Mac, never uploaded. Only the most recent stretch is kept; anything older is deleted automatically."), ("从菜单栏图标暂停或退出；在「设置 › 存储」里删除全部录像；在设置里关掉声音或整个后台录制。", "Pause or quit from the menu bar icon; delete every recording in Settings › Storage; turn off the sound, or background recording altogether, in Settings."), ("登录时自动启动并开始录制", "Launch at login and begin recording")])

let appearance : signals::Signal[String] = signals::signal("system")

