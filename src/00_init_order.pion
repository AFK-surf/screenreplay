let settings_seen : mbt_compat::Ref[Double] = mbt_compat::ref_new(-2.0)

let tick_steps : Array[Double] = [
  1000.0, 2000.0, 5000.0, 10000.0, 15000.0, 30000.0, 60000.0, 120000.0, 300000.0, 600000.0, 900000.0, 1800000.0, 3600000.0,
  7200000.0, 10800000.0, 21600000.0, 43200000.0, 86400000.0,
]

let tick_room : Double = 200.0

let tick_h : Double = 2.0

let tick_size : Double = 10.0

let view_by_hand : mbt_compat::Ref[Double] = mbt_compat::ref_new(-1.0e18)

let key_jump_at : mbt_compat::Ref[Double] = mbt_compat::ref_new(-1000.0)

let key_seeking : mbt_compat::Ref[Bool] = mbt_compat::ref_new(false)

let just_marked : mbt_compat::Ref[Double] = mbt_compat::ref_new(-1.0)

let strip_h : Double = 32.0

let app_names : mbt_compat::OrderedMap[String, String] = mbt_compat::ordered_map_new()

let app_names_missed : mbt_compat::OrderedMap[String, Double] = mbt_compat::ordered_map_new()

let runs_now : signals::Computed[Array[(Double, Double)]] = signals::computed_ref(fn(_) {
  data()
  recorded_runs()})

let folded_now : signals::Computed[Array[(Double, Double)]] = signals::computed_ref(fn(_) {
  let out : Array[(Double, Double)] = []
  for r in runs_now.get() {
    if out.length() > 0 && r.0 - out[out.length() - 1].1 < fold_min {
      let last = out[out.length() - 1]
      out[out.length() - 1] = (last.0, dmax(last.1, r.1))
    } else {
      out.push(r)
    }
  }
  out})

let pieces_now : signals::Computed[Array[(Double, Double, String)]] = signals::computed_ref(fn(_) {
  data()
  app_pieces()})

let app_stats : signals::Computed[(Array[(String, Double, String)], Double)] = signals::computed_ref(fn(_) {
  let by : mbt_compat::OrderedMap[String, Double] = mbt_compat::ordered_map_new()
  let icon : mbt_compat::OrderedMap[String, (String, Double)] = mbt_compat::ordered_map_new()
  let per : mbt_compat::OrderedMap[String, Double] = mbt_compat::ordered_map_new()
  let mut total = 0.0
  for p in pieces_now.get() {
    let d = p.1 - p.0
    total += d
    if p.2 != "" {
      let name = app_name(p.2)
      by.set(name, by.get(name).unwrap_or(0.0) + d)
      let own = per.get(p.2).unwrap_or(0.0) + d
      per.set(p.2, own)
      if own > opt_map(icon.get(name), fn(x) { x.1 }).unwrap_or(-1.0) {
        icon.set(name, (p.2, own))
      }
    }
  }
  let rows : Array[(String, Double, String)] = []
  by.each(fn(k, v) { rows.push((k, v, opt_map(icon.get(k), fn(x) { x.0 }).unwrap_or(""))) })
  arr_sort_by(rows, fn(a, b) { if a.1 > b.1 { -1 } else if a.1 < b.1 { 1 } else { 0 } })
  (rows, total)})

let kept_now : signals::Computed[Array[(Double, Double)]] = signals::computed_ref(fn(_) {
  let f = app_filter.get()
  let out : Array[(Double, Double)] = []
  if f.is_empty() {
    return out
  }
  for p in pieces_now.get() {
    if p.2 == "" || !f.contains(app_name(p.2)) {
      continue
    }
    if out.length() > 0 && p.0 - out[out.length() - 1].1 <= 1500.0 {
      let last = out[out.length() - 1]
      out[out.length() - 1] = (last.0, dmax(last.1, p.1))
    } else {
      out.push((p.0, p.1))
    }
  }
  out})

let axis_now : signals::Computed[Option[Axis]] = signals::computed_ref(fn(_) {
  let ks = if !app_filter.get().is_empty() {
    kept_now.get()
  } else if fold_gaps.get() {
    let f = folded_now.get()
    if f.length() < 2 {
      return None
    }
    f
  } else {
    return None
  }
  if ks.is_empty() {
    return None
  }
  let n = ks.length()
  let g = Array::make(n, 0.0)
  for i in 1..<n {
    g[i] = seam_w(ks[i].0 - ks[i - 1].1)
  }
  // (the seams together never more than half the band: all of them narrowed alike where there are many)
  let mut all = 0.0
  for x in g {
    all += x
  }
  if all > ax_ref * 0.5 {
    let k = ax_ref * 0.5 / all
    for i in 0..<n {
      g[i] = g[i] * k
    }
    all = ax_ref * 0.5
  }
  let kb = Array::make(n, 0.0)
  let gb = Array::make(n, 0.0)
  let mut kept = 0.0
  let mut seams = 0.0
  for i in 0..<n {
    seams += g[i]
    kb[i] = kept
    gb[i] = seams
    kept += ks[i].1 - ks[i].0
  }
  Some(Axis::{ ks: ks, g: g, kb: kb, gb: gb, kept: kept, seams: all })})

let gaps_now : signals::Computed[Array[(Double, Double)]] = signals::computed_ref(fn(_) {
  data()
  gaps()})

