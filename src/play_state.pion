import "motion"
import "signals"
import "ui"
import "view"

fn tell_playing(was : Bool, now_on : Bool, told? : signals::Signal[(Int, Bool)]) -> Unit {
  let told = match told { Some(__mbt_v) => __mbt_v, None => play_told }

  if was != now_on {
    told.set((told.untracked().0 + 1, now_on))
  }}

fn play_state_over(pic : view::View, told? : signals::Signal[(Int, Bool)], playing? : () -> Bool, badge_may? : () -> Bool) -> Unit {
  let told = match told { Some(__mbt_v) => __mbt_v, None => play_told }
  let playing = match playing { Some(__mbt_v) => __mbt_v, None => fn() { want_play.get() } }
  let badge_may = match badge_may { Some(__mbt_v) => __mbt_v, None => fn() { has_segs() && (bars_wanted.v)() && !cropping() } }

  let white = fn() { 0xFFFFFFFFL }
  pic.box(fn(o) {
    o.over(view::Live::Is(true)).presses(view::Live::Is(false)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle)) |> ignore
    o.box(fn(f) {
      let way = motion::NodeWay::new(1.0)
      f.reacts(fn() { told.get() }, fn(v) {
        if v.0 > 0 {
          // 10x flash duration for slow screenshot capture in tests.
          let slow = if ui::env("REPLAY_SLOW_FLASH") == "1" { 10.0 } else { 1.0 }
          way.go_from(f, 0.0, 1.0, motion::tween(slow * (if motion_off() { 300.0 } else { 500.0 }), ease=ui::Ease::Out))
        }
      })
      f
      .width(view::Live::Is(Some(64.0)))
      .height(view::Live::Is(Some(64.0)))
      .radius(view::Live::Is(32.0))
      .ground(view::Live::Is(0x0000008CL))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .alpha(view::Live::By(fn() {
        let e = way.shown(f)
        if e >= 1.0 {
          0.0
        } else if motion_off() {
          0.95
        } else {
          0.95 * (1.0 - e)
        }
      }))
      .scale(view::Live::By(fn() { if motion_off() { 1.0 } else { 0.8 + 0.45 * way.shown(f) } }))
      |> ignore
      sf_icon_node(f, "", 28.0, view::Live::By(white), name_now=fn() { if told.get().1 { "play" } else { "pause" } })
      |> ignore
    })
    |> ignore
  })
  |> ignore
  let held_lately : signals::Signal[Bool] = signals::signal(false)
  pic.reacts(fn() { grabbed.get() != 0 }, fn(held) {
    if held {
      held_lately.set(true)
    } else {
      pic.at_moment(pic.cause_at() + 300.0, fn() { if grabbed.untracked() == 0 { held_lately.set(false) } }, later=true)
      |> ignore
    }
  })
  pic.box(fn(o) {
    o.over(view::Live::Is(true)).presses(view::Live::Is(false)).lines_up(view::Live::Is(Some(view::Along::Start))) |> ignore
    o.box(fn(b) {
      let shows = fn() { !playing() && !held_lately.get() && badge_may() }
      let way = motion::NodeWay::new(if signals::untracked(shows) { 1.0 } else { 0.0 })
      b.reacts(shows, fn(on) { way.go_ms(b, if on { 1.0 } else { 0.0 }, if motion_off() { 1.0 } else { 120.0 }) })
      b
      .row(view::Live::Is(true))
      .height(view::Live::Is(Some(22.0)))
      .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
      .gap(view::Live::Is(6.0))
      .radius(view::Live::Is(5.0))
      .ground(view::Live::Is(0x00000099L))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .offset(view::Live::By(fn() { (12.0, if dock_floats() { title_h() + 8.0 } else { 12.0 }) }))
      .alpha(view::Live::By(fn() { way.shown(b) }))
      .laid_nowhere(view::Live::By(fn() { way.shown(b) <= 0.0 }))
      |> ignore
      sf_icon_node(b, "pause", 10.0, view::Live::By(white)) |> ignore
      words(b, fn() { t("已暂停") }, 12.0, white) |> ignore
    })
    |> ignore
  })
  |> ignore}
