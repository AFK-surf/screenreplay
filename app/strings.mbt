// The window's words in two languages (letter 20: 简体中文 and English, following Windows by default: theme.mbt).
// Written where they are used in Chinese, the language they were written in, and looked up here: `t` for words,
// `tf` for a sentence with blanks ({0}, {1} … filled in order, never pieced together from bits). A word missing from
// the table shows in Chinese, so a new one is seen untranslated, never blank. English is what an English app says
// there, not word for word.

///|
fn t(zh : String) -> String {
  if !is_english() {
    return zh
  }
  match english.get(zh) {
    Some(en) => en
    None => zh
  }
}

///|
/// A sentence with blanks: {0}, {1} … filled with `args` in order (after its words are looked up).
fn tf(zh : String, args : Array[String]) -> String {
  let mut s = t(zh)
  for i, a in args {
    s = s.replace_all(old="{\{i}}", new=a)
  }
  s
}

